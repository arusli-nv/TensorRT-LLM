    (dist=$C/build-pr0-fc52f0adee/dist; export BENCH_CONFIG=dep32-b2-288.yaml; run_case noft288 noft "${prof[@]}")
    case_index=$((case_index + 1))
    if [[ ${DEPL_PROF_EMPTY:-0} == 1 ]]; then
        (export BENCH_CONFIG=dep32-b2-288.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
