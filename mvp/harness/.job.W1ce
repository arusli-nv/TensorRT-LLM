case $job in
MECH-PROF)
    # nsys attribution of FT's mechanism cost (B2X-MECH-1K-8032671 ran out of time before the FT profile): ranks 0
    # and 5, noft288 vs ft288 (standard deployment), one 50-step window at each of 8 and 256 per GPU (repeat:2),
    # same nodes, pinned tactics, alternating order twice.
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json TLLM_TEST_NSYS_RANKS=0+5 TLLM_TEST_NSYS_CAPTURE_END=repeat:2:async
    mkdir -p "$out/autotuner"
    prof=(--mode sweep --loads 8,256 --iterations 2 --warm-each-load --profile-after-s 20)
    for round in 1 2; do
        modes="noft288 ft288"; [[ $round == 2 ]] && modes="ft288 noft288"
        for m in $modes; do
            if [[ $m == noft288 ]]; then
                (dist=$C/build-pr0-fc52f0adee/dist; export BENCH_CONFIG=dep32-b2-288.yaml; run_case $m-$round noft "${prof[@]}")
            else
                (export BENCH_CONFIG=dep32-b2-288.yaml MVP_OVERLAY=${B2_OVERLAY:-} TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
                 run_case $m-$round ft "${prof[@]}")
            fi
            case_index=$((case_index + 1))
        done
    done
    echo STD_DONE
    ;;
esac
case $job in
EMPTY-AB)
    # Empty extra slots vs replicas (RESTORE DESIGN's shippable default; the 9-vs-8 active-experts check): FT on,
    # the restore wheel (MVP_BUILD), standard deployment dep32-b2-288.yaml; arm "replicas" routes 288 slots (9
    # per GPU), arm "empty" routes 256 (TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty). Same nodes, three rounds
    # alternating, pinned tactics, warmed loads, 2 waves, steady state. EMPTY_PROFILE_ARMS="replicas empty": then nsys on ranks 0 and 5 at 8 per GPU,
    # one case per arm, for the MoE GEMM time per step.
    export BENCH_CONFIG=dep32-b2-288.yaml TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    sweep=(--mode sweep --loads ${B2_LOADS:-8,16,32,64,128,256} --iterations ${B2_WAVES:-2} --warm-each-load)
    for round in 1 2 3; do
        arms="replicas empty"; [[ $round == 2 ]] && arms="empty replicas"
        for a in $arms; do
            (export TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=$a; run_case $a-$round ft "${sweep[@]}")
            case_index=$((case_index + 1))
        done
    done
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" replicas empty > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    for a in ${EMPTY_PROFILE_ARMS:-}; do
        (export TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=$a TLLM_TEST_NSYS_RANKS=0+5
         run_case profile-$a ft --mode sweep --loads 8 --iterations 2 --warm-each-load --profile-after-s 15)
        case_index=$((case_index + 1))
    done
    echo STD_DONE
    ;;
esac
case $job in
DEPL-PROF)
    # Where the 288-slot deployment tax comes from (B2-DEPL-1K-8031778: -2.4..-5.9% vs eplb0): nsys on ranks 0 and
