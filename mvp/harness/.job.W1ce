        (export TOKENS_CONFIG=../configs/lite4-mtp-$feature.yaml TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2
         export TLLM_TEST_KILL_IN_DECODE=$trigger TLLM_TEST_KILL_WHEN_BUSY=$busy
         export TOKENS_ARGS="--inflight-after 0.5 --max-tokens 400 --no-probe --trigger $trigger"
         run_case mtp-$feature-replay-$case_index ft)
