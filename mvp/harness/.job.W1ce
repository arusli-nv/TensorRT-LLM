case $job in
HANG-DEP32)
    # Item 3 at DEP32 (finish-line coverage): hangs under load at 8/GPU on the restore wheel (MVP_BUILD) with the
    # health branch overlaid (MVP_OVERLAY: hang detection, fencing, /fault_tolerance), dep32-b2-320.yaml with empty
    # extra slots. No --fence-command: rank 2 SIGSTOPped (a node-mate fences it), rank 5's serving loop stuck and
    # rank 5's GPU stalled in a decode step (its own evidence thread fences it). Each: confirmed, fenced, survivors
    # resume (31), the load finishes, /fault_tolerance reads degraded with the fenced rank failed.
    export BENCH_CONFIG=dep32-b2-320.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_FAULT_TOLERANCE_HANG_DETECTION=1 TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=10 WIDEEP_FENCE_COMMAND=
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    load=(--mode failover --load 8 --iterations 3 --kill-window-s 20,30)
    (export WIDEEP_VICTIM=2; run_case stop-rank2 ft "${load[@]}" --kill stop)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_STALL_S=60 TLLM_TEST_KILL_TRIGGER=$out/trigger-hoststall
     export TLLM_TEST_HOST_STALL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case hoststall-rank5 ft "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_STALL_S=60 TLLM_TEST_KILL_TRIGGER=$out/trigger-gpustall
     export TLLM_TEST_STALL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case gpustall-rank5 ft "${load[@]}" --kill decode)
    [[ $SLURM_NODEID == 0 ]] && grep -h "is hung\|fenc\|resumed serving without\|Restored .* expert slots" \
        "$out"/*/rank-0.log "$out"/*/authority*.log 2>/dev/null | cut -c1-260
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|fault_tolerance_status' "$out"/*/result.json | cut -c1-400
    echo STD_DONE
    ;;
esac
case $job in
MTP-ORACLE)
    # Finish line (MTP with FT): one-model MTP (max_draft_len 3) survives a decode-replay kill with exact tokens.
    # One node, DeepSeek-V3-Lite with its MTP layer, EP4; the restore wheel with the MTP branch overlaid. Routing
