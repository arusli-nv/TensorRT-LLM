        arms="noft ft"; [[ $round == 2 ]] && arms="ft noft"
        for a in $arms; do run_case $a-$round $a "${sweep[@]}"; done
    done
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" noft ft > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    echo STD_DONE
    ;;
esac
case $job in
MTP-ORACLE4)
    # MTP-ORACLE3 again with the departed-rank fix for the attention-DP + speculative count exchange (overlay
    # all-71ac3036a0 on the all2 wheel), then GSM8K with one-model MTP: FT off, and FT on after losing rank 2 idle.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only_mtp
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 MVP_OVERLAY=$C/overlays/all-71ac3036a0
    for feature in sync overlap overlap; do
        trigger=/tmp/wideep-kill-$SLURM_JOB_ID-$case_index
        busy=0; [[ $feature == overlap ]] && busy=1
        (export TOKENS_CONFIG=../configs/lite4-mtp-$feature.yaml TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2
         export TLLM_TEST_KILL_IN_DECODE=$trigger TLLM_TEST_KILL_WHEN_BUSY=$busy
         export TOKENS_ARGS="--inflight-after 0.5 --max-tokens 400 --no-probe --trigger $trigger"
         run_case mtp-$feature-replay-$case_index ft)
        case_index=$((case_index + 1))
    done
    export BENCH_CONFIG=lite4-mtp-overlap.yaml
    run_case acc-mtp-noft noft --mode accuracy
    run_case acc-mtp-ft-loss ft --mode accuracy --after-loss
    [[ $SLURM_NODEID == 0 ]] && grep -H "discarding\|WIDEEP_SELF_KILL\|RuntimeError" "$out"/*/rank-0.log | sed 's/^.*runs\///' | sort | uniq -c | cut -c1-240 | head -20
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|"accuracy"' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
BORROW-LITE)
    # KV-borrowed extra slots (TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost) on one node: DeepSeek-V3-Lite EP4, static
    # 144 slots (18 empty per rank). Exact tokens across a decode kill of rank 2 (the oracle restores rank 2's
    # experts into the borrowed slots at startup); GSM8K FT off vs after losing rank 2 idle with the memory taken
    # from the KV cache (TLLM_TEST_BORROW_FROM_KV=1); decode kills of rank 2 under load from free memory and from
    # the KV cache. MVP_BUILD = a wheel with the borrowed slots, no overlay.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    unset MVP_OVERLAY
    trigger=/tmp/wideep-kill-$SLURM_JOB_ID-$case_index
    (export TOKENS_CONFIG=../configs/lite4-sync.yaml TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2
     export TLLM_TEST_KILL_IN_DECODE=$trigger TOKENS_ARGS="--inflight-after 0.5 --max-tokens 400 --no-probe --trigger $trigger"
     run_case borrow-replay ft)
    export BENCH_CONFIG=lite4-sync.yaml
    run_case acc-borrow-noft noft --mode accuracy
    (export TLLM_TEST_BORROW_FROM_KV=1; run_case acc-borrow-ft-loss ft --mode accuracy --after-loss)
    kill_case borrow-decode8 decode 8
    (export TLLM_TEST_BORROW_FROM_KV=1; kill_case borrow-kv-decode8 decode 8)
    [[ $SLURM_NODEID == 0 ]] && grep -h "Gave .* KV cache\|Restored .* expert slots\|resumed serving without\|could not give up\|RuntimeError\|WIDEEP_MEM" \
        "$out"/*/rank-0.log 2>/dev/null | cut -c1-240 | sort | uniq -c | head -20
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|"accuracy"' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
GLM-MTP)
    # GLM port, MTP layer: GLM-5.2-NVFP4 at DEP32 with one-model MTP (glm52-dep32-mtp.yaml). GSM8K with FT off and
    # with FT after losing rank 2 idle, then a decode kill of rank 5 under load while it holds requests.
    # MVP_BUILD / MVP_OVERLAY = the wideep-ft-all tip.
    export WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/GLM-5.2-NVFP4
    export BENCH_CONFIG=glm52-dep32-mtp.yaml WIDEEP_TOKENIZER=$C/cache/glm52-tokenizer TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    run_case glm-mtp-acc-noft noft --mode accuracy
    run_case glm-mtp-acc-ft-loss ft --mode accuracy --after-loss
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-glm5 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case glm-mtp-decode-rank5 ft --mode failover --kill decode --load 8 --iterations 3 --kill-window-s 20,30)
    [[ $SLURM_NODEID == 0 ]] && grep -h "lacks\|Restored .* expert slots\|resumed serving without\|Error:" \
        "$out"/*/rank-0.log | cut -c1-260 | sort | uniq -c | head -20
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|"accuracy"\|fault_tolerance_status' "$out"/*/result.json | cut -c1-400
    echo STD_DONE
    ;;
esac
case $job in
FINAL-HEALTHY)
    # FINAL COMPARISON 1 (BENCHMARK_STANDARD curves): main FT off vs FT on (MVP_BUILD + MVP_OVERLAY), the standard
    # deployment (dep32-final*.yaml: online EPLB 288, MTP with forced acceptance, overlap, attention-DP balancing),
    # same nodes, three alternating rounds. FINAL_SHAPE 1K or 8K, FINAL_LOADS splits a shape across jobs. Each arm
    # pins its own autotuner tactics.
    isl=1024 config=dep32-final.yaml
    [[ ${FINAL_SHAPE:-1K} == 8K ]] && isl=8192 config=dep32-final-8k.yaml
    export BENCH_CONFIG=$config TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1
    mkdir -p "$out/autotuner"
    final_arm() {  # ARM CASE_NAME [bench args]
        local arm=$1 name=$2; shift 2
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$arm.json
         if [[ $arm == noft ]]; then dist=$C/build-pr0-fc52f0adee/dist; export MVP_OVERLAY=; run_case $name noft "$@"
         else export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0; run_case $name ft "$@"; fi)
        case_index=$((case_index + 1))
    }
    for round in 1 2 3; do
        arms="noft ft"; [[ $round == 2 ]] && arms="ft noft"
        for a in $arms; do
            final_arm $a $a-$round --mode sweep --loads ${FINAL_LOADS:-8,16,32,64,128,256} --iterations ${FINAL_WAVES:-2} \
                --isl $isl --osl 1024 --warm-each-load
        done
    done
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" noft ft > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    echo STD_DONE
    ;;
FINAL-FAIL)
    # FINAL COMPARISON 2 and 3: failure timelines (per-second series in each case's timeline) in the standard
    # deployment at 128 per GPU. FT on: a GPU lost idle (rank 2), a GPU lost in a decode step under load (rank 5,
    # holding requests), a hang under load (rank 2 SIGSTOPped, fenced by a node-mate), and a whole node under load
    # (ranks 4-7; dep32-final-320.yaml, as at 288 FT admits single ranks only). FT off (main): the same GPU loss
    # under load aborts the job; then a cold restart (weights dropped from the page cache) and, after a second
    # abort that keeps the page cache, a warm restart.
    export BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    mkdir -p "$out/autotuner"
    load=(--mode failover --load ${FINAL_FAIL_LOAD:-128} --iterations 3 --kill-window-s 30,45)
    run_case gpu-idle ft "${load[@]}" --kill idle
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-gpu5
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case gpu-decode-rank5 ft "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=2 TLLM_FAULT_TOLERANCE_HANG_DETECTION=1 TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=10 WIDEEP_FENCE_COMMAND=
     run_case hang-stop-rank2 ft "${load[@]}" --kill stop)
    case_index=$((case_index + 1))
    (export BENCH_CONFIG=dep32-final-320.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft320.json
     export WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7 TLLM_TEST_KILL_TRIGGER=$out/trigger-node1
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case node1-decode ft "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    (dist=$C/build-pr0-fc52f0adee/dist; export MVP_OVERLAY= TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/noft.json
     run_case noft-abort-cold noft "${load[@]}" --kill random
     run_case noft-restart-cold noft --mode restart
     export WIDEEP_KEEP_PAGE_CACHE=1
     run_case noft-abort-warm noft "${load[@]}" --kill random
     run_case noft-restart-warm noft --mode restart)
    [[ $SLURM_NODEID == 0 ]] && grep -h "Restored .* expert slots\|resumed serving without\|is hung\|fenc\|not recoverable\|RuntimeError" \
        "$out"/*/rank-0.log "$out"/*/authority*.log 2>/dev/null | cut -c1-240 | sort | uniq -c | head -20
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|fault_tolerance_status\|startup_s\|first_token' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
BORROW-AB)
    # Healthy cost of KV-borrowed extra slots: FT on, static 288 (dep32-b2-288.yaml), extra slots empty vs borrowed
    # (weights in VMM device memory instead of host-registered NUMA memory; the KV cache sizes over the borrowed
    # slots). Same nodes, three alternating rounds, MVP_BUILD = a wheel with borrowed slots. Each arm pins its own
    # tactics; the KV cache size of each arm is in its WIDEEP_MEM lines.
    export BENCH_CONFIG=dep32-b2-288.yaml TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    mkdir -p "$out/autotuner"
    for round in 1 2 3; do
        arms="empty ghost"; [[ $round == 2 ]] && arms="ghost empty"
        for a in $arms; do
            (export TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=$a TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json
             run_case $a-$round ft --mode sweep --loads ${BORROW_LOADS:-8,32,128,256} --iterations 2 --isl 1024 --osl 1024 \
                 --warm-each-load)
            case_index=$((case_index + 1))
        done
    done
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" empty ghost > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    [[ $SLURM_NODEID == 0 ]] && grep -h "WIDEEP_MEM" "$out"/*-1/rank-0.log | cut -c1-200 | head -4
    echo STD_DONE
    ;;
esac
case $job in
GLM-MTP-ACC)
    # GLM-MTP's accuracy after a loss again (its first try lost rank 12 at startup to a Triton cache race on the
    # shared home; serve.sh now uses a node-local cache), with FT off once more as the same-nodes reference.
    export WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/GLM-5.2-NVFP4
    export BENCH_CONFIG=glm52-dep32-mtp.yaml WIDEEP_TOKENIZER=$C/cache/glm52-tokenizer TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    run_case glm-mtp-acc-ft-loss ft --mode accuracy --after-loss
    run_case glm-mtp-acc-noft noft --mode accuracy
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|"accuracy"' "$out"/*/result.json | cut -c1-400
    echo STD_DONE
    ;;
esac
case $job in
BORROW-KILL|BORROW-KILL-EMPTY)
    # Decode kills of rank 2 under load on V3-Lite EP4 static 144, extra slots borrowed (memory from free memory,
    # GPU copies) or, for BORROW-KILL-EMPTY, empty (the CPU-copy baseline); twice each, with a kill window the Lite
    # load outlasts. Compare the "Restored ... in" times of the two modes. MVP_BUILD = a borrowed-slot wheel.
    mode=ghost; [[ $job == *-EMPTY ]] && mode=empty
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=$mode
    export TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1 BENCH_CONFIG=lite4-sync.yaml WIDEEP_KILL_WINDOW=10,20
    unset MVP_OVERLAY
    kill_case $TLLM_FAULT_TOLERANCE_EXTRA_SLOTS-decode8-1 decode 8
    kill_case $TLLM_FAULT_TOLERANCE_EXTRA_SLOTS-decode8-2 decode 8
    [[ $SLURM_NODEID == 0 ]] && grep -h "Gave .* KV\|Restored .* expert slots\|resumed serving without\|RuntimeError" \
        "$out"/*/rank-0.log 2>/dev/null | cut -c1-200
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"' "$out"/*/result.json
    echo STD_DONE
    ;;
esac
case $job in
GLM53-SCOUT)
    # GLM-5.3, official FP8 checkpoint (128x128 block scales), DEP32 on DEEPGEMM (glm53-dep32-ft.yaml, static 288 with
    # host copies). FT off serves; FT on serves, then an idle kill of rank 2 and a decode kill of rank 5 under load
    # while it holds requests: restore of FP8 block-scale weights from EPLB's host copies, and the compact copy that
    # DEEPGEMM (no receive-slot reads) needs. Each case logs per-node GPU memory every 5 s (gpumem-*.csv).
    export WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/GLM-5.3
    export BENCH_CONFIG=glm53-dep32-ft.yaml WIDEEP_TOKENIZER=$C/cache/glm53-tokenizer TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    quick=(--mode sweep --loads 8,64 --iterations 1 --warm-each-load)
    run_case glm53-noft noft "${quick[@]}"
    run_case glm53-ft ft "${quick[@]}"
    kill_case glm53-idle idle 8
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-glm53 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case glm53-decode-rank5 ft --mode failover --kill decode --load 8 --iterations 3 --kill-window-s 20,30)
    [[ $SLURM_NODEID == 0 ]] && grep -h "Selected communication strategy\|Restored .* expert slots\|resumed serving without\|Error:\|lacks" \
        "$out"/*/rank-0.log | cut -c1-240 | sort | uniq -c | head -20
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|fault_tolerance_status' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
REUSE-LITE)
    # FT with KV block reuse (prefix caching) on one node: V3-Lite EP4 static 144, lite4-reuse.yaml (block reuse,
    # chunked prefill of 128 tokens). Twice, a SIGKILL of rank 2 a few seconds into a full load of ~400-token
    # prompts sharing their long prefix (blocks reused across requests; kills land in later chunks after earlier
    # chunks committed): every survivor request must complete, rank 2's must fail. Then GSM8K (8-shot prompts
    # share their prefix) FT off vs after losing rank 2. MVP_BUILD / MVP_OVERLAY = a wheel allowing block reuse.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    for i in 1 2; do
        (export TOKENS_CONFIG=../configs/lite4-reuse.yaml TOKENS_ARGS="--load-kill 4 --shared-prefix --load-per-rank 8"
         run_case reuse-load-kill-$i ft)
        case_index=$((case_index + 1))
    done
    export BENCH_CONFIG=lite4-reuse.yaml
    run_case acc-reuse-noft noft --mode accuracy
    run_case acc-reuse-ft-loss ft --mode accuracy --after-loss
    [[ $SLURM_NODEID == 0 ]] && grep -h "Restored .* expert slots\|resumed serving without\|RuntimeError\|lacks" \
        "$out"/*/rank-0.log 2>/dev/null | cut -c1-200 | sort | uniq -c | head
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|"accuracy"\|survivor_failures\|victim_requests_failed' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
BORROW-PREFAULT)
    # BORROW-KILL with the host copies prefaulted in the background at startup (MVP_OVERLAY with
    # _populate_in_background): borrowed-slot decode kills twice; compare "Restored ... in" with BORROW-KILL's
    # 156-219 ms (cold host pages) and BORROW-KILL-EMPTY's 27 ms (CPU copies).
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
    export TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1 BENCH_CONFIG=lite4-sync.yaml WIDEEP_KILL_WINDOW=10,20
    kill_case prefault-decode8-1 decode 8
    kill_case prefault-decode8-2 decode 8
    [[ $SLURM_NODEID == 0 ]] && grep -h "Restored .* expert slots\|resumed serving without\|RuntimeError" \
        "$out"/*/rank-0.log 2>/dev/null | cut -c1-200
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"' "$out"/*/result.json
    echo STD_DONE
    ;;
esac
case $job in
REPLAN-LITE)
    # A second failure during a recovery (UPDATES 2026-10-18 item 2): V3-Lite EP4 static 144 (lite4-sync.yaml). Rank 2
    # is lost; rank 3 SIGKILLs itself right after sending its Stopped (TLLM_TEST_KILL_AFTER_STOPPED), so the
    # survivors shrink again and plan without both (2 x 36 slots = the 72 experts, restored from host copies).
    # A decode kill under load, then GSM8K FT off vs after the double loss. MVP_BUILD / MVP_OVERLAY = a wheel with
    # the re-plan.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 BENCH_CONFIG=lite4-sync.yaml WIDEEP_KILL_WINDOW=10,20
    run_case acc-replan-noft noft --mode accuracy
    (export TLLM_TEST_KILL_AFTER_STOPPED=3 WIDEEP_LOST=2
     run_case acc-replan-ft-loss ft --mode accuracy --after-loss)
    case_index=$((case_index + 1))
    (export TLLM_TEST_KILL_AFTER_STOPPED=3 WIDEEP_LOST=2 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
     kill_case replan-decode8 decode 8)
    [[ $SLURM_NODEID == 0 ]] && grep -h "failed during the recovery\|planning again\|Restored .* expert slots\|resumed serving without\|not recoverable\|RuntimeError" \
        "$out"/*/rank-0.log "$out"/*/authority.log 2>/dev/null | cut -c1-220 | sort | uniq -c | head
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|"accuracy"' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
HANG-TUNE)
    # Hang-confirm tuning (UPDATES 2026-10-18 item 2) on the standard deployment (dep32-final.yaml): rank 2 SIGSTOPped
    # under load at 64/GPU (fenced by a node-mate) with TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S = 3, 10, 30: time from
    # the stop to "is hung", to the fence, to resumed. Then the false-positive control at 3 s: an 8k/1k sweep at 64
    # and 128 per GPU with hang detection on must fence nothing (its slowest step is the margin).
    export BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_FAULT_TOLERANCE_HANG_DETECTION=1 WIDEEP_FENCE_COMMAND= WIDEEP_VICTIM=2
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json
    mkdir -p "$out/autotuner"
    for confirm in 3 10 30; do
        (export TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=$confirm
         run_case stop-confirm$confirm ft --mode failover --load 64 --iterations 3 --kill-window-s 30,45 --kill stop)
        case_index=$((case_index + 1))
    done
    (export TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=3 BENCH_CONFIG=dep32-final-8k.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft8k.json
     run_case control-confirm3-8k ft --mode sweep --loads 64,128 --iterations 2 --isl 8192 --osl 1024 --warm-each-load)
    [[ $SLURM_NODEID == 0 ]] && grep -H "is hung\|fenc\|resumed serving without\|Restored .* expert slots" \
        "$out"/*/rank-0.log "$out"/*/authority.log 2>/dev/null | sed 's/^.*runs\///' | cut -c1-240 | head -30
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|fault_tolerance_status' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
REUSE-KILL)
    # REUSE-LITE's load kills again with a load that outlasts the kill (its 8 requests per rank finished within 4 s,
    # before the kill): 48 shared-prefix requests per rank, killed 1.5 s in, three times.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    for i in 1 2 3; do
        (export TOKENS_CONFIG=../configs/lite4-reuse.yaml TOKENS_ARGS="--load-kill 1.5 --shared-prefix --load-per-rank 48"
         run_case reuse-load-kill-$i ft)
        case_index=$((case_index + 1))
    done
    [[ $SLURM_NODEID == 0 ]] && grep -h "resumed serving without\|RuntimeError" "$out"/*/rank-0.log 2>/dev/null | cut -c1-200
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|survivor_failures\|victim_requests_failed\|recovered_requests_done_s' "$out"/*/result.json | cut -c1-200
    echo STD_DONE
    ;;
esac
case $job in
GLM53-SCOUT2)
    # GLM53-SCOUT's FT cases again with EPLB slots of DEEPGEMM's repacked FP8 block scales loadable (800347c9f4):
    # FT on serves, an idle kill of rank 2, a decode kill of rank 5 under load while it holds requests.
    export WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/GLM-5.3
    export BENCH_CONFIG=glm53-dep32-ft.yaml WIDEEP_TOKENIZER=$C/cache/glm53-tokenizer TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    run_case glm53-ft ft --mode sweep --loads 8,64 --iterations 1 --warm-each-load
    kill_case glm53-idle idle 8
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-glm53 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case glm53-decode-rank5 ft --mode failover --kill decode --load 8 --iterations 3 --kill-window-s 20,30)
    [[ $SLURM_NODEID == 0 ]] && grep -h "Restored .* expert slots\|resumed serving without\|Error:\|lacks" \
        "$out"/*/rank-0.log | grep -v Priming | cut -c1-240 | sort | uniq -c | head -20
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|fault_tolerance_status' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
DETECTOR-AB)
    # CONSOLIDATION decision 5: healthy cost of Open MPI's threaded in-band failure detector (detects dead/frozen
    # processes without a socket close; needs MPI_THREAD_MULTIPLE). FT on vs FT on + detector, same wheel, the
    # standard deployment (dep32-final.yaml), same nodes, three alternating rounds; mean, median and p99 per load.
    export BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    base="--mca pml ob1 --mca btl self,tcp --mca btl_tcp_if_include eth0 --mca coll ^hcoll,ucc"
    det="$base --mca mpi_ft_detector true --mca mpi_ft_detector_thread true --mca mpi_ft_detector_period 1"
    det="$det --mca mpi_ft_detector_timeout 5"
    mkdir -p "$out/autotuner"
    for round in 1 2 3; do
        arms="ft ftdet"; [[ $round == 2 ]] && arms="ftdet ft"
        for a in $arms; do
            mca=$base; [[ $a == ftdet ]] && mca=$det
            (export WIDEEP_MPI_MCA="$mca" TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a-$round.json
             run_case $a-$round ft --mode sweep --loads ${DET_LOADS:-8,32,128} --iterations 2 --isl 1024 --osl 1024 \
                 --warm-each-load)
            case_index=$((case_index + 1))
        done
    done
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" ft ftdet > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    [[ $SLURM_NODEID == 0 ]] && grep -H "mpi_ft_detector\|PROC_FAILED\|process failure" "$out"/*/rank-0.log | head -5
    echo STD_DONE
    ;;
esac
case $job in
C-LAYOUT|C-LAYOUT320)
    slots=288; [[ $job == C-LAYOUT320 ]] && slots=320  # 320: the node failure domain (THREE DEFAULTS 1)
    # Item C / EV5 (user priority): the 288-slot layout's cost with FT off, same wheel and nodes. eplb0
    # (dep32-eplb0.yaml) vs 288 slots with the extra slots emptied (dep32-b2-288.yaml + TLLM_TEST_EMPTY_EXTRA_SLOTS:
    # one slot per expert, so the one-slot routing kernel), three alternating rounds at 64/128/256, 3 waves each;
    # ab_stats gives mean, median and p99 step and client throughput. nsys at 128: C-PROF.
    mkdir -p "$out/autotuner"
    for round in 1 2 3; do
        arms="eplb0 empty$slots"; [[ $round == 2 ]] && arms="empty$slots eplb0"
        for a in $arms; do
            (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a-$round.json BENCH_CONFIG=dep32-eplb0.yaml
             [[ $a == empty$slots ]] && export BENCH_CONFIG=dep32-b2-$slots.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1
             run_case $a-$round noft --mode sweep --loads ${C_LOADS:-64,128,256} --iterations 3 --isl 1024 --osl 1024 \
                 --warm-each-load)
            case_index=$((case_index + 1))
        done
    done
    [[ $SLURM_NODEID == 0 ]] && grep -h "WIDEEP_EMPTY_EXTRA_SLOTS" "$out"/empty$slots-*/rank-0.log | head -3
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" eplb0 empty$slots > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    echo STD_DONE
    ;;
esac
case $job in
C-PROF)
    # Item C (user priority), profiles under full load on ranks 0 and 5 (windows open only at full decode load):
    # 1. EV5: nsys at 128/GPU, FT off, eplb0 vs 288 with the extra slots emptied (as C-LAYOUT).
    # 2. EV6: the FT-only slow-step tail. FT on, 288 empty extra slots, 8/GPU for 6 waves, where B2Y saw p99 54 ms
    #    vs ~19. A 600-step nsys window opens at the first decode step 2x the load's median (bench.py
    #    --profile-on-slow-step), and allocator / page-fault stats are logged every second (TLLM_TEST_ALLOC_STATS_S).
    export TLLM_TEST_NSYS_RANKS=0+5 TLLM_TEST_NSYS_CAPTURE_END=repeat:2:async
    mkdir -p "$out/autotuner"
    for a in eplb0 empty288; do
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json BENCH_CONFIG=dep32-eplb0.yaml
         [[ $a == empty288 ]] && export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1
         run_case prof-$a-128 noft --mode sweep --loads 128 --iterations 2 --warm-each-load --profile-after-s 20)
        case_index=$((case_index + 1))
    done
    (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json BENCH_CONFIG=dep32-b2-288.yaml
     export TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_TEST_ALLOC_STATS_S=1
     export TLLM_TEST_NSYS_CAPTURE_END=stop
     run_case tail-ft-8 ft --mode sweep --loads 8 --iterations 6 --warm-each-load --profile-on-slow-step 2.0)
    [[ $SLURM_NODEID == 0 ]] && grep -H '"profile_windows"' "$out"/*/result.json | cut -c1-400
    echo STD_DONE
    ;;
esac
case $job in
C-EPISODE)
    # Item C (EV5/EV6): the slow steps (100-900 ms) in the first seconds of the first load appear with the
    # 288-slot layout with emptied extra slots (FT off and FT on), not with eplb0 (C-LAYOUT-8048848,
    # C-PROF-8048853). An 1800-step nsys window opens at the first full-load decode step of the first load
    # (warm row) on ranks 5 and 13 (not rank 0, which also serves HTTP). Allocator / page-fault stats every second.
    export TLLM_TEST_NSYS_RANKS=5+13 TLLM_TEST_NSYS_CAPTURE_END=stop TLLM_TEST_ALLOC_STATS_S=1
    mkdir -p "$out/autotuner"
    for a in empty288 eplb0; do
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json BENCH_CONFIG=dep32-eplb0.yaml
         [[ $a == empty288 ]] && export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1
         run_case ep-$a-64 noft --mode sweep --loads 64 --iterations 2 --isl 1024 --osl 1024 --warm-each-load \
             --profile-first-load-steps 1800)
        case_index=$((case_index + 1))
    done
    (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json BENCH_CONFIG=dep32-b2-288.yaml
     export TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
     run_case ep-ft-8 ft --mode sweep --loads 8 --iterations 3 --warm-each-load --profile-first-load-steps 1800)
    [[ $SLURM_NODEID == 0 ]] && grep -H '"profile_windows"' "$out"/*/result.json | cut -c1-400
    echo STD_DONE
    ;;
esac
case $job in
C-COMBINE)
    # Item C (EV5): with the 288-empty layout the combine takes +12.5-13 us/layer at 128/GPU while the local
    # dispatch-end -> combine-start work on ranks 0 and 5 does not grow (CLAIMS #66), so another rank arrives
    # later. nsys on 8 ranks (one per node) at 128/GPU, eplb0 vs empty288, one 50-step window each at full load;
    # per-rank local MoE work shows which ranks the combine waits for.
    export TLLM_TEST_NSYS_RANKS=1+5+9+13+17+21+25+30 TLLM_TEST_NSYS_CAPTURE_END=repeat:2:async
    mkdir -p "$out/autotuner"
    for a in eplb0 empty288; do
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json BENCH_CONFIG=dep32-eplb0.yaml
         [[ $a == empty288 ]] && export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1
         run_case comb-$a-128 noft --mode sweep --loads 128 --iterations 2 --warm-each-load --profile-after-s 20)
        case_index=$((case_index + 1))
    done
    [[ $SLURM_NODEID == 0 ]] && grep -H '"profile_windows"' "$out"/*/result.json | cut -c1-400
    echo STD_DONE
    ;;
esac
case $job in
C-ARRIVAL)
    # Item C (EV6): in the first-load slow steps, ranks 5 and 13 both wait ~100-240 ms in _prepare_inputs with
    # the host idle (C-EPISODE-8050513), so another rank arrives late at the attention-DP host collective. nsys
    # on every rank (CUDA + NVTX; with CPU sampling all ranks froze at the window end, RETRO) over the first 300 steps of the first load (288-empty, FT off,
    # 64/GPU) shows which rank arrives last and what its host is doing.
    export TLLM_TEST_NSYS_RANKS=all TLLM_TEST_NSYS_CAPTURE_END=stop
    mkdir -p "$out/autotuner"
    (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/empty288.json BENCH_CONFIG=dep32-b2-288.yaml
     export TLLM_TEST_EMPTY_EXTRA_SLOTS=1
     run_case arr-empty288-64 noft --mode sweep --loads 64 --iterations 1 --warm-each-load \
         --profile-first-load-steps 300)
    [[ $SLURM_NODEID == 0 ]] && grep -H '"profile_windows"' "$out"/*/result.json | cut -c1-400
    echo STD_DONE
    ;;
esac
case $job in
REPLAN-R1)
    # A second failure during a recovery at R1 DEP32 (decision 6 scale) with the launcher fix (3bc9ce26b3):
    # rank 2 is lost in a decode step under load; rank 3 SIGKILLs itself right after sending its Stopped, so the
    # survivors shrink again and plan without both (16 experts restored into the 288 layout's empty slots). Pass:
    # the job keeps serving after both exits (PRRTE sees two signal deaths), requests on survivors finish.
    export BENCH_CONFIG=dep32-b2-288.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    export TLLM_TEST_KILL_AFTER_STOPPED=3 WIDEEP_LOST=2
    mkdir -p "$out/autotuner"
    kill_case replan-decode8 decode 8
    kill_case replan-decode128 decode 128
    [[ $SLURM_NODEID == 0 ]] && grep -h "failed during the recovery\|planning again\|Restored .* expert slots\|resumed serving without\|not recoverable\|RuntimeError" \
        "$out"/*/rank-0.log "$out"/*/authority.log 2>/dev/null | cut -c1-220 | sort | uniq -c | head
    [[ $SLURM_NODEID == 0 ]] && grep -h "RANK_EXIT\|MPIRUN_EXIT" "$out"/*/timeline | head
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
HANG-NEG)
    # hang_confirm_s default from data (THREE DEFAULTS 3): negative controls at the shortest candidate (confirm 5 s,
    # hang detection on, standard deployment, 64/GPU) must fence nothing. Each is a legitimate slowdown, started
    # by the trigger under load:
    # - host45-all: every rank's serving loop sleeps 45 s at the same step (a cluster-wide pause, no culprit);
    # - gil45-rank2: rank 2 runs a GIL hog for 45 s (heartbeats and the serving loop run in 0.5 s slices);
    # - prefill-8k: an 8k/1k sweep at 64 and 128/GPU (the longest legitimate steps).
    # A fence or recovery in any of them fails the case (bench --kill control).
    export BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_FAULT_TOLERANCE_HANG_DETECTION=1 TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=${HANG_CONFIRM:-5} WIDEEP_FENCE_COMMAND=
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1 TLLM_TEST_STALL_S=45
    mkdir -p "$out/autotuner"
    control=(--mode failover --kill control --load 64 --iterations 3 --kill-window-s 30,45)
    (export TLLM_TEST_KILL_TRIGGER=$out/trigger-host TLLM_TEST_KILL_RANK=$(seq -s, 0 31)  # on Lustre: every node sees it
     export TLLM_TEST_HOST_STALL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER TLLM_TEST_TRIGGER_NEEDS_REQUESTS=0
     run_case host45-all ft "${control[@]}")
    case_index=$((case_index + 1))
    (export TLLM_TEST_KILL_TRIGGER=/tmp/wideep-trigger-$SLURM_JOB_ID-gil TLLM_TEST_KILL_RANK=2
     export TLLM_TEST_GIL_HOG_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case gil45-rank2 ft "${control[@]}")
    case_index=$((case_index + 1))
    (export BENCH_CONFIG=dep32-final-8k.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft8k.json
     run_case prefill-8k ft --mode sweep --loads 64,128 --iterations 2 --isl 8192 --osl 1024 --warm-each-load)
    [[ $SLURM_NODEID == 0 ]] && grep -H "is hung\|fenc\|suspect\|resumed serving without\|WIDEEP_SELF_STALL\|WIDEEP_GIL" \
        "$out"/*/rank-0.log "$out"/*/rank-2.log "$out"/*/authority.log 2>/dev/null | sed 's/^.*runs\///' | cut -c1-240 | head -30
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|fault_tolerance_status' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
HANG-POS)
    # hang_confirm_s candidates (THREE DEFAULTS 3): rank 2 SIGSTOPped under load at 64/GPU on the standard
    # deployment, confirm 5, 10 and 15 s: time from the stop to "is hung", the fence and resumed serving.
    export BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_FAULT_TOLERANCE_HANG_DETECTION=1 WIDEEP_FENCE_COMMAND= WIDEEP_VICTIM=2
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json
    mkdir -p "$out/autotuner"
    for confirm in ${HANG_CONFIRMS:-5 10 15}; do
        (export TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=$confirm
         run_case stop-confirm$confirm ft --mode failover --load 64 --iterations 3 --kill-window-s 30,45 --kill stop)
        case_index=$((case_index + 1))
    done
    [[ $SLURM_NODEID == 0 ]] && grep -H "is hung\|fenc\|resumed serving without\|Restored .* expert slots" \
        "$out"/*/rank-0.log "$out"/*/authority.log 2>/dev/null | sed 's/^.*runs\///' | cut -c1-240 | head -30
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|fault_tolerance_status' "$out"/*/result.json | cut -c1-300
    echo STD_DONE
    ;;
esac
case $job in
C-HOSTPRESS)
    # Item C (EV6): the first-load slow steps come with EPLB host copies (288-empty FT off/on, online EPLB FT off)
    # and not without them (eplb0, static 288 replicas); in them every host-side range (_enqueue_responses,
    # _handle_responses, _prepare_inputs, _schedule) runs 2-4x slower on every rank (C-ARRIVAL-8052256,
    # C-EPISODE-8050513). eplb0 vs 288-empty at 64/GPU, FT off, with per-second vmstat and PSI per node
    # (hostpressure-*.log) and allocator / page-fault stats per rank: CPU, memory or IO pressure during the episode?
    export TLLM_TEST_ALLOC_STATS_S=1
    mkdir -p "$out/autotuner"
    for a in empty288 eplb0; do
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json BENCH_CONFIG=dep32-eplb0.yaml
         [[ $a == empty288 ]] && export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1
         run_case hp-$a-64 noft --mode sweep --loads 64 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
        case_index=$((case_index + 1))
    done
    [[ $SLURM_NODEID == 0 ]] && head -3 "$out"/*/hostpressure-0.log
    echo STD_DONE
    ;;
esac
case $job in
C-POPULATE)
    # Item C (EV6) suspect: after startup each rank builds page tables for the node's other EPLB host copies in a
    # background thread (_populate_in_background: madvise(MADV_POPULATE_READ) over each /dev/shm segment, hundreds
    # of GiB); while it runs every host range is 2-4x slower with the host otherwise idle (C-HOSTPRESS-8052569).
    # 288-empty FT off at 64/GPU, the populate timed vs skipped (TLLM_TEST_POPULATE), alternating, two rounds.
    mkdir -p "$out/autotuner"
    export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1 TLLM_TEST_ALLOC_STATS_S=1
    for a in timed off off timed; do
        i=$((${i:-0} + 1))
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/empty288.json TLLM_TEST_POPULATE=$a
         run_case pop-$a-$i noft --mode sweep --loads 64 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
        case_index=$((case_index + 1))
    done
    [[ $SLURM_NODEID == 0 ]] && grep -h "WIDEEP_POPULATE" "$out"/*/rank-0.log "$out"/*/rank-1.log | cut -c1-200 | head
    echo STD_DONE
    ;;
esac
case $job in
C-PAGECACHE)
    # Red-team control for EV6 (CLAIMS #68/#73 QUESTIONED): the model's page cache is kept (WIDEEP_KEEP_PAGE_CACHE=1:
    # no drop during the first load), 288-empty vs eplb0, FT off, 64 and 128/GPU, 3 per arm in a random order
    # (logged), slow first-load steps counted in every run afterwards.
    export WIDEEP_KEEP_PAGE_CACHE=1
    mkdir -p "$out/autotuner"
    order=$(printf '%s\n' eplb0 eplb0 eplb0 empty288 empty288 empty288 | shuf --random-source=<(yes "$SLURM_JOB_ID$job") | tr '\n' ' ')
    echo "C_PAGECACHE_ORDER $order"
    for a in $order; do
        n=$((${n:-0} + 1))
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json BENCH_CONFIG=dep32-eplb0.yaml
         [[ $a == empty288 ]] && export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1
         run_case pc-$a-$n noft --mode sweep --loads 64,128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
        case_index=$((case_index + 1))
    done
    echo STD_DONE
    ;;
esac
case $job in
FT-COST-A|FT-COST-B|FT-COST-LOW)
    # The FT healthy-cost number with its confounds isolated (user, 2026-10-18 evening), split in two jobs to fit
    # the 2 h limit with n=3; noft-ulfm runs in both as the bridge. Standard deployment (dep32-final.yaml: online
    # EPLB 288, MTP forced acceptance, overlap, attention-DP balancing), 1k/1k at 32 and 128/GPU, 2 waves.
    #   A: noft-ulfm vs ft (stack wheel, ULFM/TCP both): the FT delta.
    #   B: noft-main (main wheel) vs noft-stack (stack wheel) vs noft-ulfm: the wheel and transport deltas.
    #   LOW: A at 8 and 32/GPU (user, 2026-10-18 night: a fixed per-step FT cost shows most at low load); slow-step
    #   bursts counted per row (burst_counts.py) next to ab_stats.
    # Arm order shuffled per job (logged); the first case is the smoke stage (require_done). Every arm runs the
    # identical layout (288 slots, online EPLB); ft uses failure_domain rank (serve.sh's explicit default), since the
    # node domain needs 320. The 320-vs-288 layout delta is a separate line (CLAIMS #75).
    export BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    mkdir -p "$out/autotuner"
    arms="noft-ulfm ft"; [[ $job == FT-COST-B ]] && arms="noft-main noft-stack noft-ulfm"
    loads=32,128; [[ $job == FT-COST-LOW ]] && loads=8,32
    order=$(for r in 1 2 3; do printf '%s\n' $arms; done | shuf --random-source=<(yes "$SLURM_JOB_ID$job") | tr '\n' ' ')
    echo "FT_COST_ORDER $order"
    declare -A round
    for a in $order; do
        n=$((${n:-0} + 1)); round[$a]=$((${round[$a]:-0} + 1)); k=${round[$a]}
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json
         case $a in
         noft-main) dist=$C/build-pr0-fc52f0adee/dist; export MVP_OVERLAY=; run_case $a-$k noft --mode sweep --loads $loads --iterations 2 --warm-each-load ;;
         noft-stack) run_case $a-$k noft --mode sweep --loads $loads --iterations 2 --warm-each-load ;;
         noft-ulfm) run_case $a-$k noft-ulfm --mode sweep --loads $loads --iterations 2 --warm-each-load ;;
         ft) run_case $a-$k ft --mode sweep --loads $loads --iterations 2 --warm-each-load ;;
         esac)
        case_index=$((case_index + 1))
        [[ $n == 1 ]] && require_done $a-$k
    done
    # 8k startup control (FT on runs out of memory at startup with dep32-final-8k, CLAIMS #77): does FT off start?
    [[ $job == FT-COST-A && -n "${FT_COST_8K:-}" ]] && (export BENCH_CONFIG=dep32-final-8k.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/noft8k.json
        run_case start8k-noft noft --mode sweep --loads 8 --iterations 1 --isl 8192 --osl 64)
    [[ $SLURM_NODEID == 0 ]] && for pair in "noft-ulfm ft" "noft-main noft-stack" "noft-stack noft-ulfm"; do
        python3 $H/ab_stats.py "$out" $pair > "$out/ab_stats-${pair// /-vs-}.txt" 2>&1 || true; done
    [[ $SLURM_NODEID == 0 ]] && python3 $H/burst_counts.py "$out" > "$out/burst_counts.txt" 2>&1 || true
    echo STD_DONE
    ;;
esac
case $job in
C-HOSTACC)
    # EV6 (tail job 1 of 2 after C-PAGECACHE-8053332): with the page cache kept, 2 of 3 288-empty runs had
    # 58-343 GPU-side slow steps (100-600 ms) at 128/GPU and no eplb0 run did. Suspect: expert weights in
    # host-accessible memory (make_tensor_host_accessible: mmap'd huge pages bound to the GPU's NUMA node on GB200)
    # whenever the load balancer keeps host copies and the slots are not borrowed; borrowed slots map VMM device
    # memory instead. eplb0 vs 288-empty vs 288-borrowed, FT off, 128/GPU, 3 each, shuffled; first case = smoke.
    mkdir -p "$out/autotuner"
    # online288 (main's standard online EPLB 288, FT off): online EPLB also uses host-accessible weights; if it
    # bursts too, the tail is main's standard-recipe behaviour. n=2 for eplb0 and online288 to fit 2 h.
    order=$(printf '%s\n' eplb0 eplb0 online288 online288 empty288 empty288 empty288 borrow288 borrow288 borrow288 \
        | shuf --random-source=<(yes "$SLURM_JOB_ID$job") | tr '\n' ' ')
    echo "C_HOSTACC_ORDER $order"
    declare -A round
    for a in $order; do
        n=$((${n:-0} + 1)); round[$a]=$((${round[$a]:-0} + 1)); k=${round[$a]}
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json BENCH_CONFIG=dep32-eplb0.yaml
         [[ $a == empty288 || $a == borrow288 ]] && export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1
         [[ $a == online288 ]] && export BENCH_CONFIG=dep32-eplb288.yaml
         [[ $a == borrow288 ]] && export TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
         run_case $a-$k noft --mode sweep --loads 128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
        case_index=$((case_index + 1))
        [[ $n == 1 ]] && require_done $a-$k
    done
    [[ $SLURM_NODEID == 0 ]] && grep -h "WIDEEP_EMPTY_EXTRA_SLOTS" "$out"/*/rank-0.log | sort | uniq -c
    echo STD_DONE
    ;;
esac
case $job in
BORROW-KILL-R1)
    # Code bar for the borrowed default (DECISIONS: borrowed when online EPLB is off) and NR1 at R1 DEP32: 320 slots
    # (node failure domain), extra slots borrowed, FT on, 128/GPU under load. 1) rank 5 killed in a decode step
    # (single-rank loss: its undelivered requests fail); 2) node 1 (ranks 4-7) killed in a decode step (node loss:
    # its undelivered requests run again on survivors). Pass: recovery commits, borrowed slots backed, serving
    # resumes, the load finishes; the counts of failed and re-run requests match the NR1 rule.
    export BENCH_CONFIG=dep32-b2-320.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost WIDEEP_FAILURE_DOMAIN=node
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json
    export TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    mkdir -p "$out/autotuner"
    load=(--mode failover --load 128 --iterations 2 --kill-window-s 30,45)
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-rank5
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case borrow-rank5-decode ft "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    require_done borrow-rank5-decode
    (export WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7 TLLM_TEST_KILL_TRIGGER=$out/trigger-node1
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case borrow-node1-decode ft "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    [[ $SLURM_NODEID == 0 ]] && grep -h "Restored .* expert slots\|resumed serving without\|Running .* requests of the lost ranks again\|ghost\|not recoverable\|RuntimeError" \
        "$out"/*/rank-0.log 2>/dev/null | cut -c1-240 | sort | uniq -c | head -20
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|fault_tolerance_status' "$out"/*/result.json | cut -c1-400
    echo STD_DONE
    ;;
esac
case $job in
C-COMBINE2)
    # EV5/EV6 attribution (overnight plan, GPU queue 2): eplb0, static 288 with ghost extra slots (FT off, the FT
    # default layout), static 288 with fixed replicas routed (no rebalancing), online EPLB 288; 1k/1k at 128 and
    # 256/GPU, n=2 per arm, shuffled; nsys (CUDA + NVTX) on all 32 ranks in one 50-step window at 128/GPU; slow-step
    # bursts counted per run. replicas288 separates "unused slots" from "slot count" (online288 may hide a per-slot
    # cost behind its balancing gain).
    export TLLM_TEST_NSYS_RANKS=all TLLM_TEST_NSYS_CAPTURE_END=repeat:2:async
    mkdir -p "$out/autotuner"
    order=$(for r in 1 2; do printf '%s\n' eplb0 ghost288 replicas288 online288; done | shuf --random-source=<(yes "$SLURM_JOB_ID$job") | tr '\n' ' ')
    echo "C_COMBINE2_ORDER $order"
    declare -A round
    n=0
    for a in $order; do
        n=$((n + 1)); round[$a]=$((${round[$a]:-0} + 1)); k=${round[$a]}
        (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json BENCH_CONFIG=dep32-eplb0.yaml
         case $a in
         ghost288) export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost ;;
         replicas288) export BENCH_CONFIG=dep32-b2-288.yaml ;;
         online288) export BENCH_CONFIG=dep32-eplb288.yaml ;;
         esac
         run_case $a-$k noft --mode sweep --loads 128,256 --iterations 2 --isl 1024 --osl 1024 --warm-each-load \
             --profile-after-s 20)
        case_index=$((case_index + 1))
        [[ $n == 1 ]] && require_done $a-$k
    done
    [[ $SLURM_NODEID == 0 ]] && for b in ghost288 replicas288 online288; do
        python3 $H/ab_stats.py "$out" eplb0 $b > "$out/ab_stats-eplb0-vs-$b.txt" 2>&1; done
    echo STD_DONE
    ;;
esac
case $job in
HANG-SET|HANG-SET-C10|HANG-SET-C30)
    # hang_confirm_s default (THREE DEFAULTS 3) in one factorial job: for confirm 10 and 30 s on the standard
    # deployment at 64/GPU: SIGSTOP of rank 2 (must fence: stop -> fence -> resume times), an all-rank 45 s host
    # stall (must not fence), a 45 s GIL hog on rank 2 at Python's default switch interval (must not fence) and at
    # 0.5 s (extreme: fences when no step completes for heartbeat_timeout_s + confirm, CLAIMS #77; informative).
    export BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_FAULT_TOLERANCE_HANG_DETECTION=1 WIDEEP_FENCE_COMMAND= TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json
    export TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1 TLLM_TEST_STALL_S=45
    mkdir -p "$out/autotuner"
    control=(--mode failover --kill control --load 64 --iterations 3 --kill-window-s 30,45)
    first=1
    # ~13 min per case: one confirm value per job fits 2 h (5 cases); HANG-SET runs both.
    confirms="10 30"; [[ $job == HANG-SET-C10 ]] && confirms=10; [[ $job == HANG-SET-C30 ]] && confirms=30
    for confirm in $confirms; do
        export TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=$confirm
        (export WIDEEP_VICTIM=2
         run_case stop-c$confirm ft --mode failover --load 64 --iterations 3 --kill-window-s 30,45 --kill stop)
        case_index=$((case_index + 1))
        [[ $first == 1 ]] && require_done stop-c$confirm; first=0
        (export TLLM_TEST_KILL_TRIGGER=$out/trigger-host-c$confirm TLLM_TEST_KILL_RANK=$(seq -s, 0 31)
         export TLLM_TEST_HOST_STALL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER TLLM_TEST_TRIGGER_NEEDS_REQUESTS=0
         run_case host45-c$confirm ft "${control[@]}")
        case_index=$((case_index + 1))
        for sw in default 0.5; do
            (export TLLM_TEST_KILL_TRIGGER=/tmp/wideep-trigger-$SLURM_JOB_ID-gil-$confirm-$sw TLLM_TEST_KILL_RANK=2
             export TLLM_TEST_GIL_HOG_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
             [[ $sw != default ]] && export TLLM_TEST_GIL_SWITCH_S=$sw
             run_case gil45-$sw-c$confirm ft "${control[@]}")
            case_index=$((case_index + 1))
        done
        # Two ranks' GPUs stall 45 s at once (no single culprit): must neither fence nor report the deployment dead.
        (export TLLM_TEST_KILL_TRIGGER=$out/trigger-stall2-c$confirm TLLM_TEST_KILL_RANK=2,9
         export TLLM_TEST_STALL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
         run_case stall2-c$confirm ft "${control[@]}")
        case_index=$((case_index + 1))
    done
    [[ $SLURM_NODEID == 0 ]] && grep -H "is hung\|fenc\|stalled\|resumed serving without" "$out"/*/authority.log "$out"/*/rank-0.log 2>/dev/null | sed 's/^.*runs\///' | cut -c1-220 | head -30
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"' "$out"/*/result.json | cut -c1-200
    echo STD_DONE
    ;;
KILL-MTP-R1)
    # 1) Smoke + exact tokens (tokens/frontend.py, routing excludes rank 2 from startup, small MTP + overlap config):
    #    a healthy run (PASS_HEALTHY = deterministic; ends the job otherwise), then twice a kill of rank 2 in the
    #    overlap scheduler's two uncommitted steps (GPU held ~2 s at step k, SIGKILL at step k+1) while it serves
    #    a request: survivors' 400-token outputs must equal the healthy pass. Rerun-once: the victim's undelivered
    #    request runs again once on a survivor and must be answered ("Madrid"). frontend.py still marks the case
    #    FAIL because it expects the victim's request to fail; RERUN_VERDICT below is the verdict for these cases.
    # 2) Load (bench.py failover, 128/GPU, 1k/1k) on the FINAL deployment (online EPLB 288, MTP, overlap, ADP
    #    balancing): rank 5 SIGKILLed in a decode step; rank 2 SIGKILLed in a prefill forward (context requests
    #    finishing in a discarded step, gap G2); node 1 (ranks 4-7, process-level node loss, 320 slots, node
    #    failure domain) SIGKILLed in a decode step. Pass: every survivor resumes, the load finishes (state DONE),
    #    no WIDEEP_CAPTURE / WIDEEP_COMPILE / WIDEEP_AUTOTUNE after "resumed serving" (v7 invariant 3).
    export CASE_TIMEOUT_S=1200 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    unset TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS
    mkdir -p "$out/autotuner"
    require_state() {  # NAME STATE: end the job on every node unless case NAME's result.json has STATE (tokens cases)
        local result=$out/$1/result.json
        for _ in $(seq 60); do [[ -s $result ]] && break; sleep 1; done
        grep -q "\"state\": \"$2\"" "$result" 2>/dev/null && return 0
        echo "SMOKE_FAIL $1: $(grep -o '"state": "[^"]*"' "$result" 2>/dev/null)"
        echo STD_DONE
        exit 1
    }
    # Static 288 for the oracle; empty extra slots: the long-tested restore path, so only spec-dec is new here.
    export TOKENS_CONFIG=config-small-mtp-overlap.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="--no-kill --max-tokens 400"; run_case mtp-tokens-ref ft)
    case_index=$((case_index + 1))
    require_state mtp-tokens-ref PASS_HEALTHY
    for k in 1 2; do
        trigger=/tmp/wideep-kill-$SLURM_JOB_ID-mtp-inflight-$k
        (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2 TLLM_TEST_KILL_IN_DECODE=$trigger
         export TLLM_TEST_KILL_WHEN_BUSY=1 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
         export TOKENS_ARGS="--inflight-after 1 --max-tokens 400 --no-probe --trigger $trigger"
         run_case mtp-tokens-inflight-$k ft)
        case_index=$((case_index + 1))
    done
    unset TOKENS_CONFIG TLLM_FAULT_TOLERANCE_EXTRA_SLOTS
    export BENCH_CONFIG=dep32-final.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft288.json
    export TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    load=(--mode failover --load 128 --iterations 2 --kill-window-s 30,45)
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-rank5
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case mtp-decode-rank5 ft "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    kill_case mtp-prefill-rank2 prefill 128 2
    (export BENCH_CONFIG=dep32-final-320.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft320.json
     export WIDEEP_FAILURE_DOMAIN=node WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7
     export TLLM_TEST_KILL_TRIGGER=$out/trigger-node1 TLLM_TEST_KILL_IN_DECODE=$out/trigger-node1
     run_case mtp-node1-decode ft "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    if [[ $SLURM_NODEID == 0 ]]; then
        # Rerun-once verdict per in-flight case: exact survivor tokens, victim request answered (not failed), the
        # kill landed mid-generation, and rank 0 logged exactly one rerun of the lost rank's requests.
        for k in 1 2; do
            name=mtp-tokens-inflight-$k
            reruns=$(grep -c "Running 1 requests of the lost ranks again" "$out/$name/rank-0.log" 2>/dev/null)
            python3 -c '
import json, sys
r = json.load(open(sys.argv[1]))
fields = dict(exact=r.get("exact_tokens_after_loss"), victim_failed=r.get("victim_request_failed"),
              answered=r.get("victim_request", {}).get("plausible"),
              finished_before_kill=r.get("victim_finished_before_kill"), reruns_logged=sys.argv[3])
ok = fields == dict(exact=True, victim_failed=False, answered=True, finished_before_kill=False, reruns_logged="1")
print("RERUN_VERDICT", sys.argv[2], "PASS" if ok else "FAIL", *(f"{k}={v}" for k, v in fields.items()))
' "$out/$name/result.json" "$name" "${reruns:-0}" 2>&1 | cut -c1-240
        done
        grep -H '"state"\|exact_tokens_after_loss\|victim_request_failed\|victim_held_no_requests' "$out"/*/result.json | sed 's/^.*runs\///' | cut -c1-240
        grep -h "discarding\|Running .* requests of the lost ranks again\|resumed serving without\|Restored .* expert slots\|not recoverable\|lacks\|RuntimeError" \
            "$out"/*/rank-0.log 2>/dev/null | cut -c1-240 | sort | uniq -c | head -20
        # v7 invariant 3: nothing captured, compiled or tuned once serving resumed (counters from testhooks.py).
        for log in "$out"/*/rank-0.log; do
            echo "AFTER_RESUME $(basename "$(dirname "$log")"): $(awk '/resumed serving without/ {r = 1} r && /WIDEEP_(CAPTURE|COMPILE|AUTOTUNE)/ {n++} END {print n + 0}' "$log")"
        done
    fi
    echo STD_DONE
    ;;
EXACT-FINAL)
    # Exact tokens after a recovery on the FINAL config (R1 NVFP4, one 8-node DEP32 group, real MTP acceptance), FT on,
    # node failure domain, for both deployments: "eplb" = dep32-final.yaml (online EPLB 288 + 32 ghost slots, MTP);
    # "static" = dep32-b2-320.yaml with ghost extra slots (that config has no MTP). Per deployment, two runs of
    # tokens/frontend.py (KILL-MTP-R1's machinery), routing around rank 5's slots from startup (oracle):
    # - exact-<dep>-ref: REQUESTS (ranks 0, 17, 31; 400 greedy tokens) twice (deterministic), then again with the
    #   victim prompt on survivor rank 1 and no kill (--probe-only): the reference for the victim's rerun.
    # - exact-<dep>-kill: REQUESTS once, then again with the victim prompt on rank 5; rank 5 SIGKILLed mid-decode in
    #   two uncommitted overlap steps. Its undelivered request runs again from its prompt on a survivor.
    # EXACT_FINAL_VERDICT: PASS iff the reference is deterministic, the kill landed mid-generation, every survivor's
    # tokens equal the reference (before and after the loss), the victim's request ran again exactly once, was answered
    # and equals the reference's victim prompt. Mismatches name the request (reqN@rankR) and its first differing token.
    # Budget: 4 starts of the full config (~7.5-9 min to ready with tuning, KILL-MTP-R1-8059722 / TWOKILL-R1B-8062252)
    # plus < 1 min serving each: ~40 min.
    if [[ $dist != "$C/$FINAL_BUILD/dist" || -n "${MVP_OVERLAY:-}" ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be FINAL_BUILD ($FINAL_BUILD) without MVP_OVERLAY ($dist, overlay '${MVP_OVERLAY:-}')"
        echo STD_DONE; exit 1
    fi
    export CASE_TIMEOUT_S=1200 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 WIDEEP_FAILURE_DOMAIN=node
    export TLLM_TEST_ORACLE_EXCLUDE_RANK=5 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    unset TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS TLLM_FAULT_TOLERANCE_EXTRA_SLOTS
    mkdir -p "$out/autotuner"
    tokens="--inflight-after 1 --max-tokens 400 --no-probe"
    for dep in eplb static; do
        if [[ $dep == eplb ]]; then
            export TOKENS_CONFIG=../configs/dep32-final.yaml; unset TLLM_FAULT_TOLERANCE_EXTRA_SLOTS
        else
            export TOKENS_CONFIG=../configs/dep32-b2-320.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
        fi
        export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$dep.json
        (export TOKENS_ARGS="$tokens --victim 1 --probe-only"; run_case exact-$dep-ref ft)
        case_index=$((case_index + 1))
        # The kill run only if the reference served (every node reads the same result.json).
        ref=$out/exact-$dep-ref/result.json
        for _ in $(seq 60); do [[ -s $ref ]] && break; sleep 1; done
        if ! grep -q '"deterministic"' "$ref" 2>/dev/null; then
            echo "EXACT_FINAL_SKIP $dep: reference did not serve ($(grep -o '"state": "[^"]*"' "$ref" 2>/dev/null))"
            continue
        fi
        trigger=$out/trigger-exact-$dep  # shared: rank 5 runs on node 1, the driver on node 0
        (export TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_IN_DECODE=$trigger TLLM_TEST_KILL_WHEN_BUSY=1
         export TOKENS_ARGS="$tokens --victim 5 --trigger $trigger"; run_case exact-$dep-kill ft)
        case_index=$((case_index + 1))
    done
    unset TOKENS_CONFIG TLLM_FAULT_TOLERANCE_EXTRA_SLOTS
    if [[ $SLURM_NODEID == 0 ]]; then
        for dep in eplb static; do
            kill_dir=$out/exact-$dep-kill
            reruns=$(grep -c "Running 1 requests of the lost ranks again" "$kill_dir/rank-0.log" 2>/dev/null)
            python3 - "$dep" "$out/exact-$dep-ref/result.json" "$kill_dir/result.json" "${reruns:-0}" <<'PY' 2>&1 | cut -c1-600
import json, sys
dep, ref_path, kill_path, reruns = sys.argv[1:]
def load(path):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return {}
def first_diff(want, got):
    want, got = want.get("token_ids") or [], got.get("token_ids") or []
    i = next((k for k, (a, b) in enumerate(zip(want, got)) if a != b), min(len(want), len(got)))
    return f"first_diff_token={i} len={len(want)}/{len(got)}"
ref, kill = load(ref_path), load(kill_path)
problems = []
if not ref.get("deterministic"):
    problems.append(f"ref_deterministic={ref.get('deterministic')}")
if ref.get("state") != "PROBE":
    problems.append(f"ref_state={ref.get('state')}")  # FAIL: the victim prompt on rank 1 changed the others' tokens
if not kill:
    problems.append("no kill result")
elif kill.get("victim_finished_before_kill") is not False:
    problems.append(f"victim_finished_before_kill={kill.get('victim_finished_before_kill')}")
reference = ref.get("healthy") or []
exact = 0
for phase in ("healthy", "recovered"):
    rows = kill.get(phase) or []
    if len(rows) != len(reference):
        problems.append(f"{phase}: {len(rows)} requests vs {len(reference)} in the reference")
        continue
    for i, (want, got) in enumerate(zip(reference, rows)):
        if "error" in got:
            problems.append(f"{phase} req{i}@rank{got.get('adp_rank')} failed: {got['error'][:80]}")
        elif want.get("token_ids") != got.get("token_ids"):
            problems.append(f"{phase} req{i}@rank{got.get('adp_rank')} differs: {first_diff(want, got)}")
        elif phase == "recovered":
            exact += 1
victim, want = kill.get("victim_request") or {}, ref.get("victim_request") or {}
rerun_exact = bool(victim.get("token_ids")) and victim.get("token_ids") == want.get("token_ids")
if "error" in victim:
    problems.append(f"victim req{len(reference)}@rank5 failed: {victim['error'][:80]}")
elif not rerun_exact:
    problems.append(f"victim req{len(reference)}@rank5 rerun vs reference@rank1 differs: {first_diff(want, victim)}")
if reruns != "1":
    problems.append(f"reruns_logged={reruns}")
print("EXACT_FINAL_VERDICT", dep, "FAIL" if problems else "PASS", f"survivors_exact={exact}/{len(reference)}",
      f"rerun_exact={rerun_exact}", f"reruns_logged={reruns}", f"plausible={victim.get('plausible')}",
      *(["problems=" + "; ".join(problems)] if problems else []))
PY
        done
        grep -H '"state"\|victim_finished_before_kill\|exact_tokens_after_loss\|victim_request_failed' "$out"/exact-*/result.json | sed 's/^.*runs\///' | cut -c1-240
        for log in "$out"/exact-*-kill/rank-0.log; do
            echo "AFTER_RESUME $(basename "$(dirname "$log")"): $(awk '/resumed serving without/ {r = 1} r && /WIDEEP_(CAPTURE|COMPILE|AUTOTUNE)/ {n++} END {print n + 0}' "$log")"
        done
    fi
    echo STD_DONE
    ;;
TWOKILL-R1|TWOKILL-R1B)
    # TWOKILL-R1B (<= 1 h): only the quarantine and node-1 -> rank 9 variants, after the harness fixes of
    # TWOKILL-R1-8060387 (testhooks: only the kill target acts on the prefill trigger; serve.sh: tagged case
    # processes are swept after each case and before the next).
    export CASE_TIMEOUT_S=1500 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export BENCH_CONFIG=dep32-b2-320.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost WIDEEP_FAILURE_DOMAIN=node
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    mkdir -p "$out/autotuner"
    # Preflight (seconds): the hooks this case needs, and a wheel that recovers more than once.
    preflight=$(python3 - "$H/testhooks.py" "$dist" <<'PY'
import glob, sys, zipfile
hooks = open(sys.argv[1]).read()
missing = [h for h in ("TLLM_TEST_KILL_TRIGGER_FOR", "TLLM_TEST_KILL_RERUN_OWNER") if h not in hooks]
wheels = glob.glob(sys.argv[2] + "/*.whl")
if not wheels:
    missing.append("wheel")
else:
    source = zipfile.ZipFile(wheels[0]).read("tensorrt_llm/_torch/pyexecutor/peer_loss_recovery.py").decode()
    missing += [] if "_own_loss_covered" in source else ["repeated recovery (ee7e9f0cab) in the wheel"]
print(" ".join(missing))
PY
)
    if [[ -n $preflight ]]; then echo "SMOKE_FAIL preflight: missing $preflight"; echo STD_DONE; exit 1; fi
    if [[ $job == TWOKILL-R1B ]]; then
        # Smoke (seconds, every node): the prefill trigger kills rank 5 and no other rank, also with the rerun-owner
        # hook on (8060387: rank 0 killed itself on the trigger); serve.sh tags and sweeps case processes.
        smoke=$(mktemp -d); touch "$smoke/trigger"
        for r in 0 3 5; do
            OMPI_COMM_WORLD_RANK=$r TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_IN_PREFILL=$smoke/trigger \
                TLLM_TEST_KILL_RERUN_OWNER=$smoke/rerun python3 -I - "$H/testhooks.py" > /dev/null 2>&1 <<'PY'
import importlib.machinery, importlib.util, sys, types
spec = importlib.util.spec_from_loader("hooks", importlib.machinery.SourceFileLoader("hooks", sys.argv[1]))
hooks = importlib.util.module_from_spec(spec)
spec.loader.exec_module(hooks)
class Engine:
    def forward(self, batch):
        return None
hooks._patch_engine(types.SimpleNamespace(PyTorchModelEngine=Engine))
Engine().forward(types.SimpleNamespace(generation_requests=(), num_context_requests=1, context_requests=[]))
PY
            hook_rc[r]=$?
        done
        if [[ ${hook_rc[0]} != 0 || ${hook_rc[3]} != 0 || ${hook_rc[5]} != 137 ]] || ! grep -q WIDEEP_CASE_TAG "$H/serve.sh"; then
            echo "SMOKE_FAIL preflight: prefill hook rc rank0=${hook_rc[0]} rank3=${hook_rc[3]} rank5=${hook_rc[5]} (want 0 0 137), serve.sh sweep $(grep -c WIDEEP_CASE_TAG "$H/serve.sh")"
            echo STD_DONE; exit 1
        fi
        # A decoy left over "from an earlier case": the first case's start sweep must kill it (checked after it).
        WIDEEP_CASE_TAG=$SLURM_JOB_ID:decoy sleep 7200 > /dev/null 2>&1 &
        decoy=$!
        echo "SMOKE_OK preflight node $SLURM_NODEID"
    fi
    require_verdict() {  # NAME: end the job on every node unless ft_watch.py judged case NAME PASS
        local verdict=$out/$1/verdict.json
        for _ in $(seq 180); do [[ -s $verdict ]] && break; sleep 1; done
        grep -q '"verdict": "PASS"' "$verdict" 2>/dev/null && return 0
        echo "SMOKE_FAIL $1: $(grep -o '"verdict": "[^"]*"' "$verdict" 2>/dev/null)"
        echo STD_DONE
        exit 1
    }
    twokill_case() {  # NAME WATCH_ARGS BENCH_ARGS...: one case with ft_watch.py beside it on node 0
        local name=$1 watch_args=$2 watch=""; shift 2
        if [[ $SLURM_NODEID == 0 ]]; then
            # shellcheck disable=SC2086
            python3 "$H/draft_cases/ft_watch.py" twokill --run "$out/$name" $watch_args > "$out/watch-$name.log" 2>&1 &
            watch=$!
        fi
        run_case "$name" ft "$@"
        [[ -n $watch ]] && { timeout 300 tail --pid="$watch" -f /dev/null; cat "$out/watch-$name.log"; }
    }
    load=(--mode failover --load 128 --iterations 3 --kill-window-s 30,45)
    # 1) rank 5, then rank 9 after the first recovery committed.
    if [[ $job == TWOKILL-R1 ]]; then
    name=twokill-rank5-rank9
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name-rank5
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER TLLM_TEST_KILL_TRIGGER_FOR=9=$out/trigger-$name-rank9
     twokill_case $name "--first-count 31 --final-count 30 --expect-failed 5,9 --second-trigger $out/trigger-$name-rank9" \
         "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    require_verdict $name
    fi
    # 2) rank 5 in a first-wave prefill, then the new owner of one of its re-run requests (quarantine).
    name=twokill-rerun-quarantine
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name-rank5
     export TLLM_TEST_KILL_IN_PREFILL=$TLLM_TEST_KILL_TRIGGER TLLM_TEST_KILL_RERUN_OWNER=$out/rerun-$name
     twokill_case $name "--first-count 31 --final-count 30 --expect-failed 5 --rerun-owner $out/rerun-$name" \
         --mode failover --load 128 --iterations 3 --kill-window-s 2,6 --kill prefill)
    case_index=$((case_index + 1))
    if [[ -n ${decoy:-} ]] && kill -0 "$decoy" 2>/dev/null; then
        kill -9 "$decoy"; echo "SMOKE_FAIL node $SLURM_NODEID: the start sweep left a tagged decoy running"; echo STD_DONE; exit 1
    fi
    # 3) node 1 (ranks 4-7), then rank 9.
    name=twokill-node1-rank9
    (export WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name-node1
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER TLLM_TEST_KILL_TRIGGER_FOR=9=$out/trigger-$name-rank9
     twokill_case $name "--first-count 28 --final-count 27 --expect-failed 4,5,6,7,9 --second-trigger $out/trigger-$name-rank9" \
         "${load[@]}" --kill decode)
    case_index=$((case_index + 1))
    if [[ $SLURM_NODEID == 0 ]]; then
        grep -h "TWOKILL_VERDICT" "$out"/watch-*.log | cut -c1-600
        grep -h "Restored .* expert slots\|resumed serving without\|Running .* requests of the lost ranks again\|WIDEEP_RERUN\|WIDEEP_QUARANTINE\|failed during the recovery\|not recoverable\|RuntimeError" \
            "$out"/*/rank-0.log 2>/dev/null | sed 's/^.*\(resumed serving\)/\1/' | cut -c1-200 | sort | uniq -c | head -30
        grep -h "WIDEEP_SELF_KILL\|RANK_EXIT\|MPIRUN_EXIT" "$out"/*/rank-{4,5,9}.log "$out"/*/timeline 2>/dev/null | cut -c1-160 | head -20
        grep -H '"state"' "$out"/*/result.json | sed 's/^.*runs\///' | cut -c1-200
    fi
    echo STD_DONE
    ;;
DRH2-R1)
    export CASE_TIMEOUT_S=900 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TOKENS_CONFIG=config-small-overlap.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty
    export TLLM_TEST_ORACLE_EXCLUDE_RANK=5
    victim_node=1 victim_gpu=1  # rank 5 = node 1, local rank 1
    # Preflight (seconds): the hooks this case needs, and a wheel.
    missing=""
    for hook in TLLM_TEST_DELAY_ABORT_S TLLM_TEST_LATE_WRITE_IN_DECODE; do
        grep -q "$hook" "$H/testhooks.py" || missing="$missing $hook"
    done
    compgen -G "$dist/*.whl" > /dev/null || missing="$missing wheel"
    if [[ -n $missing ]]; then echo "SMOKE_FAIL preflight: missing$missing"; echo STD_DONE; exit 1; fi
    require_state() {  # NAME STATE: end the job on every node unless case NAME's result.json has STATE
        local result=$out/$1/result.json
        for _ in $(seq 60); do [[ -s $result ]] && break; sleep 1; done
        grep -q "\"state\": \"$2\"" "$result" 2>/dev/null && return 0
        echo "SMOKE_FAIL $1: $(grep -o '"state": "[^"]*"' "$result" 2>/dev/null)"
        echo STD_DONE
        exit 1
    }
    kernel_log() {  # RUN PHASE: this node's Xid / NVRM kernel-log lines (or why they are unreadable)
        local file=$1/kernel-$SLURM_NODEID-$2.txt msg
        if msg=$(dmesg -T 2>&1); then
            { echo "dmesg ok $(date +%s)"; grep -iE 'xid|nvrm' <<< "$msg" | tail -200; } > "$file"
        else
            echo "dmesg not permitted: ${msg:0:160}" > "$file"
        fi
    }
    drh2_case() {  # NAME: one tokens case (TOKENS_ARGS and hooks from the caller), kernel log around it
        local name=$1 run=$out/$1 sampler=""
        mkdir -p "$run"
        kernel_log "$run" before
        if [[ $SLURM_NODEID == "$victim_node" ]]; then
            # When the victim's GPU memory is freed (T_free), every ~0.3 s: epoch, MiB used.
            ( while [[ ! -e $run/frontend.done && ! -e $run/done ]]; do
                  echo "$(date +%s.%N), $(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -i $victim_gpu 2>&1)"
                  sleep 0.2
              done > "$run/victim-gpumem.csv" ) &
            sampler=$!
        fi
        run_case "$name" ft
        kernel_log "$run" after
        [[ -n $sampler ]] && kill "$sampler" 2>/dev/null
    }
    drh2_verdict() {  # NAME MODE [DELAY_S]: node 0, once every node's kernel log after the case is in
        [[ $SLURM_NODEID == 0 ]] || return 0
        for _ in $(seq 300); do
            (( $(ls "$out/$1"/kernel-*-after.txt 2>/dev/null | wc -l) >= SLURM_NNODES )) && break
            sleep 1
        done
        python3 "$H/draft_cases/ft_watch.py" drh2 --run "$out/$1" --victim 5 --mode "$2" --delay-s "${3:-0}" \
            2>&1 | tee -a "$out/drh2-verdicts.log" | cut -c1-600
    }
    inflight="--victim 5 --inflight-after 1 --max-tokens 480 --no-probe"
    # 1) Smoke: healthy, deterministic.
    (export TOKENS_ARGS="--victim 5 --no-kill --max-tokens 480"; drh2_case drh2-ref)
    case_index=$((case_index + 1))
    require_state drh2-ref PASS_HEALTHY
    # 2) Control and 3) delayed abort: SIGKILL in two uncommitted overlap steps.
    for name in drh2-control drh2-delay10-1 drh2-delay10-2; do
        delay=0; [[ $name == drh2-delay10-* ]] && delay=10
        trigger=$out/trigger-$name
        (export TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_IN_DECODE=$trigger TLLM_TEST_KILL_WHEN_BUSY=1
         export TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1 TLLM_TEST_DELAY_ABORT_S=$delay
         export TOKENS_ARGS="$inflight --trigger $trigger"
         drh2_case $name)
        case_index=$((case_index + 1))
        mode=control; [[ $delay != 0 ]] && mode=delay-abort
        drh2_verdict $name $mode
    done
    # 4) Late writes of a lost-but-alive victim.
    for delay in 9 12; do
        name=drh2-latewrite-$delay trigger=$out/trigger-drh2-latewrite-$delay
        (export TLLM_TEST_KILL_RANK=5 TLLM_TEST_LATE_WRITE_IN_DECODE=$trigger TLLM_TEST_LATE_WRITE_DELAY_S=$delay
         export TLLM_TEST_LATE_WRITE_KILL_S=30 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
         export TOKENS_ARGS="$inflight --trigger $trigger"
         drh2_case $name)
        case_index=$((case_index + 1))
        drh2_verdict $name late-write $delay
    done
    if [[ $SLURM_NODEID == 0 ]]; then
        grep -h "DRH2_VERDICT" "$out/drh2-verdicts.log" | cut -c1-400
        grep -h "WIDEEP_ABORT_DELAY\|WIDEEP_ABORT_SET\|WIDEEP_SELF_\|WIDEEP_LATE_WRITE\|resumed serving without\|Running .* requests of the lost ranks again\|RuntimeError" \
            "$out"/drh2-*/rank-{0,5}.log 2>/dev/null | sed 's/ t=[0-9.]*//' | cut -c1-200 | sort | uniq -c | head -30
        grep -H "RANK_EXIT" "$out"/drh2-*/timeline 2>/dev/null | sed 's/^.*runs\///' | head -12
        head -3 "$out"/drh2-ref/kernel-*-before.txt 2>/dev/null | cut -c1-200
    fi
    echo STD_DONE
    ;;
C-COMBINE3)
    export CASE_TIMEOUT_S=1080
    seed=$C/mvp/runs/C-COMBINE2-8055947/autotuner
    if [[ $dist != *4c27cd5a98* || ! -s $seed/eplb0.json ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be build-dev-4c27cd5a98 (seed caches $seed)"; echo STD_DONE; exit 1
    fi
    mkdir -p "$out/autotuner"
    if [[ $SLURM_NODEID == 0 ]]; then
        for f in eplb0 ghost288 online288 replicas288; do cp "$seed/$f.json" "$out/autotuner/.$f.tmp"; done
        mv "$out/autotuner/.eplb0.tmp" "$out/autotuner/lb.json"  # eplb0 and lb256: same keys, one cache
        for f in ghost288 online288 replicas288; do mv "$out/autotuner/.$f.tmp" "$out/autotuner/$f.json"; done
    fi
    for _ in $(seq 120); do [[ -s $out/autotuner/replicas288.json && -s $out/autotuner/lb.json ]] && break; sleep 1; done
    arm_env() {  # ARM: the arm's config, hooks and tuner cache (call in the case's subshell)
        export BENCH_CONFIG=dep32-eplb0.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/lb.json
        case $1 in
        lb256) export BENCH_CONFIG=dep32-lb256.yaml ;;
        ghost288) export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
                  export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ghost288.json ;;
        replicas288) export BENCH_CONFIG=dep32-b2-288.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/replicas288.json ;;
        online288) export BENCH_CONFIG=dep32-eplb288.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/online288.json ;;
        esac
    }
    load=(--mode sweep --loads 128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
    (arm_env lb256; run_case lb256-1 noft "${load[@]}")
    case_index=$((case_index + 1))
    arms="eplb0 ghost288 online288 lb256"
    if ! grep -q '"state": "DONE"' "$out/lb256-1/result.json" 2>/dev/null; then
        echo "LB256_FAIL lb256-1: $(grep -o '"state": "[^"]*"' "$out/lb256-1/result.json" 2>/dev/null); dropping lb256"
        arms="eplb0 ghost288 online288"
    fi
    order=""
    for r in 1 2 3; do
        order="$order $(printf '%s\n' $arms | shuf --random-source=<(yes "$SLURM_JOB_ID-$r") | tr '\n' ' ')"
    done
    order=${order/lb256 /}  # lb256's round 1 ran as the smoke
    echo "C_COMBINE3_ORDER lb256(smoke) $order"
    declare -A round
    round[lb256]=1
    smoke=$([[ $arms == *lb256* ]] && echo 0 || echo 1)
    for a in $order; do
        round[$a]=$((${round[$a]:-0} + 1)); k=${round[$a]}
        (arm_env $a; run_case $a-$k noft "${load[@]}")
        case_index=$((case_index + 1))
        [[ $smoke == 1 ]] && require_done $a-$k
        smoke=0
    done
    # (c) histograms: main's ExpertStatistic records iterations 1600-1649 (mid first wave at full load in
    # C-HOSTACC's eplb0/empty288 logs: full load ~1200-2100) eagerly (CUDA graphs off for those steps only), so
    # these cases are not timed. Run only while >= 12 min remain (node 0 decides from SLURM_JOB_END_TIME).
    if grep -q TLLM_TEST_EXPERT_STATISTIC "$H/testhooks.py"; then
        for a in eplb0 replicas288 online288; do
            go=$out/hist-$a.go
            if [[ $SLURM_NODEID == 0 ]]; then
                end=${SLURM_JOB_END_TIME:-$(( $(date +%s) - SECONDS + 7200 ))}  # else: 2 h from job.sh start
                left=$(( end - $(date +%s) ))
                (( left >= 720 )) && echo 1 > "$go.tmp" || echo 0 > "$go.tmp"
                mv "$go.tmp" "$go"
            fi
            for _ in $(seq 120); do [[ -s $go ]] && break; sleep 1; done
            [[ $(cat "$go" 2>/dev/null) == 1 ]] || { echo "HIST_SKIP $a (time)"; break; }
            (arm_env $a
             export TLLM_TEST_EXPERT_STATISTIC_ITER_RANGE=1600-1650 TLLM_TEST_EXPERT_STATISTIC_PATH=$out/hist-$a/expert_stat
             run_case hist-$a noft --mode sweep --loads 128 --iterations 1 --isl 1024 --osl 1024 --warm-each-load)
            case_index=$((case_index + 1))
        done
    else
        echo "HIST_SKIP testhooks-c3.patch not applied"
    fi
    if [[ $SLURM_NODEID == 0 ]]; then
        for b in lb256 ghost288 online288; do
            python3 $H/ab_stats.py "$out" eplb0 $b > "$out/ab_stats-eplb0-vs-$b.txt" 2>&1; done
        python3 $H/ab_stats.py "$out" lb256 ghost288 > "$out/ab_stats-lb256-vs-ghost288.txt" 2>&1
        python3 $H/burst_counts.py "$out" > "$out/burst_counts.txt" 2>&1
        for d in "$out"/*-[0-9]*/ "$out"/hist-*/; do
            [[ -d $d ]] && echo "AUTOTUNE_COUNT $(basename "$d") $(cat "$d"/rank-*.log 2>/dev/null | grep -c WIDEEP_AUTOTUNE)"
        done
        python3 $H/draft_cases/expert_hist.py "$out"/hist-*/ 2>&1
        grep -h "WIDEEP_EMPTY_EXTRA_SLOTS\|MoE load balancer enabled" "$out"/*/rank-0.log | cut -c1-160 | sort | uniq -c
    fi
    echo STD_DONE
    ;;
esac
# Optional follow-up C-COMBINE3-PIN (hypothesis (d): ranks running different tactics for the same shape widen the
# cross-rank GEMM spread). Same wheel and seeds; the -pin arms read a cache in which every rank's MoE entry carries
# the tactic most ranks chose (pin_tactics.py). eplb0 vs eplb0pin and ghost288 vs ghost288pin, 3 blocked rounds
# (~96 min). Decision: a pin arm faster by more than eplb0's round-to-round gap -> per-rank tactic choice is a cause
# (fix direction: tune once and share tactics across ranks); ghost288pin - eplb0pin is then the 9-vs-8 cost proper.
case $job in
C-COMBINE3-PIN)
    export CASE_TIMEOUT_S=1080
    seed=$C/mvp/runs/C-COMBINE2-8055947/autotuner
    if [[ $dist != *4c27cd5a98* || ! -s $seed/eplb0.json ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be build-dev-4c27cd5a98 (seed caches $seed)"; echo STD_DONE; exit 1
    fi
    mkdir -p "$out/autotuner"
    if [[ $SLURM_NODEID == 0 ]]; then
        for f in eplb0 ghost288; do
            cp "$seed/$f.json" "$out/autotuner/.$f.tmp" && mv "$out/autotuner/.$f.tmp" "$out/autotuner/$f.json"
            python3 $H/draft_cases/pin_tactics.py "$seed/$f.json" "$out/autotuner/.${f}pin.tmp" \
                && mv "$out/autotuner/.${f}pin.tmp" "$out/autotuner/${f}pin.json"
        done
    fi
    for _ in $(seq 120); do [[ -s $out/autotuner/ghost288pin.json ]] && break; sleep 1; done
    order=""
    for r in 1 2 3; do
        order="$order $(printf '%s\n' eplb0 eplb0pin ghost288 ghost288pin | shuf --random-source=<(yes "$SLURM_JOB_ID-$r") | tr '\n' ' ')"
    done
    echo "C_COMBINE3_PIN_ORDER $order"
    declare -A round
    n=0
    for a in $order; do
        n=$((n + 1)); round[$a]=$((${round[$a]:-0} + 1)); k=${round[$a]}
        (export BENCH_CONFIG=dep32-eplb0.yaml TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$a.json
         [[ $a == ghost288* ]] && export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1 \
             TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
         run_case $a-$k noft --mode sweep --loads 128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
        case_index=$((case_index + 1))
        [[ $n == 1 ]] && require_done $a-$k
    done
    if [[ $SLURM_NODEID == 0 ]]; then
        python3 $H/ab_stats.py "$out" eplb0 eplb0pin > "$out/ab_stats-eplb0-vs-eplb0pin.txt" 2>&1
        python3 $H/ab_stats.py "$out" ghost288 ghost288pin > "$out/ab_stats-ghost288-vs-ghost288pin.txt" 2>&1
        python3 $H/ab_stats.py "$out" eplb0pin ghost288pin > "$out/ab_stats-eplb0pin-vs-ghost288pin.txt" 2>&1
        python3 $H/burst_counts.py "$out" > "$out/burst_counts.txt" 2>&1
        for d in "$out"/*-[0-9]*/; do echo "AUTOTUNE_COUNT $(basename "$d") $(cat "$d"/rank-*.log | grep -c WIDEEP_AUTOTUNE)"; done
    fi
    echo STD_DONE
    ;;
FT-COST-E2E|FT-COST-ATTR|FT-COST-MECH|FT-COST-PROF|FT-COST-PROF-B|C-COMBINE4-PIN|FT-COST-AUTO|FT-COST-BISECT|GHOST-TAC|GHOST-TAC-B|LADDER|LADDER-B|GHOST-COST|GHOST-COST-B|FINAL-AUTO)
    export CASE_TIMEOUT_S=1500 BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1
    # The final benchmark's jobs run the final build (FINAL_BUILD); the older ones the wheel they were designed on.
    want_build=build-next-fcc86b10b2
    [[ $job == LADDER* || $job == GHOST-COST* || $job == FINAL-AUTO || ( $job == FT-COST-PROF* && -n ${PROF_ON_FINAL:-} ) ]] && want_build=$FINAL_BUILD
    if [[ $dist != "$C/$want_build/dist" || -n "${MVP_OVERLAY:-}" ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be $want_build without MVP_OVERLAY ($dist, overlay '${MVP_OVERLAY:-}')"
        echo STD_DONE; exit 1
    fi
    arms=${FT_COST_E2E_ARMS:-noft-stack ft}
    load=(--mode sweep --loads 8,32,128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
    tune_arms=""      # arms of the tuning pass (default: every arm)
    ab_pairs=""       # "BASE:TEST ..." pairs for ab_stats/burst_ranksum (default: every arm vs ft, noft-stack vs ft)
    # LADDER / LADDER-B (FINAL_BENCHMARK_PLAN L1/L2): FT's healthy cost on the final build and what the cost fixes
    # bought, dep32-final.yaml, 8/32/128 per GPU, pinned tactics. Arms: noft (final wheel, FT off), ft-base (FT on,
    # fixes off: FINAL_BASE_BUILD wheel or FINAL_BASE_OVERLAY reverting the fix commits), ft (FT on, all fixes). One
    # noft-main tail case (main's wheel, FT off) per job if room: FT-off noft-main vs noft (n<=2, coarse check only).
    # LADDER tunes noft + ft once (one layout, so ft-base reads the same table); LADDER-B requires FT_COST_E2E_SEED =
    # LADDER's autotuner/pinned.json. Budget per job (QOS 2 h; FT-COST-E2E-8059717/8064963: ~12.5 min per 3-load case,
    # tuning noft + ft ~21 min incl. first start): LADDER 21 + 2 rounds x 3 x 12.5 = 96 min (round 3 needs 41 more:
    # starts only if FT_COST_E2E_ROUND_MIN fits, i.e. cases ran <=11 min) + tail 13 = ~109 min; LADDER-B 3 x 37.5 =
    # 113 min (+ tail only if room). Expect 5 runs per arm over L1+L2 (6 if L1 is seeded from a preflight tuning).
    if [[ $job == LADDER* ]]; then
        arms=${FT_COST_E2E_ARMS:-noft ft-base ft}; tune_arms=${LADDER_TUNE_ARMS:-noft ft}
        ab_pairs=${LADDER_PAIRS:-noft:ft noft:ft-base ft-base:ft noft:noft-main}
        export FT_COST_E2E_ROUNDS=${FT_COST_E2E_ROUNDS:-3}
        export FT_COST_E2E_ROUND_MIN=${FT_COST_E2E_ROUND_MIN:-$(( 13 * $(wc -w <<< "$arms") + 2 ))}
        base_ok=0
        [[ -n ${FINAL_BASE_BUILD:-} && -z ${FINAL_BASE_OVERLAY:-} ]] && compgen -G "$C/$FINAL_BASE_BUILD/dist/*.whl" > /dev/null && base_ok=1
        [[ -z ${FINAL_BASE_BUILD:-} && -n ${FINAL_BASE_OVERLAY:-} && -d ${FINAL_BASE_OVERLAY:-/none}/tensorrt_llm ]] && base_ok=1
        if [[ $base_ok != 1 || ( $job == LADDER-B && -z ${FT_COST_E2E_SEED:-} ) ]]; then
            echo "SMOKE_FAIL preflight: ft-base needs exactly one of FINAL_BASE_BUILD (wheel dir) / FINAL_BASE_OVERLAY" \
                "(dir with tensorrt_llm/); LADDER-B needs FT_COST_E2E_SEED (got '${FT_COST_E2E_SEED:-}')"
            echo STD_DONE; exit 1
        fi
    fi
    # GHOST-COST / GHOST-COST-B (FINAL_BENCHMARK_PLAN G1/G2): the layout cost of ghost slots, which must reach ~0%.
    # GHOST-COST: static, FT off: lay-eplb0 (256 slots) vs lay-ghost320 (256 + 64 ghost, the R1 FT layout).
    # GHOST-COST-B: mixed, FT on: ft (online EPLB 288, dep32-final.yaml) vs ft-mixed (online 288 + 32 ghost,
    # MIXED_EPLB_GHOST.md; FINAL_MIXED_CONFIG names its yaml in configs/). Each tunes its own two arms at 128/GPU
    # (layouts differ, GHOST-TAC) unless FT_COST_E2E_SEED is set: a seeded rerun of either label adds rounds.
    # Budget (C-COMBINE4-PIN-8066483: tuning both arms ~28 min, eplb0 ~6 / ghost320 ~11 min per 128 case, +~2 min
    # for load 32; FT cases ~12.5; ROUND_MIN 28): GHOST-COST 28 + 3 rounds x 21 = 91 min (a 4th only if cases run
    # faster); GHOST-COST-B 25 + 3 x 27 = 106 min; a seeded rerun 5 (static, ~105 min) / 4 (mixed, ~108 min) rounds.
    # >=6 per arm needs one seeded rerun per pair (FINAL_CASES.md).
    if [[ $job == GHOST-COST* ]]; then
        arms=${FT_COST_E2E_ARMS:-lay-eplb0 lay-ghost320}; ab_pairs=${GHOST_COST_PAIRS:-lay-eplb0:lay-ghost320}
        tune_arms=${GHOST_COST_TUNE_ARMS:-}
        if [[ $job == GHOST-COST-B ]]; then
            arms=${FT_COST_E2E_ARMS:-ft ft-mixed}; ab_pairs="ft:ft-mixed"
            if [[ ! -s $H/configs/${FINAL_MIXED_CONFIG:-none} ]]; then
                # TODO(mixed EPLB+ghost feature): the config form is owner decision 13 (EPLB num_slots 288 + G=1 ghost
                # per rank = 320 slots); add configs/<yaml> and pass FINAL_MIXED_CONFIG=<yaml>.
                echo "SMOKE_FAIL preflight: FINAL_MIXED_CONFIG '${FINAL_MIXED_CONFIG:-}' is not in configs/"; echo STD_DONE; exit 1
            fi
        fi
        export FT_COST_E2E_ROUNDS=${FT_COST_E2E_ROUNDS:-6}
        export FT_COST_E2E_ROUND_MIN=${FT_COST_E2E_ROUND_MIN:-$(( 13 * $(wc -w <<< "$arms") + 2 ))}
        load=(--mode sweep --loads ${GHOST_COST_LOADS:-32,128} --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
    fi
    # FINAL-AUTO (A1): FT-COST-AUTO's tune-once-per-arm design on the final build, arms noft vs ft, 2 rounds.
    # Budget (FT-COST-AUTO-8066486: ~23 min startup tuning per untuned start): round 1 2 x ~36 = 72 min, round 2
    # 2 x 12.5 = 25 min: ~97 min.
    if [[ $job == FINAL-AUTO ]]; then
        arms=${FT_COST_E2E_ARMS:-noft ft}; ab_pairs="noft:ft"
        export FT_COST_E2E_ROUNDS=${FT_COST_E2E_ROUNDS:-2}
    fi
    # ATTR (CLAIMS #93: ft costs ~1.6% at 8 and 128/GPU vs main's FT-off launch): which FT-required launch piece costs it,
    # all arms FT off: noft-stack (UCX) vs noft-ulfm-nodet (ULFM ob1/TCP, no detector) vs noft-ulfm (ob1/TCP + detector).
    # MECH (CLAIMS #98: transport + detector ~0.3% at 128/GPU): FT's own mechanism, ft vs noft-ulfm (same launch).
    # PROF (CLAIMS #104: FT's mechanism costs +2.1% at 128/GPU): nsys (CUDA + NVTX) on all 32 ranks, one 50-step window
    # at 128/GPU, ft vs noft-ulfm, pinned tactics, 2 rounds - attribute the extra time per kernel and host range.
    # PROF_ON_FINAL=1: the same on FINAL_BUILD (arms e.g. "noft ft", PROF_LOADS the load the ladder flagged); PROF-B packs a second load.
    if [[ $job == FT-COST-PROF* ]]; then
        arms=${FT_COST_E2E_ARMS:-noft-ulfm ft}; export FT_COST_E2E_ROUNDS=${FT_COST_E2E_ROUNDS:-2}
        export TLLM_TEST_NSYS_RANKS=all TLLM_TEST_NSYS_CAPTURE_END=repeat:1:async
        load=(--mode sweep --loads ${PROF_LOADS:-128} --iterations 2 --isl 1024 --osl 1024 --warm-each-load --profile-after-s 20)
    fi
    # C-COMBINE4-PIN (CLAIMS #89/#91/#92): the 288-slot layout cost with ONE majority-pinned tactic per shape on every
    # rank (tuned in-job, merged and pinned): FT off, eplb0 vs static 320 with ghost slots (the FT-on R1 layout),
    # 128/GPU, rounds rotate; >=6 rounds over two jobs (second job seeded with the first's pinned.json).
    # If the gap of #89 (~2-6%) shrinks, per-rank tactic disagreement (#91) caused it.
    if [[ $job == C-COMBINE4-PIN ]]; then
        arms=${FT_COST_E2E_ARMS:-lay-eplb0 lay-ghost320}
        load=(--mode sweep --loads 128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
    fi
    # GHOST-TAC (CLAIMS #107: ghost320 +4.99% vs eplb0 with per-layout pinned tactics): the tuning profile spreads
    # tokens over all 10 local slots, ghost slots included, so ghost320 picks other tactics than eplb0 for the same load
    # (21 of its MoE entries per rank differ). Arms: eplb0; lb256 (load balancer path, eplb0's slots and keys); ghost320
    # (own tactics); ghost320-etac (eplb0's tactic per matching shape, draft_cases/transplant_tactics.py). Seeded with
    # #107's pinned.json, FT off, 128/GPU. Decides tactic choice vs LB path vs slot count. Design: GHOST_LAYOUT_COST.md.
    if [[ $job == GHOST-TAC* ]]; then
        arms=${FT_COST_E2E_ARMS:-lay-eplb0 lay-lb256 lay-ghost320 lay-ghost320-etac}
        export FT_COST_E2E_SEED=${FT_COST_E2E_SEED:-$C/mvp/runs/C-COMBINE4-PIN-8066483/autotuner/pinned.json}
        export FT_COST_E2E_ROUNDS=${FT_COST_E2E_ROUNDS:-3}
        export FT_COST_E2E_ROUND_MIN=${FT_COST_E2E_ROUND_MIN:-$(( 11 * $(wc -w <<< "$arms") + 2 ))}
        load=(--mode sweep --loads 128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
    fi
    if [[ $job == FT-COST-MECH ]]; then
        arms=${FT_COST_E2E_ARMS:-noft-ulfm ft}
        load=(--mode sweep --loads 8,128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
    fi
    if [[ $job == FT-COST-ATTR ]]; then
        arms=${FT_COST_E2E_ARMS:-noft-stack noft-ulfm-nodet noft-ulfm}
        load=(--mode sweep --loads 8,128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
    fi
    # BISECT (CLAIMS #104: ft +2.09% steady step at 128/GPU vs noft-ulfm; nsys could not resolve it): which part of
    # FT's mechanism costs it, at full fidelity. Third arm: ft with one group of FT's healthy-path work removed by
    # benchmark-only hooks (TLLM_TEST_FT_OFF, testhooks.py; healthy cases only). Default ft-noH: the serving thread's FT
    # host work (resp + step + coll). Seeded with #104's pinned tactics. Design: draft_cases/FT-COST-BISECT.md.
    if [[ $job == FT-COST-BISECT ]]; then
        arms=${FT_COST_E2E_ARMS:-noft-ulfm ft ft-noH}
        export FT_COST_E2E_SEED=${FT_COST_E2E_SEED:-$C/mvp/runs/FT-COST-E2E-8059717/autotuner/pinned.json}
        # ~10.5 min per 128-only case: a round starts only with room for all of it.
        export FT_COST_E2E_ROUNDS=${FT_COST_E2E_ROUNDS:-4}
        export FT_COST_E2E_ROUND_MIN=${FT_COST_E2E_ROUND_MIN:-$(( 11 * $(wc -w <<< "$arms") + 2 ))}
        load=(--mode sweep --loads 128 --iterations 2 --isl 1024 --osl 1024 --warm-each-load)
    fi
    ft_off_pieces() {  # ARM: TLLM_TEST_FT_OFF of a hook arm, sorted as WIDEEP_FT_OFF_ACTIVE lists them; empty otherwise
        case $1 in
        ft-noH) echo coll,resp,step ;;
        ft-noT) echo watch ;;
        ft-noresp) echo resp ;;
        ft-nostep) echo step ;;
        ft-nocoll) echo coll ;;
        esac
    }
    hook_ok() {  # CASE ARM (node 0): the case is DONE and its rank logs prove ARM's hooks took effect, or that none ran
        local d=$out/$1 want; want=$(ft_off_pieces "$2")
        local logs=("$d"/rank-*.log)
        local lines errors proven wrapped calls finished missing=""
        lines=$(cat "${logs[@]}" 2>/dev/null | grep -c WIDEEP_FT_OFF)
        errors=$(cat "${logs[@]}" 2>/dev/null | grep -c WIDEEP_FT_OFF_ERROR)
        proven=$(grep -l "WIDEEP_FT_OFF_ACTIVE rank [0-9]* t=[0-9.]* serving=1 verified=${want:--} hang_detection=False" \
            "${logs[@]}" 2>/dev/null | wc -l)
        wrapped=$(grep -l "WIDEEP_FT_OFF rank [0-9]* t=[0-9.]* module=communicator unwrapped=12 " "${logs[@]}" 2>/dev/null | wc -l)
        calls=$(grep -o "WIDEEP_FT_OFF_CALL rank 0 t=[0-9.]* name=[a-z_]*" "$d/rank-0.log" 2>/dev/null | sed 's/.*name=//' | sort -u)
        [[ $want == *resp* ]] && for c in fetching_requests broadcast_requests requests_routed gathering_responses responses_gathered; do
            grep -qx "$c" <<< "$calls" || missing+="$c,"; done
        [[ $want == *step* ]] && for c in step_prepared commit_step; do grep -qx "$c" <<< "$calls" || missing+="$c,"; done
        finished=$(grep -c '"state": "DONE"' "$d/result.json" 2>/dev/null)
        echo "HOOK_CHECK $1 want=${want:-none} done=$finished ranks=${#logs[@]} proven=$proven unwrapped12=$wrapped lines=$lines" \
            "errors=$errors rank0_calls=$(paste -sd, <<< "$calls") missing=${missing:--}" | tee -a "$out/hook_check.txt"
        [[ $finished == 1 ]] || return 1
        [[ -z $want ]] && { (( lines == 0 )); return; }
        (( ${#logs[@]} == 32 && proven == 32 && errors == 0 )) && [[ -z $missing ]] && [[ $want != *coll* || $wrapped == 32 ]]
    }
    tuner=$out/autotuner; pinned=$tuner/pinned.json
    mkdir -p "$tuner"
    arm_case() {  # NAME ARM CACHE [bench.py args...]: one case of ARM reading CACHE
        local name=$1 arm=$2 cache=$3; shift 3
        (export TLLM_AUTOTUNER_CACHE_PATH=$cache
         case $arm in
         noft-stack|noft) run_case "$name" noft "$@" ;;
         noft-main) (dist=$C/build-pr0-fc52f0adee/dist; run_case "$name" noft "$@") ;;
         # FT-off A/A: a second FT-off arm on the same build, so the noise between identical arms is measured.
         noft-aa) run_case "$name" noft "$@" ;;
         lay-eplb0-aa) (export BENCH_CONFIG=dep32-eplb0.yaml; run_case "$name" noft "$@") ;;
         # Per-arm wheel: serve.sh installs the dist it is given (install_wheel.sh reinstalls when the wheel changes).
         ft-base) (if [[ -n ${FINAL_BASE_BUILD:-} ]]; then dist=$C/$FINAL_BASE_BUILD/dist; else export MVP_OVERLAY=${FINAL_BASE_OVERLAY:-}; fi
                   run_case "$name" ft "$@") ;;
         ft-mixed) (export BENCH_CONFIG=${FINAL_MIXED_CONFIG:-} TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost; run_case "$name" ft "$@") ;;
         # Online EPLB off with FT on: 256 + 64 ghost slots (the FT layout of that deployment).
         ft-ghost320) (export BENCH_CONFIG=dep32-b2-320.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost; run_case "$name" ft "$@") ;;
         # eplb0 on the base wheel (FINAL_BASE_BUILD): the FT-off check that the final wheel leaves main's path unchanged.
         lay-eplb0-base) (dist=$C/${FINAL_BASE_BUILD:?}/dist; export BENCH_CONFIG=dep32-eplb0.yaml; run_case "$name" noft "$@") ;;
         noft-ulfm) run_case "$name" noft-ulfm "$@" ;;
         noft-ulfm-nodet) (export WIDEEP_NO_DETECTOR=1; run_case "$name" noft-ulfm "$@") ;;
         ft) run_case "$name" ft "$@" ;;
         ft-no*) (export TLLM_TEST_FT_OFF=$(ft_off_pieces "$arm"); run_case "$name" ft "$@") ;;
         lay-eplb0) (export BENCH_CONFIG=dep32-eplb0.yaml; run_case "$name" noft "$@") ;;
         lay-ghost320) (export BENCH_CONFIG=dep32-b2-320.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
                        run_case "$name" noft "$@") ;;
         lay-lb256) (export BENCH_CONFIG=dep32-lb256.yaml; run_case "$name" noft "$@") ;;
         lay-ghost320-etac) (export BENCH_CONFIG=dep32-b2-320.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
                        run_case "$name" noft "$@") ;;
         lay-ghost288) (export BENCH_CONFIG=dep32-b2-288.yaml TLLM_TEST_EMPTY_EXTRA_SLOTS=1 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
                        run_case "$name" noft "$@") ;;
         esac)
        case_index=$((case_index + 1))
    }
    left_min() { local end=${SLURM_JOB_END_TIME:-$(( $(date +%s) - SECONDS + 7200 ))}; echo $(( (end - $(date +%s)) / 60 )); }
    node0_decides() {  # FILE COMMAND...: node 0 runs COMMAND and writes its status to FILE; every node returns it
        if [[ $SLURM_NODEID == 0 ]]; then
            if "${@:2}"; then echo 1 > "$1.tmp"; else echo 0 > "$1.tmp"; fi
            mv "$1.tmp" "$1"
        fi
        for _ in $(seq 600); do [[ -s $1 ]] && break; sleep 1; done
        [[ $(cat "$1" 2>/dev/null) == 1 ]]
    }
    # Tuning pass (or the seed): produces pinned.json.
    smoke=1
    # AUTO (user: final comparisons also with auto-tuned arms, like real launches): no pinning; each arm tunes its own
    # cache in its first case and reuses it (own per-rank tactic draw, as a real launch).
    if [[ $job == *-AUTO ]]; then
        echo "FT_COST_AUTO: no tuning pass, no pinning"
    elif [[ -n "${FT_COST_E2E_SEED:-}" ]]; then
        echo "FT_COST_E2E_SEED $FT_COST_E2E_SEED"
        seed_ok() { [[ -s $FT_COST_E2E_SEED ]] && cp "$FT_COST_E2E_SEED" "$pinned.tmp" && mv "$pinned.tmp" "$pinned" || return 1
            # GHOST-TAC: the -etac arm reads the seed with eplb0's tactics on the ghost layout's keys.
            [[ $job != GHOST-TAC* ]] || { python3 $H/draft_cases/transplant_tactics.py "$pinned" "$tuner/pinned-etac.tmp" \
                > "$out/transplant.txt" 2>&1 && mv "$tuner/pinned-etac.tmp" "$tuner/pinned-etac.json"; }; }
        node0_decides "$tuner/pinned.go" seed_ok || { echo "SMOKE_FAIL seed $FT_COST_E2E_SEED"; echo STD_DONE; exit 1; }
    else
        # Tune every arm once (the arms' layouts may differ, e.g. C-COMBINE4-PIN), then merge and pin.
        tune_load=8; [[ $job == C-COMBINE4-PIN || $job == GHOST-COST* ]] && tune_load=128
        for a in ${tune_arms:-$arms}; do
            arm_case tune-$a $a "$tuner/tune-$a.json" --mode sweep --loads $tune_load --iterations 1 --isl 1024 --osl 1024
            require_done tune-$a
        done
        # PIN_TRANSPLANT="SRC_SLOTS,SRC_LOCAL DST_SLOTS,DST_LOCAL": every arm runs the base layout's tactics (one table
        # in effect): the FT layout's MoE entries take the tactic the base layout picked for the nearest shape.
        merge() { python3 $H/draft_cases/merge_pin_tactics.py merge "$pinned.tmp" $(for a in ${tune_arms:-$arms}; do echo "$tuner/tune-$a.json"; done) \
            > "$out/merge_pin.txt" 2>&1 && { [[ -z ${PIN_TRANSPLANT:-} ]] || python3 $H/draft_cases/transplant_tactics.py \
            "$pinned.tmp" "$pinned.tmp" $PIN_TRANSPLANT >> "$out/merge_pin.txt" 2>&1; } && mv "$pinned.tmp" "$pinned"; }
        node0_decides "$tuner/pinned.go" merge || { echo "SMOKE_FAIL merge (merge_pin.txt)"; echo STD_DONE; exit 1; }
        smoke=0
        [[ $SLURM_NODEID == 0 ]] && cat "$out/merge_pin.txt"
    fi
    # Measured rounds: the first round's order is shuffled (seed = job id), later rounds rotate it, so with two
    # arms each one runs first in every other round.
    read -ra first <<< "$(printf '%s\n' $arms | shuf --random-source=<(yes "$SLURM_JOB_ID$job") | tr '\n' ' ')"
    for r in $(seq "${FT_COST_E2E_ROUNDS:-6}"); do
        room() { (( $(left_min) >= ${FT_COST_E2E_ROUND_MIN:-$(( 16 * ${#first[@]} ))} )); }
        node0_decides "$out/round-$r.go" room || { echo "FT_COST_E2E_STOP before round $r ($(left_min) min left)"; break; }
        order=$(for i in "${!first[@]}"; do echo "${first[(i + r - 1) % ${#first[@]}]}"; done | tr '\n' ' ')
        echo "FT_COST_E2E_ROUND $r $order"
        last_round=$r
        for a in $order; do
            cache=$tuner/case-$a-$r.json
            # AUTO: each arm tunes its own cache once (its first case, ~23 min of startup tuning) and reuses it in
            # later rounds, as a real deployment tunes once per launch configuration.
            [[ $job == *-AUTO ]] && { cache=$tuner/auto-$a.json; export CASE_TIMEOUT_S=3600; }
            src=$pinned; [[ $a == *-etac ]] && src=$tuner/pinned-etac.json
            [[ $job != *-AUTO && $SLURM_NODEID == 0 ]] && cp "$src" "$cache.tmp" && mv "$cache.tmp" "$cache"
            arm_case $a-$r $a "$cache" "${load[@]}"
            [[ $smoke == 1 ]] && require_done $a-$r
            smoke=0
            if [[ $SLURM_NODEID == 0 ]]; then
                logs=("$out/$a-$r"/rank-*.log)
                echo "TACTIC_CHECK $a-$r autotune=$(cat "${logs[@]}" 2>/dev/null | grep -c WIDEEP_AUTOTUNE)" \
                    "priming_failed=$(cat "${logs[@]}" 2>/dev/null | grep -c 'Priming cached tactic failed')" \
                    "cache_miss=$(cat "${logs[@]}" 2>/dev/null | grep -c 'using the fallback tactic, due to cache miss')" \
                    "$(python3 $H/draft_cases/merge_pin_tactics.py check "$src" "$cache" 2>&1 | tail -1)" \
                    | tee -a "$out/tactic_check.txt"
            fi
            # BISECT: every case's hook proof; an arm whose first case lacks it ends the job.
            if [[ $job == FT-COST-BISECT && $r == 1 ]]; then
                node0_decides "$out/hook-$a.ok" hook_ok $a-$r $a || { echo "SMOKE_FAIL hook check $a-$r (hook_check.txt)"; echo STD_DONE; exit 1; }
            elif [[ $job == FT-COST-BISECT && $SLURM_NODEID == 0 ]]; then
                hook_ok $a-$r $a || echo "HOOK_CHECK_FAIL $a-$r: exclude it from the analysis"
            fi
        done
    done
    # LADDER: one noft-main case (main's wheel, FT off, the job's pinned table) after the last round, if it fits.
    if [[ $job == LADDER* && ${LADDER_MAIN_TAIL:-1} == 1 ]]; then
        main_room() { (( $(left_min) >= 15 )); }
        if node0_decides "$out/main-tail.go" main_room; then
            [[ $SLURM_NODEID == 0 ]] && cp "$pinned" "$tuner/case-noft-main.tmp" && mv "$tuner/case-noft-main.tmp" "$tuner/case-noft-main.json"
            arm_case noft-main-${last_round:-1} noft-main "$tuner/case-noft-main.json" "${load[@]}"
        else
            echo "LADDER_MAIN_TAIL skipped ($(left_min) min left)"
        fi
    fi
    if [[ $SLURM_NODEID == 0 && -n $ab_pairs ]]; then
        # The final benchmark's jobs: steady step / throughput A/B and the burst rank-sum per named pair.
        python3 $H/burst_counts.py "$out" > "$out/burst_counts.txt" 2>&1
        for pair in $ab_pairs; do
            a=${pair%%:*} b=${pair#*:}
            python3 $H/ab_stats.py "$out" "$a" "$b" > "$out/ab_stats-$a-vs-$b.txt" 2>&1
            python3 $H/draft_cases/burst_ranksum.py "$a" "$b" "$out/burst_counts.txt" > "$out/burst_ranksum-$a-vs-$b.txt" 2>&1
            cat "$out/ab_stats-$a-vs-$b.txt" "$out/burst_ranksum-$a-vs-$b.txt"
        done
        cat "$out/tactic_check.txt" 2>/dev/null
    fi
    if [[ $SLURM_NODEID == 0 ]]; then
        [[ -z $ab_pairs ]] && for b in $arms; do
            [[ $b == ft ]] || python3 $H/ab_stats.py "$out" $b ft > "$out/ab_stats-$b-vs-ft.txt" 2>&1; done
        [[ $arms == *noft-ulfm* ]] && python3 $H/ab_stats.py "$out" noft-stack noft-ulfm > "$out/ab_stats-noft-stack-vs-noft-ulfm.txt" 2>&1
        [[ $job == C-COMBINE4-PIN ]] && { set -- $arms; python3 $H/ab_stats.py "$out" "$1" "$2" > "$out/ab_stats-$1-vs-$2.txt" 2>&1; }
        if [[ $job == GHOST-TAC* ]]; then
            for pair in "lay-eplb0 lay-lb256" "lay-eplb0 lay-ghost320" "lay-eplb0 lay-ghost320-etac" \
                        "lay-ghost320-etac lay-ghost320" "lay-lb256 lay-ghost320-etac"; do
                set -- $pair; python3 $H/ab_stats.py "$out" "$1" "$2" > "$out/ab_stats-$1-vs-$2.txt" 2>&1
            done
            cat "$out/transplant.txt"
        fi
        if [[ $job == FT-COST-BISECT ]]; then
            # Per hook arm at 128/GPU (steady step): FT's cost (noft-ulfm -> ft), what the arm saves (it -> ft), what
            # remains (noft-ulfm -> it), each "cost % [95% CI]"; recovered = saved / FT's cost (decision rules: the .md).
            at128() { awk '/^steady_step_ms/ {s = 1; next} s && $1 == 128 {print $5 " [" $6 "]"; exit}' "$1"; }
            for b in $arms; do
                [[ -n $(ft_off_pieces "$b") ]] || continue
                python3 $H/ab_stats.py "$out" noft-ulfm "$b" > "$out/ab_stats-noft-ulfm-vs-$b.txt" 2>&1
                ft_cost=$(at128 "$out/ab_stats-noft-ulfm-vs-ft.txt"); saved=$(at128 "$out/ab_stats-$b-vs-ft.txt")
                echo "BISECT $b ($(ft_off_pieces "$b")) steady_step 128/GPU: ft_cost=$ft_cost saved=$saved" \
                    "residual=$(at128 "$out/ab_stats-noft-ulfm-vs-$b.txt")" \
                    "recovered=$(awk -v s="${saved%% *}" -v f="${ft_cost%% *}" 'BEGIN { if (f + 0 > 0) printf "%.2f", s / f; else print "n/a" }')" \
                    | tee -a "$out/bisect.txt"
            done
            cat "$out/hook_check.txt"
        fi
        [[ $arms == *noft-ulfm-nodet* ]] && { python3 $H/ab_stats.py "$out" noft-stack noft-ulfm-nodet > "$out/ab_stats-noft-stack-vs-noft-ulfm-nodet.txt" 2>&1
            python3 $H/ab_stats.py "$out" noft-ulfm-nodet noft-ulfm > "$out/ab_stats-noft-ulfm-nodet-vs-noft-ulfm.txt" 2>&1; }
        if [[ -z $ab_pairs ]]; then
            python3 $H/burst_counts.py "$out" > "$out/burst_counts.txt" 2>&1
            python3 $H/draft_cases/burst_ranksum.py noft-stack ft "$out/burst_counts.txt" > "$out/burst_ranksum.txt" 2>&1
            cat "$out/ab_stats-noft-stack-vs-ft.txt" "$out/burst_ranksum.txt"
        fi
        # Deployment per case: the mpirun transport line, whether an authority ran, the a2a dispatch path.
        for d in "$out"/*-[0-9]*/ "$out"/tune-*/; do
            [[ -d $d ]] || continue
            echo "DEPLOY $(basename "$d") $(grep -o 'mca=\[[^]]*\]' "$d/timeline" | head -1)" \
                "authority=$([[ -e $d/authority.log ]] && echo yes || echo no)" \
                "cft_off_driver=$(grep -c 'CFT counted writes disabled: NVIDIA driver' "$d/rank-0.log" 2>/dev/null)"
        done
    fi
    echo STD_DONE
    ;;
DETECTOR-NEG)
    # Negative controls with Open MPI's in-band detector exactly as shipped (task.sh FT default: detector thread,
    # period 1 s, timeout 5 s) and the FT default hang_confirm_s (30): HANG-NEG 8053212 (CLAIMS #77) ran without the
    # detector. Rank 2 frozen (SIGSTOP, then SIGCONT) for 3 / 10 / 45 s; node 1's four ranks host-stalled 45 s (main
    # thread sleeps; native threads run); a 45 s GIL hog on rank 2 at Python's default switch interval. Records per
    # case whether a recovery ran, which ranks were declared failed and by whom (detector vs authority), so the
    # detector timeout is decided from data (DECISIONS). Load 64/GPU on the standard deployment.
    export BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_FAULT_TOLERANCE_HANG_DETECTION=1 WIDEEP_FENCE_COMMAND= TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json
    export TLLM_TEST_STALL_S=45
    mkdir -p "$out/autotuner"
    first=1
    for f in 3 10 45; do
        (export WIDEEP_VICTIM=2
         run_case freeze$f ft --mode failover --load 64 --iterations 3 --kill-window-s 30,45 --kill freeze --freeze-s $f)
        case_index=$((case_index + 1))
        [[ $first == 1 ]] && { require_done freeze$f; first=0; }
    done
    (export TLLM_TEST_KILL_TRIGGER=$out/trigger-host-node1 TLLM_TEST_KILL_RANK=4,5,6,7 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=0
     export TLLM_TEST_HOST_STALL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case host45-node1 ft --mode failover --kill control --load 64 --iterations 3 --kill-window-s 30,45)
    case_index=$((case_index + 1))
    (export TLLM_TEST_KILL_TRIGGER=/tmp/wideep-trigger-$SLURM_JOB_ID-gil TLLM_TEST_KILL_RANK=2 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
     export TLLM_TEST_GIL_HOG_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case gil45-default ft --mode failover --kill control --load 64 --iterations 3 --kill-window-s 30,45)
    case_index=$((case_index + 1))
    [[ $SLURM_NODEID == 0 ]] && grep -H "is hung\|fenc\|stalled\|committed generation\|aborted\|registered;" "$out"/*/authority.log | grep -v "registered (" | sed 's/^.*runs\///' | cut -c1-220 | head -40
    [[ $SLURM_NODEID == 0 ]] && grep -H "watcher_detect\|failed ranks" "$out"/*/rank-0.log | sed 's/^.*runs\///' | cut -c1-200 | head -20
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"\|victim_gone\|recoveries' "$out"/*/result.json | cut -c1-240
    echo STD_DONE
    ;;
esac
case $job in
SHUTDOWN-R1)
    # Clean shutdown (v7 1d.1 bounded teardown; analysis/LAUNCHER_SURVIVAL.md section 5): every other case ends with
    # task.sh SIGTERMing mpirun (rc=1), so the graceful path (frontend exit -> mgmn_leader_node --action stop -> MPI
    # shutdown) was never run. Here task.sh stops the deployment as an orchestrator does: SIGTERM (SHUTDOWN_SIGNAL) to
    # trtllm-serve once the load is done, then mpirun must exit on its own within WIDEEP_GRACEFUL_STOP_S, and no process
    # of the case may be left on any node 15 s later (serve.sh: CASE_LEFTOVER) or on a GPU (NODE_LEFTOVER).
    # 1) ft-clean: FT on, healthy load, stop. Expect mpirun rc 0.
    # 2) ft-loss: FT on, rank 5 SIGKILLed in a decode step under load, survivors resume, load finishes, stop. Expect
    #    mpirun rc 0: rank 0 and the survivors finalize MPI on their own (mpi_session._leave_degraded_world, rank 0
    #    logs "finalizing the MPI world, which lost a rank"), and PRRTE does not count the SIGKILLed rank of a
    #    --with-ft ulfm (recoverable) job. "ending the MPI world" in rank-0.log (MPI_Abort) fails the case.
    # 3) noft-clean: FT off as deployed (plain mpirun, UCX), same load, stop. Expect rc 0 (the control).
    # SHUTDOWN_VERDICT per case on node 0: PASS / FAIL / INVALID (load not done, or no recovery in ft-loss).
    export CASE_TIMEOUT_S=1200 BENCH_CONFIG=dep32-final.yaml TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    export WIDEEP_GRACEFUL_STOP=${SHUTDOWN_SIGNAL:-TERM} WIDEEP_GRACEFUL_STOP_S=${SHUTDOWN_BOUND_S:-120}
    if [[ $dist != *build-next-* && $dist != *build-dev-* && $dist != "$C/$FINAL_BUILD/dist" ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be a next- or dev-build wheel (build-next-fcc86b10b2 or later) or $FINAL_BUILD, got $dist"
        echo STD_DONE; exit 1
    fi
    ms=${MVP_OVERLAY:+$MVP_OVERLAY/tensorrt_llm/llmapi/mpi_session.py}
    if ! { [[ -n $ms && -f $ms ]] && grep -q _leave_degraded_world "$ms"; } &&
        ! unzip -p "$dist"/tensorrt_llm-*.whl tensorrt_llm/llmapi/mpi_session.py 2>/dev/null | grep -q _leave_degraded_world; then
        echo "SMOKE_FAIL preflight: ft-loss expects rc 0, so MVP_OVERLAY or the wheel must carry fold-exit0 (_leave_degraded_world)"
        echo STD_DONE; exit 1
    fi
    mkdir -p "$out/autotuner"
    shutdown_verdict() {  # NAME EXPECT (clean|loss): node 0 judges the case's teardown from its timeline and logs
        [[ $SLURM_NODEID == 0 ]] || return 0
        local t=$out/$1/timeline
        for _ in $(seq 180); do (( $(grep -c '^NODE_CLEAN ' "$t" 2>/dev/null) >= SLURM_NNODES )) && break; sleep 1; done
        python3 - "$out/$1" "$2" "$SLURM_NNODES" "$WIDEEP_GRACEFUL_STOP_S" <<'PY' | tee "$out/$1/shutdown_verdict.txt"
import json, re, sys
from pathlib import Path
run, expect, nnodes, bound = Path(sys.argv[1]), sys.argv[2], int(sys.argv[3]), float(sys.argv[4])
lines = (run / "timeline").read_text(errors="replace").splitlines() if (run / "timeline").exists() else []
first = lambda tag: next((l.split() for l in lines if l.startswith(tag + " ")), None)
count = lambda tag: sum(l.startswith(tag + " ") for l in lines)
try:
    result = json.loads((run / "result.json").read_text())
except (OSError, ValueError):
    result = {}
rank0 = (run / "rank-0.log").read_text(errors="replace") if (run / "rank-0.log").exists() else ""
stop, end = first("GRACEFUL_STOP"), first("MPIRUN_EXIT")
rc = int(end[2].split("=")[1]) if end else None
elapsed = float(end[1]) - float(stop[1]) if stop and end else None
codes = {k: re.findall(rf"{k} exit code: (-?\d+)", rank0)
         for k in ("Task", "MPI Comm server", "MGMN leader node", "Subshell")}
abort_line = "ending the MPI world" in rank0
finalize_line = "finalizing the MPI world, which lost a rank" in rank0
facts = dict(state=result.get("state"), resumed="all_resumed_seen_wall_s" in result, stop_sent=bool(stop),
             stop_pids=" ".join(stop[3:]) if stop else None, mpirun_rc=rc, elapsed_s=elapsed,
             timeout=count("GRACEFUL_TIMEOUT"), no_frontend=count("GRACEFUL_NO_FRONTEND"),
             case_leftover=count("CASE_LEFTOVER"), case_clean_nodes=count("CASE_NO_LEFTOVER"),
             gpu_leftover=count("NODE_LEFTOVER"), node_clean=count("NODE_CLEAN"), abort_line=abort_line,
             finalize_line=finalize_line,
             rank0_exit_codes=codes)
problems = []
if facts["state"] != "DONE" or (expect == "loss" and not facts["resumed"]):
    verdict = "INVALID"
    problems.append("load not DONE" if facts["state"] != "DONE" else "no recovery before the stop")
else:
    if not stop or stop[3] == "pids=[]" or facts["no_frontend"]:
        problems.append("no trtllm-serve to signal")
    if facts["timeout"] or rc is None or elapsed is None or elapsed > bound:
        problems.append(f"mpirun did not exit within {bound:.0f} s of the stop")
    if rc != 0:
        problems.append(f"rc {rc}, expected 0")
    if expect == "loss" and (abort_line or not finalize_line):
        problems.append(f"abort line {abort_line} / finalize line {finalize_line}: expected the survivors to finalize")
    if facts["case_leftover"] or facts["case_clean_nodes"] < nnodes:
        problems.append(f"leftovers: {facts['case_leftover']} nodes with case processes, "
                        f"{facts['case_clean_nodes']}/{nnodes} reported clean")
    if facts["gpu_leftover"]:
        problems.append(f"{facts['gpu_leftover']} nodes with a GPU process left")
    verdict = "FAIL" if problems else "PASS"
print(f"SHUTDOWN_VERDICT {run.name} {verdict} expect={expect} " + "; ".join(problems))
print("SHUTDOWN_FACTS " + json.dumps(facts))
for l in lines:
    if l.startswith(("GRACEFUL_", "MPIRUN_EXIT", "CASE_LEFTOVER", "NODE_LEFTOVER", "RANK_EXIT")):
        print("  " + l[:300])
PY
    }
    (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json
     run_case ft-clean ft --mode sweep --loads 64 --iterations 2 --isl 1024 --osl 1024)
    case_index=$((case_index + 1))
    shutdown_verdict ft-clean clean
    require_done ft-clean
    (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json
     export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-rank5
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case ft-loss ft --mode failover --load 64 --iterations 2 --kill-window-s 20,30 --kill decode)
    case_index=$((case_index + 1))
    shutdown_verdict ft-loss loss
    (export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/noft.json
     run_case noft-clean noft --mode sweep --loads 64 --iterations 2 --isl 1024 --osl 1024)
    case_index=$((case_index + 1))
    shutdown_verdict noft-clean clean
    [[ $SLURM_NODEID == 0 ]] && grep -h '^SHUTDOWN_VERDICT' "$out"/*/shutdown_verdict.txt
    echo STD_DONE
    ;;
esac
case $job in
KILL-MATRIX|KILL-MATRIX-B)
    # Correctness on the final build (FINAL_BENCHMARK_PLAN K1/K2), composed from existing case blocks: each piece is
    # `bash $H/job.sh LABEL` on this job's private harness copy with JOB_PARENT_OUT (results in $out/LABEL/),
    # JOB_CASES (the block's cases to run; require_done passes the skipped ones) and its own environment (a piece's
    # exports cannot leak into the next). A piece starts only if node 0 sees its budget left; a piece's SMOKE_FAIL
    # ends that piece only. Budgets from KILL-MTP-R1-8059722, TWOKILL-R1B-8062252, HANG-SET-C30-8063189,
    # DETECTOR-NEG-8061184 (case-to-case ~10.5-13 min, ~17 min for a 45 s host stall, first start ~12 min).
    # K1 KILL-MATRIX (~109 min): KILL-MTP-R1 all 6 cases (exact tokens x3 on the small MTP+overlap config, rank 5
    #   decode / rank 2 prefill / node 1 decode at 128 on dep32-final) 58 min; SHUTDOWN-R1 ft-clean + ft-loss (rc 0
    #   also after a recovery, survivors finalize, no leftovers; its fold-exit0 preflight) 26 min; TWOKILL-R1B
    #   (quarantine, node 1 then rank 9 = second loss) 25 min.
    # K2 KILL-MATRIX-B (~111 min): KILL-FEATURES (new: ring host copies rank/node kill, mixed EPLB+ghost rank/node kill,
    #   phase-B streaming continuation) 65 min; HANG-SET-C30 stop-c30 (SIGSTOP must fence) + gil45-default-c30 (must
    #   not fence) 27 min; DETECTOR-NEG host45-node1 (must not fence, detector as shipped) 19 min, if room.
    #   The SIGSTOP case is the job's only hang-prone case (RETRO 2026-10-17); it runs after the feature kills.
    # Deviation from the plan table: the SIGSTOP / host / GIL controls moved from K1 to K2 (K1 with them is ~150 min).
    if [[ $dist != "$C/$FINAL_BUILD/dist" || -n "${MVP_OVERLAY:-}" ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be $FINAL_BUILD without MVP_OVERLAY ($dist, overlay '${MVP_OVERLAY:-}')"
        echo STD_DONE; exit 1
    fi
    km_left_min() { local end=${SLURM_JOB_END_TIME:-$(( $(date +%s) - SECONDS + 7200 ))}; echo $(( (end - $(date +%s)) / 60 )); }
    km_n=0
    piece() {  # LABEL MINUTES "CASES" [VAR=VALUE...]: one existing case block as a piece, if node 0 sees MINUTES left
        local label=$1 need=$2 cases=$3 go; shift 3
        km_n=$((km_n + 1)); go=$out/piece-$km_n-$label.go
        if [[ $SLURM_NODEID == 0 ]]; then
            if (( $(km_left_min) >= need )); then echo 1 > "$go.tmp"; else echo 0 > "$go.tmp"; fi
            mv "$go.tmp" "$go"
        fi
        for _ in $(seq 600); do [[ -s $go ]] && break; sleep 1; done
        if [[ $(cat "$go" 2>/dev/null) != 1 ]]; then echo "KILL_MATRIX_SKIP $label ($(km_left_min) min left, needs $need)"; return 0; fi
        echo "KILL_MATRIX_PIECE $label start $(date +%T) cases='$cases' env='$*'"
        # STD_DONE / SMOKE_FAIL of a piece are renamed: job watchers end on those markers.
        env JOB_PARENT_OUT="$out" JOB_CASES="$cases" JOB_CASE_INDEX_BASE=$((km_n * 20)) "$@" bash "$H/job.sh" "$label" 2>&1 \
            | sed -u "s/^STD_DONE\$/PIECE_DONE $label/; s/^SMOKE_FAIL/PIECE_SMOKE_FAIL $label:/"
        echo "KILL_MATRIX_PIECE $label end $(date +%T)"
    }
    if [[ $job == KILL-MATRIX ]]; then
        piece KILL-MTP-R1 58 "mtp-tokens-ref mtp-tokens-inflight-1 mtp-tokens-inflight-2 mtp-decode-rank5 mtp-prefill-rank2 mtp-node1-decode"
        piece SHUTDOWN-R1 26 "ft-clean ft-loss"
        piece TWOKILL-R1B 25 "twokill-rerun-quarantine twokill-node1-rank9"
    else
        piece KILL-FEATURES 65 "ring-rank5-decode ring-node1-decode mixed-rank5-decode mixed-node1-decode phaseb-stream-rank5"
        piece HANG-SET-C30 27 "stop-c30 gil45-default-c30"
        piece DETECTOR-NEG 19 "host45-node1"
    fi
    if [[ $SLURM_NODEID == 0 ]]; then
        # RERUN_VERDICT (KILL-MTP-R1) is in the job log only; the other verdicts are also in files.
        grep -rh --include='*.txt' --include='watch-*.log' 'SHUTDOWN_VERDICT\|TWOKILL_VERDICT\|KILL_FEATURES_' "$out" 2>/dev/null | cut -c1-300
        grep -H '"state"' "$out"/*/*/result.json 2>/dev/null | sed 's/^.*runs\///' | cut -c1-200
        ls "$out"/*/*.skipped 2>/dev/null | sed 's/^.*runs\//SKIPPED /'
    fi
    echo STD_DONE
    ;;
KILL-FEATURES)
    # K2's new features end to end (run as a KILL-MATRIX-B piece; standalone too). TODO STUBS: every launch knob below is
    # a placeholder until its feature lands; the preflight refuses to run while one is unset. 128/GPU, rank kills of
    # rank 5 (node 1) and node kills of node 1 (ranks 4-7) in a decode step, FT on, ~12.5 min per case.
    # Expectations (PASS needs all; numbers are recorded, not gated, unless stated):
    # 1) ring-rank5-decode (SHARDED_HOST_COPIES.md; static 320, ghost slots, ring host copies): state DONE; 31 ranks
    #    resume; rank 5's experts restored from node 0 (node i's copies live on node i-1), sources round-robin over
    #    node 0's 4 GPUs, staged through the target's a2a workspace (no fabric map at recovery); /dev/shm per node
    #    holds only the next node's experts (~46 GB vs ~368 GB full, ESTIMATE: record); restore copy ms recorded.
    # 2) ring-node1-decode: the same with WIDEEP_FAILURE_DOMAIN=node; 28 ranks resume; all of node 1's experts from
    #    node 0; every restored slot published only at commit.
    # 3) mixed-rank5-decode (MIXED_EPLB_GHOST.md; online EPLB 288 + 32 ghost): state DONE; no ghost slot mapped (a
    #    rank loss fits the EPLB slots: 9 x 31 = 279 >= 256); restore prefers replica slots (~20 ms class, CLAIMS #1/#72);
    #    online EPLB updates continue after "resumed serving".
    # 4) mixed-node1-decode: ghost slots mapped (9 x 28 = 252 < 256), only where replicas cannot cover; EPLB keeps
    #    updating after the resume and never places a replica in an unbacked ghost slot (no error, no SIGBUS).
    # 5) phaseb-stream-rank5 (READMISSION.md phase B; tokens oracle as KILL-MTP-R1's in-flight cases): a streaming
    #    request on rank 5 killed after its first tokens continues on a survivor: delivered prefix + continuation equal
    #    the healthy reference (greedy; exactness informative if the batch differs), no duplicated or missing token at
    #    the seam, one continuation logged on rank 0, survivors' outputs exact.
    # All: no WIDEEP_CAPTURE / WIDEEP_COMPILE / WIDEEP_AUTOTUNE after "resumed serving" (v7 invariant 3).
    export CASE_TIMEOUT_S=1200 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=1
    export TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    mkdir -p "$out/autotuner"
    todo=""
    # TODO(ring host copies): the launch knob, e.g. FINAL_RING_ENV="TLLM_FAULT_TOLERANCE_HOST_COPIES=ring".
    [[ -n ${FINAL_RING_ENV:-} ]] || todo+=" FINAL_RING_ENV"
    # TODO(mixed EPLB+ghost): the yaml in configs/ (owner decision 13 sets the config form).
    [[ -s $H/configs/${FINAL_MIXED_CONFIG:-none} ]] || todo+=" FINAL_MIXED_CONFIG"
    # TODO(phase B): tokens/frontend.py streaming-continuation mode and its result fields, e.g. "--stream".
    [[ -n ${PHASEB_TOKENS_ARGS:-} ]] || todo+=" PHASEB_TOKENS_ARGS"
    if [[ -n $todo ]]; then echo "SMOKE_FAIL preflight: TODO stubs unset:$todo"; echo STD_DONE; exit 1; fi
    load=(--mode failover --load 128 --iterations 2 --kill-window-s 30,45 --kill decode)
    feature_kill() {  # NAME rank|node: one decode kill of rank 5 or node 1 (environment set by the caller)
        local name=$1 trigger=$out/trigger-$1
        (export TLLM_TEST_KILL_TRIGGER=$trigger TLLM_TEST_KILL_IN_DECODE=$trigger
         if [[ $2 == node ]]; then export WIDEEP_FAILURE_DOMAIN=node WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7
         else export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5; fi
         run_case "$name" ft "${load[@]}")
        case_index=$((case_index + 1))
    }
    (export BENCH_CONFIG=dep32-b2-320.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ring.json
     # shellcheck disable=SC2086
     export $FINAL_RING_ENV
     feature_kill ring-rank5-decode rank
     feature_kill ring-node1-decode node)
    case_index=$((case_index + 2))
    # No smoke gate here: one feature failing does not predict the others; KILL-MATRIX-B's piece budget bounds it.
    (export BENCH_CONFIG=$FINAL_MIXED_CONFIG TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/mixed.json
     feature_kill mixed-rank5-decode rank
     feature_kill mixed-node1-decode node)
    case_index=$((case_index + 2))
    trigger=/tmp/wideep-kill-$SLURM_JOB_ID-phaseb
    (export TOKENS_CONFIG=config-small-mtp-overlap.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty TLLM_TEST_ORACLE_EXCLUDE_RANK=2
     unset TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS
     export TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_IN_DECODE=$trigger TLLM_TEST_KILL_WHEN_BUSY=1
     export TOKENS_ARGS="--inflight-after 1 --max-tokens 400 --no-probe --trigger $trigger $PHASEB_TOKENS_ARGS"
     run_case phaseb-stream-rank5 ft)
    case_index=$((case_index + 1))
    if [[ $SLURM_NODEID == 0 ]]; then
        # TODO(verdicts): per-case PASS/FAIL lines once the features' log lines exist (ring source node, ghost map count,
        # EPLB update after resume, phase-B continuation); until then the facts below are judged by hand.
        for d in "$out"/*/; do
            [[ -s $d/result.json ]] || continue
            n=$(basename "$d")
            echo "KILL_FEATURES_FACTS $n state=$(grep -o '"state": "[^"]*"' "$d/result.json" | head -1)" \
                "resumed=$(grep -c 'resumed serving without' "$d/rank-0.log" 2>/dev/null)" \
                "restored='$(grep -o 'Restored .* expert slots[^,]*' "$d/rank-0.log" 2>/dev/null | head -1 | cut -c1-120)'" \
                "eplb_after_resume=$(awk '/resumed serving without/ {r = 1} r && /EPLB weight updates/ {n++} END {print n + 0}' "$d/rank-0.log" 2>/dev/null)" \
                "after_resume_capture=$(awk '/resumed serving without/ {r = 1} r && /WIDEEP_(CAPTURE|COMPILE|AUTOTUNE)/ {n++} END {print n + 0}' "$d/rank-0.log" 2>/dev/null)" \
                | tee -a "$out/kill_features.txt"
        done
    fi
    echo STD_DONE
    ;;
KILL-FINAL-ON|KILL-FINAL-ON-A|KILL-FINAL-ON-B|KILL-FINAL-OFF|KILL-FINAL-OFF-A|KILL-FINAL-OFF-B)
    # The final kill matrix on FINAL_BUILD: FT on, failure_domain node, R1 NVFP4 DEP32, n=3 per cell.
    # Columns: ON = online EPLB (dep32-final.yaml; the wheel appends 32 ghost slots: 288 + 32);
    #          OFF = static dep32-b2-320.yaml (256 + 64 ghost slots, TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost).
    # Rows (case recipes as in KILL-MTP-R1, TWOKILL-R1 and HANG-SET-C30):
    #   rank5  rank 5 SIGKILLed in a decode step at 128/GPU (mtp-decode-rank5)
    #   node1  ranks 4-7 SIGKILLed in a decode step, hosts alive, at 128/GPU (mtp-node1-decode)
    #   twokill rank 5, then rank 9 once the first recovery committed, at 128/GPU (twokill-rank5-rank9, ft_watch.py)
    #   stop   rank 2 SIGSTOPped at 64/GPU, hang detection on, hang_confirm_s 30 (stop-c30)
    # -A = rows rank5 + node1, -B = rows twokill + stop (6 cases each, ~70-80 min); without a suffix all 12 cases
    # (> 2 h: the time guard drops the tail). A case starts only if node 0 sees >= 15 min left.
    # The kill / stop lands 60-70 s into the load (KF_KILL_WINDOW; the source cases: 30-45 s): a wave prefills for
    # ~40-65 s, so the later window lands in steady decode and leaves a before-kill decode rate to compare.
    # Per case: KILL_FINAL_VERDICT (kill -> serving again, failed / re-run requests, rank-0 throughput before and
    # after, PASS/FAIL), also in $out/kill_final.txt; a summary on node 0 at the end.
    if [[ $dist != "$C/$FINAL_BUILD/dist" || -n "${MVP_OVERLAY:-}" ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be $FINAL_BUILD without MVP_OVERLAY ($dist, overlay '${MVP_OVERLAY:-}')"
        echo STD_DONE; exit 1
    fi
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1 WIDEEP_FAILURE_DOMAIN=node
    export TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=${KF_FORCE_ACCEPTED:-1}
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/ft.json
    mkdir -p "$out/autotuner"
    if [[ $job == KILL-FINAL-ON* ]]; then
        export BENCH_CONFIG=dep32-final.yaml; unset TLLM_FAULT_TOLERANCE_EXTRA_SLOTS
    else
        export BENCH_CONFIG=dep32-b2-320.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=ghost
    fi
    touch "$out/kill_final.txt"
    rows="rank5 node1 twokill stop"; [[ $job == *-A ]] && rows="rank5 node1"; [[ $job == *-B ]] && rows="twokill stop"
    reps=${KF_REPEATS:-3}
    kf_left_min() { local end=${SLURM_JOB_END_TIME:-$(( $(date +%s) - SECONDS + 7200 ))}; echo $(( (end - $(date +%s)) / 60 )); }
    kf_go() {  # NAME: node 0 decides (>= 15 min left) and every node follows
        local go=$out/$1.go
        if [[ $SLURM_NODEID == 0 ]]; then
            if (( $(kf_left_min) >= 15 )); then echo 1 > "$go.tmp"; else echo 0 > "$go.tmp"; fi
            mv "$go.tmp" "$go"
        fi
        for _ in $(seq 600); do [[ -s $go ]] && break; sleep 1; done
        [[ $(cat "$go" 2>/dev/null) == 1 ]] && return 0
        echo "KILL_FINAL_SKIP $1 ($(kf_left_min) min left, needs 15)"; return 1
    }
    kf_verdict() {  # NAME ROW: one KILL_FINAL_VERDICT line (node 0)
        python3 - "$out/$1" "$2" <<'PY' | tee -a "$out/kill_final.txt"
import json, re, statistics, sys, time
from pathlib import Path
run, row = Path(sys.argv[1]), sys.argv[2]
expect = {"rank5": [5], "node1": [4, 5, 6, 7], "twokill": [5, 9], "stop": [2]}[row]
def load(p):
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return {}
r, w = load(run / "result.json"), load(run / "verdict.json")
log = (run / "rank-0.log").read_text(errors="replace") if (run / "rank-0.log").exists() else ""
stamp = lambda line: time.mktime(time.strptime(line[1:20], "%m/%d/%Y-%H:%M:%S"))
ft = w.get("fault_tolerance_last") or (r.get("fault_tolerance_status") or {}).get("fault_tolerance") or {}
load_row = next((x for x in r.get("rows", []) if x.get("label") == "load"), {})
load_per_gpu = load_row.get("load_per_gpu") or (64 if row == "stop" else 128)
t0 = r.get("kill_wall_s") or r.get("trigger_wall_s")
# The victim acts on the trigger only at its next decode step with requests (testhooks), which can be seconds later
# during prefill: recovery is timed from the victim's own WIDEEP_SELF_KILL/STALL line when it logged one.
first_loss = {"twokill": [5]}.get(row, expect)
acts = [float(m.group(1)) for rank in first_loss if (run / f"rank-{rank}.log").exists()
        for m in re.finditer(r"WIDEEP_SELF_(?:KILL|STALL) rank \d+ t=([0-9.]+)",
                             (run / f"rank-{rank}.log").read_text(errors="replace"))]
trigger_to_kill_s = round(min(acts) - t0, 2) if acts and t0 else None
if acts:
    t0 = min(acts)
resumes = [l for l in log.splitlines() if "resumed serving without" in l]
# Rank 0's resumed line: "re-ran N requests and failed F" (F: lost-rank requests that streamed, and requests a second
# loss interrupted without progress); older wheels logged "Running N requests of the lost ranks again".
reruns = sum(int(m.group(1)) for m in re.finditer(r"(?:re-ran|Running) (\d+) requests", log))
recovery_failed = sum(int(m.group(1)) for m in re.finditer(r"re-ran \d+ requests and failed (\d+)", log))
# Rank 0's decode rate (print_iter_log): median generated tokens / host step time over full decode-only steps (no
# context request, >= half the per-GPU load scheduled) of the load before the kill and from 5 s after the last resume
# to the load's end; x live ranks = a deployment estimate. A load wave prefills for ~50-60 s before such steps.
iters = []
for l in log.splitlines():
    if "iter = " in l and (m := re.search(r"num_scheduled_requests = (\d+).*host_step_time = ([0-9.]+)ms.*"
                                        r"'num_ctx_requests': (\d+).*'num_generation_tokens': (\d+)", l)):
        if m.group(3) == "0" and int(m.group(1)) >= load_per_gpu / 2:
            iters.append((stamp(l), int(m.group(4)) / float(m.group(2)) * 1e3))
def rate(steps):
    return (round(statistics.median(v for _, v in steps)) if len(steps) >= 20 else None), len(steps)
start = load_row.get("start_wall_s") or 0
end = start + (load_row.get("elapsed_s") or 0)
(before, before_n) = rate([x for x in iters if t0 and start <= x[0] < t0])
(after, after_n) = rate([x for x in iters if resumes and stamp(resumes[-1]) + 5 <= x[0] <= end])
live = 32 - len(expect)
fields = dict(
    state=r.get("state"),
    resume_s=round(r["all_resumed_seen_wall_s"] - t0, 2) if t0 and r.get("all_resumed_seen_wall_s") else None,
    resume2_s=round(w["generation2_seen_wall_s"] - w["second_trigger_wall_s"], 2)
    if w.get("generation2_seen_wall_s") and w.get("second_trigger_wall_s") else None,
    r0_interrupt_ms=",".join(m.group(1) for l in resumes if (m := re.search(r"(\d+) ms after the interruption", l))),
    probe_ttft_s=round(r["first_token_after_kill_s"], 2) if r.get("first_token_after_kill_s") else None,
    failed_ranks=",".join(map(str, sorted(ft.get("failed_ranks", [])))), lost_held=ft.get("failed_requests"), reruns=reruns,
    recovery_failed=recovery_failed, client_failed=load_row.get("failed_requests"), client_short=load_row.get("short_requests"),
    completed=load_row.get("completed"),
    load_tok_s=round(load_row["output_throughput"]) if load_row.get("output_throughput") else None,
    r0_tok_s_before=before, r0_tok_s_after=after, r0_steps=f"{before_n}/{after_n}",
    est_tok_s_before=before and before * 32, est_tok_s_after=after and after * live,
    after_resume_ccat=sum(1 for l in log.split("resumed serving without", 1)[1:2] for _ in
                          re.finditer(r"WIDEEP_(CAPTURE|COMPILE|AUTOTUNE)", l)),
    slots=",".join(sorted(set(re.findall(r"num_slots = (\d+)", log)))),
    trigger_to_kill_s=trigger_to_kill_s,
)
# Phase lines (rank 0): "WideEP recovery gen=G phase=P t=<epoch s>". Recovery time = victim's kill (same origin as
# COLD-RESTART) -> gen-1 first_step; phases as seconds from the kill.
phases = {}
for m in re.finditer(r"WideEP recovery gen=(\d+) phase=(\w+) t=([0-9.]+)", log):
    phases.setdefault((int(m.group(1)), m.group(2)), float(m.group(3)))
fields["recovery_s"] = round(phases[(1, "first_step")] - t0, 2) if t0 and (1, "first_step") in phases else None
fields["phases1"] = ",".join(f"{p}={phases[(1, p)] - t0:.2f}" for p in ("detect", "stopped", "proposed", "ready",
    "install", "installed", "committed", "resumed", "first_step") if t0 and (1, p) in phases) or None
if row == "twokill":
    fields["phases2"] = ",".join(f"{p}={phases[(2, p)] - phases[(2, 'detect')]:.2f}" for p in ("stopped", "proposed",
        "ready", "install", "installed", "committed", "resumed", "first_step")
        if (2, p) in phases and (2, "detect") in phases) or None
checks = dict(served_again=fields["state"] == "DONE" and bool(resumes),
              lost_expected=fields["failed_ranks"] == ",".join(map(str, expect)),
              # Streams the server ends with an error reach the client as short requests.
              no_survivor_failed=fields["client_failed"] is not None
              and fields["client_failed"] + (fields["client_short"] or 0)
              <= max(fields["lost_held"] or 0, fields["recovery_failed"]),
              # The measured build's log does not split F by owner: bound it by what the lost ranks held in flight.
              # Clients spread load_per_gpu x 32 requests over the live ranks, so each later loss holds more.
              recovery_failed_bounded=fields["recovery_failed"] <= sum(
                  -(-load_per_gpu * 32 // (32 - lost_before)) * len(event)
                  for lost_before, event in ((0, expect),) if row != "twokill") + (
                  load_per_gpu + -(-load_per_gpu * 32 // 31) if row == "twokill" else 0),
              no_capture_after_resume=fields["after_resume_ccat"] == 0)
if row == "twokill":
    checks["ft_watch"] = w.get("verdict") == "PASS"
bad = [k for k, v in checks.items() if not v]
print("KILL_FINAL_VERDICT", run.name, "PASS" if not bad else "FAIL", *(f"{k}={v}" for k, v in fields.items()),
      *([f"failed_checks={','.join(bad)}"] if bad else []), sep=" ")
PY
    }
    kf_case() {  # ROW REP: one case of the matrix
        local row=$1 rep=$2 name=$1-$2 watch="" left
        kf_go "$name" || return 0
        left=$(kf_left_min)
        export CASE_TIMEOUT_S=$(( left * 60 - 180 < 1500 ? left * 60 - 180 : 1500 ))
        local window=${KF_KILL_WINDOW:-60,70}
        local load=(--mode failover --load 128 --iterations 2 --kill-window-s "$window" --kill decode)
        (case $row in
         rank5) export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name
                export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
                run_case "$name" ft "${load[@]}" ;;
         node1) export WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name
                export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
                run_case "$name" ft "${load[@]}" ;;
         twokill) export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name-rank5
                export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER TLLM_TEST_KILL_TRIGGER_FOR=9=$out/trigger-$name-rank9
                if [[ $SLURM_NODEID == 0 ]]; then
                    python3 "$H/draft_cases/ft_watch.py" twokill --run "$out/$name" --first-count 31 --final-count 30 \
                        --expect-failed 5,9 --second-trigger "$out/trigger-$name-rank9" > "$out/watch-$name.log" 2>&1 &
                    watch=$!
                fi
                run_case "$name" ft --mode failover --load 128 --iterations 3 --kill-window-s "$window" --kill decode
                [[ -n $watch ]] && { timeout 300 tail --pid="$watch" -f /dev/null; cat "$out/watch-$name.log"; } ;;
         stop)  export WIDEEP_VICTIM=2 TLLM_FAULT_TOLERANCE_HANG_DETECTION=1 TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=30
                export WIDEEP_FENCE_COMMAND=
                run_case "$name" ft --mode failover --load 64 --iterations 3 --kill-window-s "$window" --kill stop ;;
         esac)
        case_index=$((case_index + 1))
        for _ in $(seq 60); do [[ -s $out/$name/result.json ]] && break; sleep 1; done
        [[ $SLURM_NODEID == 0 ]] && kf_verdict "$name" "$row"
        # Fail fast: a deployment that never served ends the job (no idle GPUs on a broken wheel or config).
        if (( case_index == ${JOB_CASE_INDEX_BASE:-0} + 1 )) && ! grep -q '"ready_s"' "$out/$name/result.json" 2>/dev/null; then
            echo "SMOKE_FAIL $name: the server never became ready"; echo STD_DONE; exit 1
        fi
    }
    for row in $rows; do
        for rep in $(seq "$reps"); do kf_case "$row" "$rep"; done
    done
    if [[ $SLURM_NODEID == 0 ]]; then
        echo "KILL_FINAL_SUMMARY $job $BENCH_CONFIG extra_slots=${TLLM_FAULT_TOLERANCE_EXTRA_SLOTS:-auto}:" \
            "$(grep -c ' PASS ' "$out/kill_final.txt" 2>/dev/null) PASS, $(grep -c ' FAIL ' "$out/kill_final.txt" 2>/dev/null) FAIL," \
            "$(ls "$out"/*.go 2>/dev/null | xargs -r grep -l '^0' | wc -l) skipped"
        for row in $rows; do
            python3 - "$out/kill_final.txt" "$row" <<'PY' | tee -a "$out/kill_final.txt"
import re, statistics, sys
lines = [l for l in open(sys.argv[1]).read().splitlines() if l.startswith(f"KILL_FINAL_VERDICT {sys.argv[2]}-")]
def vals(key):
    return [float(m.group(1)) for l in lines if (m := re.search(rf" {key}=([0-9.]+)", l))]
def med(key):
    v = vals(key)
    return round(statistics.median(v), 2) if v else None
print("KILL_FINAL_ROW", sys.argv[2], f"n={len(lines)}", f"pass={sum(' PASS ' in l for l in lines)}",
      *(f"{k}_median={med(k)}" for k in ("resume_s", "resume2_s", "est_tok_s_before", "est_tok_s_after")),
      *(f"{k}={vals(k)}" for k in ("client_failed", "client_short", "lost_held", "reruns")))
PY
        done
    fi
    echo STD_DONE
    ;;
esac
case $job in
COLD-RESTART|COLD-RESTART-A|COLD-RESTART-B)
    # FT off's answer to a failure: the job aborts and is relaunched cold. Same deployment as the kill matrix's ON
    # column (R1 NVFP4 DEP32, dep32-final.yaml: online EPLB 288, MTP forced acceptance), FT off as deployed (plain
    # mpirun, main's HangDetector at its 300 s default), 1k/1k. Failures (recipes as KILL-FINAL's rows):
    #   rank5  rank 5 SIGKILLed in a decode step at 128/GPU
    #   node1  ranks 4-7 SIGKILLed in a decode step at 128/GPU (hosts alive)
    #   stop   rank 2 SIGSTOPped at 64/GPU (nothing but the HangDetector notices)
    # Chained: each failure case's server is the relaunch after the previous failure (relaunched at once in the same
    # allocation, so scheduler wait is excluded), its first request is timed at ready (--first-token-at-ready), and
    # the last failure is followed by a restart-only case. The page cache is dropped once each server is ready, so
    # every relaunch reads the weights from Lustre (CR_KEEP_PAGE_CACHE=1: warm); the autotuner cache persists across
    # relaunches as main's default cache directory does.
    # Per failure: COLD_RESTART <type> run=<n> (also in $out/cold_restart.txt): detect_s / exit_s from the injection
    # (first error line, HangDetector line, rank exit or mpirun exit; every node's GPUs free); weights_s (model loaded),
    # warmup_s (autotuning done), graphs_s (last CUDA graph captured, final warm-up pass), ready_s (/health) and
    # first_token_s (first request answered) from the relaunch's mpirun start; gap_s = teardown done -> relaunch
    # (harness: GPU-free wait, wheel check, node barrier), excluded from down_s = exit_s + first_token_s.
    # failed_inflight: the load's requests that errored or were cut short (failed_unsent: refused connections).
    # Order: -A = rank5 x3, node1, stop (~75 min); -B = node1 x2, stop x2 (~68 min): n = 3 per type over both jobs.
    # Budget from KILL-MTP-R1-8059722 / HANG-SET-C30-8063189 / LADDER-8079803 (ready 415-590 s): failure case ~10.5
    # min (stop ~15.5 with the 300 s HangDetector), restart-only ~9 min. CR_RUNS overrides the order.
    if [[ $dist != "$C/$FINAL_BUILD/dist" || -n "${MVP_OVERLAY:-}" ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be $FINAL_BUILD without MVP_OVERLAY ($dist, overlay '${MVP_OVERLAY:-}')"
        echo STD_DONE; exit 1
    fi
    export BENCH_CONFIG=dep32-final.yaml TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1
    export TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS=${KF_FORCE_ACCEPTED:-1}
    # The stall guard must not end a hung case before main's HangDetector (300 s) does.
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/noft.json WIDEEP_STALL_S=${CR_STALL_S:-900}
    unset TLLM_FAULT_TOLERANCE_EXTRA_SLOTS
    [[ -n ${CR_KEEP_PAGE_CACHE:-} ]] && export WIDEEP_KEEP_PAGE_CACHE=1
    mkdir -p "$out/autotuner"; touch "$out/cold_restart.txt"
    runs="rank5 node1 stop rank5 node1 stop rank5 node1 stop"
    [[ $job == *-A ]] && runs="rank5 rank5 rank5 node1 stop"
    [[ $job == *-B ]] && runs="node1 node1 stop stop"
    runs=${CR_RUNS:-$runs}
    cr_left_min() {  # minutes left of the job or of its bundle group (GROUP_LIMIT_S from job.sh's start)
        local end=$(( $(date +%s) - SECONDS + ${GROUP_LIMIT_S:-6900} ))
        [[ -n ${SLURM_JOB_END_TIME:-} ]] && (( SLURM_JOB_END_TIME < end )) && end=$SLURM_JOB_END_TIME
        echo $(( (end - $(date +%s)) / 60 ))
    }
    cr_go() {  # NAME MINUTES: node 0 decides and every node follows
        local go=$out/$1.go
        if [[ $SLURM_NODEID == 0 ]]; then
            if (( $(cr_left_min) >= $2 )); then echo 1 > "$go.tmp"; else echo 0 > "$go.tmp"; fi
            mv "$go.tmp" "$go"
        fi
        for _ in $(seq 600); do [[ -s $go ]] && break; sleep 1; done
        [[ $(cat "$go" 2>/dev/null) == 1 ]] && return 0
        echo "COLD_RESTART_SKIP $1 ($(cr_left_min) min left, needs $2)"; return 1
    }
    cr_verdict() {  # FAILURE_CASE TYPE RUN RELAUNCH_CASE: one COLD_RESTART line (node 0)
        [[ $SLURM_NODEID == 0 ]] || return 0
        local t
        for t in "$out/$1/result.json" "$out/$4/result.json"; do
            for _ in $(seq 60); do [[ -s $t ]] && break; sleep 1; done
        done
        python3 - "$out/$1" "$2" "$3" "$out/$4" <<'PY' | tee -a "$out/cold_restart.txt"
import json, math, re, sys, time
from pathlib import Path
fail, kind, n, again = Path(sys.argv[1]), sys.argv[2], sys.argv[3], Path(sys.argv[4])
victims = {"rank5": [5], "node1": [4, 5, 6, 7], "stop": [2]}[kind]
def load(p):
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return {}
def text(p):
    return p.read_text(errors="replace") if p.exists() else ""
def timeline(run):
    return [l.split() for l in text(run / "timeline").splitlines() if l.strip()]
STAMP = re.compile(r"^\[(\d\d/\d\d/\d{4}-\d\d:\d\d:\d\d)\]")
def stamp(line):
    m = STAMP.match(line)
    return time.mktime(time.strptime(m.group(1), "%m/%d/%Y-%H:%M:%S")) if m else None
rf, ra = load(fail / "result.json"), load(again / "result.json")
kills = [float(m.group(1)) for r in victims for m in re.finditer(r"WIDEEP_SELF_KILL rank \d+ t=([0-9.]+)", text(fail / f"rank-{r}.log"))]
inject = min(kills) if kills else rf.get("kill_wall_s")
detect, detect_by = None, None
def seen(t, by):
    global detect, detect_by
    # Log stamps are whole seconds: a line stamped in the injection's second counts as detected at the injection.
    if t is not None and inject and t >= math.floor(inject) and (detect is None or max(t, inject) < detect):
        detect, detect_by = max(t, inject), by
tl = timeline(fail)
for f in tl:
    if f[0] == "RANK_EXIT" and int(f[1]) not in victims:
        seen(float(f[3]), f"rank{f[1]}_exit")
    if f[0] == "MPIRUN_EXIT":
        seen(float(f[1]), "mpirun_exit")
for log in fail.glob("rank-*.log"):
    rank = int(log.stem.split("-")[1])
    if rank in victims:
        continue
    for line in text(log).splitlines():
        if "Hang detected" in line or "[TRT-LLM] [E]" in line:
            t = stamp(line)
            if t is not None and inject and t >= math.floor(inject):
                seen(t, "hang_detector" if "Hang detected" in line else f"rank{rank}_error")
                break
clean = [float(f[2]) for f in tl if f[0] == "NODE_CLEAN"]
mpirun_exit = next((float(f[1]) for f in tl if f[0] == "MPIRUN_EXIT"), None)
start = next((float(f[1]) for f in timeline(again) if f[0] == "MPIRUN_START"), None)
log0 = text(again / "rank-0.log").splitlines()
def last(pattern):
    hits = [stamp(l) for l in log0 if re.search(pattern, l)]
    hits = [h for h in hits if h is not None]
    return max(hits) if hits else None
weights = last(r"executor_creation/model: done") or last(r"Model loading metrics")
warmup = last(r"Autotuning process ends")
captures = [float(m.group(1)) for l in log0 if (m := re.search(r"WIDEEP_CAPTURE rank 0 t=([0-9.]+)", l))]
graphs = max(captures) if captures else last(r"executor_creation: done")
ready, first = ra.get("healthy_wall_s"), ra.get("first_token_wall_s")
rel = lambda t, t0: round(t - t0, 1) if t is not None and t0 is not None else None
fields = dict(
    detect_s=rel(detect, inject), exit_s=rel(max(clean) if clean else None, inject),
    weights_s=rel(weights, start), warmup_s=rel(warmup, start), graphs_s=rel(graphs, start),
    ready_s=rel(ready, start), first_token_s=rel(first, start),
    failed_inflight=rf.get("failed_inflight"), failed_unsent=rf.get("failed_unsent"),
    detect_by=detect_by, mpirun_exit_s=rel(mpirun_exit, inject), gap_s=rel(start, max(clean) if clean else None),
    down_s=None, nodes_clean=len(clean), state=f"{rf.get('state')}/{ra.get('state')}", relaunch=again.name)
if fields["exit_s"] is not None and fields["first_token_s"] is not None:
    fields["down_s"] = round(fields["exit_s"] + fields["first_token_s"], 1)
print("COLD_RESTART", kind, f"run={n}", *(f"{k}={v}" for k, v in fields.items()))
PY
    }
    echo "COLD_RESTART_NOTE relaunch in the same allocation at once: scheduler wait excluded; gap_s (harness) excluded from down_s" \
        | tee -a "$out/cold_restart.txt"
    declare -A cr_n
    prev="" prev_type="" prev_n=""
    for type in $runs; do
        cr_n[$type]=$(( ${cr_n[$type]:-0} + 1 ))
        name=$type-${cr_n[$type]} need=24; [[ $type == stop ]] && need=30
        cr_go "$name" "$need" || break  # this failure and its relaunch
        left=$(cr_left_min)
        limit=1500; [[ $type == stop ]] && limit=1800
        export CASE_TIMEOUT_S=$(( left * 60 - 180 < limit ? left * 60 - 180 : limit ))
        window=${CR_KILL_WINDOW:-60,70}
        args=(--first-token-at-ready --wait-clients-s 60 --kill-window-s "$window")
        (case $type in
         rank5) export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name
                export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
                run_case "$name" noft --mode failover --load 128 --iterations 2 --kill decode "${args[@]}" ;;
         node1) export WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name
                export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
                run_case "$name" noft --mode failover --load 128 --iterations 2 --kill decode "${args[@]}" ;;
         stop)  export WIDEEP_VICTIM=2
                run_case "$name" noft --mode failover --load 64 --iterations 3 --kill stop "${args[@]}" ;;
         esac)
        case_index=$((case_index + 1))
        # Fail fast: a deployment that never served ends the job.
        if [[ -z $prev ]]; then
            for _ in $(seq 60); do [[ -s $out/$name/result.json ]] && break; sleep 1; done
            if ! grep -q '"ready_s"' "$out/$name/result.json" 2>/dev/null; then
                echo "SMOKE_FAIL $name: the server never became ready"; echo STD_DONE; exit 1
            fi
        else
            cr_verdict "$prev" "$prev_type" "$prev_n" "$name"
        fi
        prev=$name prev_type=$type prev_n=${cr_n[$type]}
    done
    if [[ -n $prev ]]; then
        # The last failure's relaunch (no failure of its own). Runs even when short of time: a failure without its
        # relaunch measures nothing (the go decision above reserved its minutes).
        export CASE_TIMEOUT_S=1200
        run_case "restart-after-$prev" noft --mode restart
        case_index=$((case_index + 1))
        cr_verdict "$prev" "$prev_type" "$prev_n" "restart-after-$prev"
    fi
    if [[ $SLURM_NODEID == 0 ]]; then
        python3 - "$out/cold_restart.txt" <<'PY' | tee -a "$out/cold_restart.txt"
import re, statistics, sys
lines = [l for l in open(sys.argv[1]).read().splitlines() if l.startswith("COLD_RESTART ")]
for kind in ("rank5", "node1", "stop"):
    rows = [l for l in lines if l.split()[1] == kind]
    if not rows:
        continue
    def med(key):
        v = [float(m.group(1)) for l in rows if (m := re.search(rf" {key}=([0-9.]+)", l))]
        return round(statistics.median(v), 1) if v else None
    print("COLD_RESTART_ROW", kind, f"n={len(rows)}",
          *(f"{k}_median={med(k)}" for k in ("detect_s", "exit_s", "weights_s", "warmup_s", "graphs_s", "ready_s",
                                             "first_token_s", "down_s", "failed_inflight")))
PY
    fi
    echo STD_DONE
    ;;
ACCURACY-KILL-ON|ACCURACY-KILL-OFF)
    # GSM8K (lm_eval's gsm8k, 5-shot, greedy, the full 1319-question test set from the local copy accuracy_client.py
    # reads, 256 concurrent requests) with rank 5 SIGKILLed in a decode step while the evaluation's requests are in
    # flight (ACC_KILL_WINDOW s after the server answered its first request; a full run takes ~35-100 s), FT on, node
    # failure domain, real MTP acceptance. ON = dep32-final.yaml (online EPLB 288 + 32 ghost slots); OFF = static
    # dep32-b2-320.yaml with ghost extra slots (KILL-FINAL-OFF's deployment). lm_eval retries a failed request
    # (ACC_MAX_RETRIES attempts, every case). References (ACC_REFS, default on OFF only): ref-final / ref-320 = the
    # same evaluation FT off without a kill on either config; nokill-final = FT on without a kill (dep32-final).
    # Per case ACCURACY_KILL_VERDICT (also $out/accuracy_kill.txt): accuracy (strict / flexible, stderr), n,
    # completions posted / non-200 / retried (rank 0's access log), lost requests held / re-run by FT, kill time.
    # ACCURACY_KILL_SUMMARY (OFF, at its end): each case against its reference (delta, 2 combined stderr).
    # Budget: ~11.5 min per case (ready 7.5-9.5 min with tuning, evaluation < 2 min, teardown); a case starts only if
    # node 0 sees >= 14 min left.
    if [[ $dist != "$C/$FINAL_BUILD/dist" || -n "${MVP_OVERLAY:-}" ]]; then
        echo "SMOKE_FAIL preflight: MVP_BUILD must be $FINAL_BUILD without MVP_OVERLAY ($dist, overlay '${MVP_OVERLAY:-}')"
        echo STD_DONE; exit 1
    fi
    if [[ ! -s /lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/datasets/openai/gsm8k/main/test-00000-of-00001.parquet ]]; then
        echo "SMOKE_FAIL preflight: no local GSM8K test set"; echo STD_DONE; exit 1
    fi
    export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_TEST_TRIGGER_NEEDS_REQUESTS=1 WIDEEP_FAILURE_DOMAIN=node
    unset TLLM_SPEC_DECODE_FORCE_NUM_ACCEPTED_TOKENS  # forced acceptance would change the answers
    [[ $SLURM_NODEID == 0 ]] && pip install "lm_eval[api]==0.4.10" > "$out/lm_eval-install-0.log" 2>&1
    mkdir -p "$out/autotuner"; touch "$out/accuracy_kill.txt"
    dep=final; [[ $job == *-OFF ]] && dep=320
    refs=""; [[ $job == *-OFF ]] && refs="ref-final ref-320 nokill-final"
    refs=${ACC_REFS-$refs}
    acc=(--mode accuracy --accuracy-max-retries "${ACC_MAX_RETRIES:-3}")
    acc_left_min() {
        local end=$(( $(date +%s) - SECONDS + ${GROUP_LIMIT_S:-6900} ))
        [[ -n ${SLURM_JOB_END_TIME:-} ]] && (( SLURM_JOB_END_TIME < end )) && end=$SLURM_JOB_END_TIME
        echo $(( (end - $(date +%s)) / 60 ))
    }
    acc_go() {  # NAME: node 0 decides (>= 14 min left) and every node follows
        local go=$out/$1.go
        if [[ $SLURM_NODEID == 0 ]]; then
            if (( $(acc_left_min) >= 14 )); then echo 1 > "$go.tmp"; else echo 0 > "$go.tmp"; fi
            mv "$go.tmp" "$go"
        fi
        for _ in $(seq 600); do [[ -s $go ]] && break; sleep 1; done
        [[ $(cat "$go" 2>/dev/null) == 1 ]] && return 0
        echo "ACCURACY_KILL_SKIP $1 ($(acc_left_min) min left, needs 14)"; return 1
    }
    acc_verdict() {  # NAME CONFIG: one ACCURACY_KILL_VERDICT line (node 0)
        [[ $SLURM_NODEID == 0 ]] || return 0
        for _ in $(seq 60); do [[ -s $out/$1/result.json ]] && break; sleep 1; done
        python3 - "$out/$1" "$2" <<'PY' | tee -a "$out/accuracy_kill.txt"
import json, re, sys
from pathlib import Path
run, config = Path(sys.argv[1]), sys.argv[2]
try:
    r = json.loads((run / "result.json").read_text())
except (OSError, ValueError):
    r = {}
log = (run / "rank-0.log").read_text(errors="replace") if (run / "rank-0.log").exists() else ""
a = r.get("accuracy") or {}
codes = re.findall(r'"POST /v1/completions HTTP/1\.1" (\d+)', log)
n = (a.get("n_samples") or {}).get("effective")
ft = (r.get("fault_tolerance_status") or {}).get("fault_tolerance") or {}
t0, kill = r.get("accuracy_start_wall_s"), r.get("kill_wall_s")
rnd = lambda v, d=4: round(v, d) if isinstance(v, (int, float)) else None
fields = dict(
    state=r.get("state"), rc=a.get("rc"), ft=r.get("ft"), config=config,
    strict=rnd(a.get("exact_match,strict-match")), strict_se=rnd(a.get("exact_match_stderr,strict-match")),
    flex=rnd(a.get("exact_match,flexible-extract")), flex_se=rnd(a.get("exact_match_stderr,flexible-extract")),
    n=n, posts=len(codes), non200=sum(c != "200" for c in codes),
    retried=len(codes) - n if n is not None and codes else None,
    kill_after_eval_start_s=rnd(kill - t0, 1) if kill and t0 else None,
    kill_after_first_answer_s=rnd(kill - r["first_answer_wall_s"], 1) if kill and r.get("first_answer_wall_s") else None,
    eval_s=rnd(a.get("elapsed_s"), 1),
    resume_s=rnd(r["all_resumed_seen_wall_s"] - kill, 2) if kill and r.get("all_resumed_seen_wall_s") else None,
    failed_ranks=",".join(map(str, sorted(ft.get("failed_ranks", [])))) or None, lost_held=ft.get("failed_requests"),
    reruns=sum(int(m.group(1)) for m in re.finditer(r"Running (\d+) requests of the lost ranks again", log)),
    error=(r.get("error") or "")[:120] or None)
print("ACCURACY_KILL_VERDICT", run.name, *(f"{k}={v}" for k, v in fields.items()))
PY
    }
    acc_case() {  # NAME ft|noft CONFIG EXTRA_SLOTS KILL(0|1)
        local name=$1 mode=$2 config=$3 extra=$4 kill=$5
        acc_go "$name" || return 0
        (export BENCH_CONFIG=$config TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/$mode-${config%.yaml}.json
         if [[ -n $extra ]]; then export TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=$extra; else unset TLLM_FAULT_TOLERANCE_EXTRA_SLOTS; fi
         if [[ $kill == 1 ]]; then
             export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-$name
             export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
             run_case "$name" "$mode" "${acc[@]}" --kill-during-eval --kill-window-s "${ACC_KILL_WINDOW:-3,8}"
         else
             run_case "$name" "$mode" "${acc[@]}"
         fi)
        case_index=$((case_index + 1))
        acc_verdict "$name" "$config"
        if (( case_index == ${JOB_CASE_INDEX_BASE:-0} + 1 )) && ! grep -q '"ready_s"' "$out/$name/result.json" 2>/dev/null; then
            echo "SMOKE_FAIL $name: the server never became ready"; echo STD_DONE; exit 1
        fi
    }
    for rep in $(seq "${ACC_REPS:-2}"); do
        if [[ $dep == final ]]; then acc_case "acc-kill-final-$rep" ft dep32-final.yaml "" 1
        else acc_case "acc-kill-320-$rep" ft dep32-b2-320.yaml ghost 1; fi
    done
    for ref in $refs; do
        case $ref in
        ref-final) acc_case acc-ref-final noft dep32-final.yaml "" 0 ;;
        ref-320) acc_case acc-ref-320 noft dep32-b2-320.yaml "" 0 ;;
        nokill-final) acc_case acc-nokill-final ft dep32-final.yaml "" 0 ;;
        esac
    done
    if [[ $SLURM_NODEID == 0 ]]; then
        # Every verdict of this allocation (ACCURACY-KILL-ON's too, when it ran first or alongside).
        python3 - "$C"/mvp/runs/ACCURACY-KILL-*-"$SLURM_JOB_ID"/accuracy_kill.txt <<'PY' | tee -a "$out/accuracy_kill.txt"
import math, sys
rows = {}
for path in sys.argv[1:]:
    for line in open(path).read().splitlines():
        if line.startswith("ACCURACY_KILL_VERDICT "):
            f = line.split()
            rows[f[1]] = dict(kv.split("=", 1) for kv in f[2:] if "=" in kv)
num = lambda v: float(v) if v not in (None, "None") else None
ref_of = {"dep32-final.yaml": "acc-ref-final", "dep32-b2-320.yaml": "acc-ref-320"}
for name, row in sorted(rows.items()):
    ref_name = ref_of.get(row.get("config"))
    ref = rows.get(ref_name)
    if name.startswith("acc-ref") or not ref:
        continue
    s, se, rs, rse = (num(row.get("strict")), num(row.get("strict_se")), num(ref.get("strict")), num(ref.get("strict_se")))
    if None in (s, se, rs, rse):
        print("ACCURACY_KILL_SUMMARY", name, "vs", ref_name, "missing accuracy")
        continue
    d, band = s - rs, 2 * math.sqrt(se ** 2 + rse ** 2)
    print("ACCURACY_KILL_SUMMARY", name, "vs", ref_name, f"strict={s:.4f} ref={rs:.4f} delta={d:+.4f} 2se={band:.4f}",
          "within" if abs(d) <= band else "OUTSIDE", f"n={row.get('n')}/{ref.get('n')}", f"retried={row.get('retried')}",
          f"non200={row.get('non200')}", f"lost_held={row.get('lost_held')}", f"reruns={row.get('reruns')}")
PY
    fi
    echo STD_DONE
    ;;
esac
