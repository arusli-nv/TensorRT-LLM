#!/bin/bash
# One MVP job on 8 GB200 nodes (every node runs this). Cases run back to back from a private /tmp copy
# of the harness, so editing mvp/harness later cannot change a running job.
# Usage: job.sh JOB    (results in mvp/runs/<JOB>-<slurm id>/<case>/)
set -uo pipefail
job=$1
C=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/users/arusli/src/TensorRT-LLM/.wideep-ft-runs/claude
# The wheel of the code under test; every MVP result uses it (see ../README.md).
dist=$C/${MVP_BUILD:-build-final-b1d7fa789d}/dist
copy_dist=$C/build-final-97e13f42b6/dist  # FT experts read a local copy, for the before/after check
# The final benchmark's wheel (analysis/FINAL_BENCHMARK_PLAN.md): the LADDER, GHOST-COST, FINAL-AUTO and KILL-MATRIX
# preflights require MVP_BUILD=$FINAL_BUILD. TODO: set to the one full build of record before any of them is submitted.
FINAL_BUILD=${FINAL_BUILD:-build-final-TODO}
if [[ -n ${JOB_PARENT_OUT:-} ]]; then
    # A piece of a composed job (KILL-MATRIX*): the parent's private harness copy, results under the parent's run dir.
    H=/tmp/mvp-harness; out=$JOB_PARENT_OUT/$job
else
    H=/tmp/mvp-harness; rm -rf $H; cp -r $C/mvp/harness $H
    out=$C/mvp/runs/$job-$SLURM_JOB_ID
fi
mkdir -p "$out"
# Node settings that can stall long-running processes (THP compaction, NUMA balancing), for the record.
grep -H . /sys/kernel/mm/transparent_hugepage/enabled /sys/kernel/mm/transparent_hugepage/defrag \
    /proc/sys/kernel/numa_balancing /proc/sys/net/core/somaxconn /proc/sys/net/ipv4/tcp_max_syn_backlog \
    /proc/sys/net/ipv4/tcp_abort_on_overflow > "$out/sysinfo-$SLURM_NODEID.txt" 2>&1
echo "ulimit_nofile=$(ulimit -n)" >> "$out/sysinfo-$SLURM_NODEID.txt"
{ hostname; command -v ibstat > /dev/null && ibstat 2>&1 | head -60; } >> "$out/sysinfo-$SLURM_NODEID.txt" 2>&1
# Accept-queue overflows on this node (TcpExt ListenOverflows ListenDrops): a server that stops accepting drops
# connections the clients already count as open.
listen_drops() { awk '/^TcpExt:/ { if (!n) { for (i = 1; i <= NF; i++) k[i] = $i; n = 1 } else
    for (i = 1; i <= NF; i++) if (k[i] == "ListenOverflows" || k[i] == "ListenDrops") printf "%s=%s ", k[i], $i }' \
    /proc/net/netstat; }
export WIDEEP_LAUNCHER_GRACE_S=180  # profiled cases: time to write the nsys reports
case_index=${JOB_CASE_INDEX_BASE:-0}
run_case() {  # NAME MODE [bench.py args...]
    local name=$1; shift
    # JOB_CASES (a composed job's subset of a case block): run only the named cases; require_done passes a skipped one.
    if [[ -n ${JOB_CASES:-} && " $JOB_CASES " != *" $name "* ]]; then
        echo "CASE $name skipped (not in JOB_CASES)"; touch "$out/$name.skipped"; return 0
    fi
    case_index=$((case_index + 1))
    echo "CASE $name start $(date +%T)"
    echo "CASE $name net before: $(listen_drops)"
    CASE_INDEX=$case_index timeout --kill-after=60 "${CASE_TIMEOUT_S:-3300}" bash $H/serve.sh "$dist" "$out/$name" "$@"
    echo "CASE $name rc=$? $(date +%T)"
    echo "CASE $name net after: $(listen_drops)"
}
require_done() {  # NAME: fail fast (efficiency rule 4): end the job on every node unless case NAME finished DONE
    local result=$out/$1/result.json
    [[ -e $out/$1.skipped ]] && return 0
    for _ in $(seq 60); do [[ -s $result ]] && break; sleep 1; done
    grep -q '"state": "DONE"' "$result" 2>/dev/null && return 0
    echo "SMOKE_FAIL $1: $(grep -o '"state": "[^"]*"' "$result" 2>/dev/null)"
    echo STD_DONE
    exit 1
}
kill_case() {  # NAME KIND LOAD [ITERATIONS]  FT on: rank 2 is lost during the case (failover mode)
    local name=$1 kind=$2 load=$3 its=${4:-$([[ $3 -le 8 ]] && echo 4 || echo 2)}
    (
        # Timed kills: rank 2 kills itself at its next decode replay / prefill forward once the
        # driver creates the trigger file.
        # The trigger is node-local (rank 2 and the driver share node 0), so polling it costs nothing.
        export TLLM_TEST_KILL_TRIGGER=/tmp/wideep-kill-$SLURM_JOB_ID-$name
        [[ $kind == decode ]] && export TLLM_TEST_KILL_RANK=2 TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
        [[ $kind == prefill ]] && export TLLM_TEST_KILL_RANK=2 TLLM_TEST_KILL_IN_PREFILL=$TLLM_TEST_KILL_TRIGGER
        # Prefill kills land in the first wave's prefill burst; the other kinds in steady decode.
        local window=${WIDEEP_KILL_WINDOW:-30,60}; [[ $kind == prefill ]] && window=2,6
        run_case "$name" ft --mode failover --kill "$kind" --load "$load" --iterations "$its" --kill-window-s "$window"
    )
    case_index=$((case_index + 1))  # run_case counted it in the subshell
}
case $job in
L1-A|L1-B)
    # Lane 1 (final): FT off and FT on, full sweep each, in opposite orders across the two jobs.
    if [[ $job == L1-A ]]; then
        run_case sweep-noft noft --mode sweep
        run_case sweep-ft ft --mode sweep
    else
        run_case sweep-ft ft --mode sweep
        run_case sweep-noft noft --mode sweep
    fi
    ;;
PROFILE-LOSS)
    # Why a step is slower after a loss: nsys windows at 8/GPU on one server before and after losing rank 2,
    # on rank 1 and on rank 24 (which holds copies of rank 2's experts); every rank logs its iterations.
    # async: each window's report is written when it closes; the default (defer) writes them all at exit, which
    # the MPI_Abort ending an after-loss job skips (7996764 lost every report).
    export TLLM_PROFILE_LOG_RANKS=all TLLM_TEST_NSYS_RANKS=1+24 TLLM_TEST_NSYS_CAPTURE_END=repeat:4:async
    run_case loss-8 ft --mode sweep --after-loss --loads 8 --iterations 2 --profile-after-s 60
    ;;
ACCURACY)
    # Correctness at scale: GSM8K (lm_eval's task on the repo's local copy) through the server, FT off, then
    # FT on after losing rank 2; compared with a tolerance (exact tokens hold only on the small config).
    [[ $SLURM_NODEID == 0 ]] && pip install "lm_eval[api]==0.4.10" > "$out/lm_eval-install-0.log" 2>&1
    run_case acc-noft noft --mode accuracy
    run_case acc-ft-loss ft --mode accuracy --after-loss
    ;;
P1-LITE)
    # Phase 1 correctness on ONE node (DeepSeek-V3-Lite, EP4, as the integration test), so it never waits for
    # 8-node slots: per feature, exact tokens across an idle and an in-flight kill, then kills while idle, in a
    # decode step and at a random time under load. MVP_BUILD = a wideep-ft-next wheel.
    # V3-Lite decodes ~10x faster than R1: kills land 3-8 s into a load (R1: 30-60 s), and the in-flight token
    # check kills 0.5 s after submitting 400-token requests. sync is the control (FT as in the MVP).
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export WIDEEP_KILL_WINDOW=3,8
    for feature in ${P1_FEATURES:-sync overlap balance}; do
        export TOKENS_CONFIG=../configs/lite4-$feature.yaml
        (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="--no-kill"; run_case $feature-tokens-ref ft)
        case_index=$((case_index + 1))
        (export TOKENS_ARGS="--reference $out/$feature-tokens-ref/result.json"; run_case $feature-tokens-idle ft)
        case_index=$((case_index + 1))
        # No first-token probe: a new request on any rank changes rank 0's numerics without a kill (P1-INFLIGHT).
        (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="--inflight-after 0.5 --max-tokens 400 --no-probe"
            run_case $feature-tokens-inflight ft)
        case_index=$((case_index + 1))
        unset TOKENS_CONFIG
        [[ -n "${P1_TOKENS_ONLY:-}" ]] && continue
        export BENCH_CONFIG=lite4-$feature.yaml
        kill_case $feature-idle idle 8
        kill_case $feature-decode8 decode 8
        kill_case $feature-random32 random 32
    done
    ;;
P1-INFLIGHT)
    # Why does rank 0's request differ after an in-flight kill (sync too)? The same load without a kill, with
    # and without the first-token probe, and the kill without the probe. Healthy numerics differ on their own
    # if the no-kill cases fail.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TOKENS_CONFIG=../configs/lite4-sync.yaml TLLM_TEST_ORACLE_EXCLUDE_RANK=2
    inflight="--inflight-after 0.5 --max-tokens 400"
    (export TOKENS_ARGS="$inflight --probe-only"; run_case nokill-probe ft)
    case_index=$((case_index + 1))
    (export TOKENS_ARGS="$inflight --probe-only --no-probe"; run_case nokill-noprobe ft)
    case_index=$((case_index + 1))
    (export TOKENS_ARGS="$inflight --no-probe"; run_case kill-noprobe ft)
    case_index=$((case_index + 1))
    (export TOKENS_ARGS="$inflight --no-probe"; run_case kill-noprobe-2 ft)
    ;;
P1-OVERLAP|P1-BALANCE)
    # Phase 1 correctness of ONE feature with FT (MVP_BUILD = a wideep-ft-next wheel): exact tokens across an
    # idle and a mid-decode kill on the small config, then kills under load on DEP32 with the feature on.
    feature=$(echo "${job#P1-}" | tr '[:upper:]' '[:lower:]')
    export TOKENS_CONFIG=config-small-$feature.yaml
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="--no-kill"; run_case tokens-ref ft)
    case_index=$((case_index + 1))
    (export TOKENS_ARGS="--reference $out/tokens-ref/result.json"; run_case tokens-idle ft)
    case_index=$((case_index + 1))
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="--inflight-after 5"; run_case tokens-inflight ft)
    case_index=$((case_index + 1))
    unset TOKENS_CONFIG
    export BENCH_CONFIG=dep32-e0-$feature.yaml
    kill_case idle-1 idle 8
    kill_case decode8-1 decode 8
    kill_case random256-1 random 256
    ;;
L1-512)
    # Lane 1 (final), 512/GPU only. 16k clients connecting at once overflowed the server's listen backlog
    # (uvicorn's 2048; ~2.5% of requests reset in both modes, L1-512-7996104), so new requests arrive at 1000/s
    # (all 16k open within ~16 s). FT off and FT on on the same nodes, in the order of L512_ORDER (two jobs, AB
    # and BA, since four ~31 min cases exceed the time limit).
    i=0
    for mode in ${L512_ORDER:-noft ft}; do
        i=$((i + 1)); run_case sweep-$mode-$i $mode --mode sweep --loads 512 --request-rate 1000
    done
    ;;
L1-512-FE)
    # 512/GPU with two frontend processes on the serving port: the single frontend's accept queue overflowed
    # (L1-512-8005424; analysis/L1_512_FAILURES.md). Decides: 0 failed requests, and the 512 column.
    i=0
    for mode in ${L512_ORDER:-noft ft}; do
        i=$((i + 1)); BENCH_CONFIG=dep32-fe2.yaml run_case sweep-$mode-fe2-$i $mode --mode sweep --loads 512 \
            --request-rate 1000
    done
    ;;
HANG-LITE)
    # Phase 1 hang detection on one node (DeepSeek-V3-Lite EP4, sync config; MVP_BUILD = a next wheel,
    # MVP_OVERLAY = the hang commits): a healthy control must fence nothing; rank 2 SIGSTOPped idle and in flight,
    # and rank 2's GPU stalled 60 s in a decode step, must each be confirmed, fenced (killed) and recovered with
    # exact tokens.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TOKENS_CONFIG=../configs/lite4-sync.yaml TLLM_FAULT_TOLERANCE_HANG_DETECTION=1
    export TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=10 WIDEEP_FENCE_COMMAND='kill -KILL {pid}'
    inflight="--inflight-after 0.5 --max-tokens 400 --no-probe"
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="--no-kill"; run_case hang-ref ft)
    case_index=$((case_index + 1))
    (export TOKENS_ARGS="--reference $out/hang-ref/result.json --signal STOP"; run_case stop-idle ft)
    case_index=$((case_index + 1))
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="$inflight --signal STOP"; run_case stop-inflight ft)
    case_index=$((case_index + 1))
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2 TLLM_TEST_STALL_S=60
     export TLLM_TEST_STALL_IN_DECODE=/tmp/wideep-stall-$SLURM_JOB_ID
     export TOKENS_ARGS="$inflight --trigger $TLLM_TEST_STALL_IN_DECODE"; run_case stall-inflight ft)
    ;;
FE-SMOKE)
    # One node, DeepSeek-V3-Lite EP4: does trtllm-serve start and serve with two frontends, FT off and on?
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    for mode in noft ft; do
        BENCH_CONFIG=lite4-fe2.yaml run_case fe2-$mode $mode --mode sweep --loads 64 --iterations 2
    done
    ;;
L1-LOSS)
    # Lane 1 (final): FT on, the sweep, the loss of rank 2, the sweep on 31 GPUs.
    CASE_TIMEOUT_S=6600 run_case sweep-ft-loss ft --mode sweep --after-loss
    ;;
L1-REF)
    # Lane 1 (final): the standard-config FT-off reference (overlap scheduler, attention-DP balancing), then check 1.
    (export BENCH_CONFIG=dep32-standard.yaml; run_case reference-noft noft --mode sweep)
    case_index=$((case_index + 1))
    # Check 1: FT off under the ULFM launcher and its ob1 transport vs plain FT off on the same nodes: the
    # transport's share of the FT cost.
    run_case check-noft noft --mode sweep --loads 8,32,128 --iterations 3
    run_case ulfm-noft noft-ulfm --mode sweep --loads 8,32,128 --iterations 3
    ;;
FAIL-1|FAIL-2|FAIL-3)
    # Lane 2, FT on, n=5 per setting; every kill needs a fresh server (one loss per server).
    #   FAIL-1: idle, and a timed kill in a decode step at 8 per GPU
    #   FAIL-2: timed kills in a decode step and in a prefill step at 256 per GPU
    #   FAIL-3: random-time kills under load at 8 and at 256 per GPU
    for i in 1 2 3 4 5; do
        case $job in
        FAIL-1) kill_case idle-$i idle 8; kill_case decode8-$i decode 8 ;;
        FAIL-2) kill_case decode256-$i decode 256; kill_case prefill256-$i prefill 256 ;;
        FAIL-3) kill_case random8-$i random 8; kill_case random256-$i random 256 ;;
        esac
    done
    ;;
ABORT)
    # Lane 2, FT off: a random-time kill under load at 256 per GPU aborts the job (plain mpirun); the same
    # server then restarts on the same nodes. n=5. Then the exact-token check (small config, FT on): a
    # reference run that routes as after the loss, and 3 idle kills compared with it.
    for i in 1 2 3 4 5; do
        run_case abort-$i noft --mode failover --kill random --load 256 --iterations 2
        run_case restart-$i noft --mode restart
    done
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="--no-kill"; run_case tokens-ref ft)
    for i in 1 2 3; do
        (export TOKENS_ARGS="--reference $out/tokens-ref/result.json"; case_index=$((case_index + i)); run_case tokens-$i ft)
    done
    ;;
DIAG)
    # Why FT on steps spike in the first minutes of serving: the ULFM launcher alone, FT on, FT on with the
    # peer-failure watcher idle (it polls once an hour), and FT off; every rank logs its iterations.
    export TLLM_PROFILE_LOG_RANKS=all
    [[ $SLURM_NODEID == 0 ]] && ompi_info --all --parsable > "$out/ompi_info.txt" 2>&1
    run_case noft-ulfm noft-ulfm --mode sweep --loads 8,32
    run_case ft ft --mode sweep --loads 8,32
    (export TLLM_TEST_WATCH_POLL_S=3600; run_case ft-idle-watch ft --mode sweep --loads 8,32)
    case_index=$((case_index + 1))
    run_case noft noft --mode sweep --loads 8,32
    ;;
AGING)
    # Server-age slowdown (DIAG-7984906): FT off as measured, then with Python GC enabled in the server and
    # workers; every rank logs its iterations.
    export TLLM_PROFILE_LOG_RANKS=all
    run_case noft noft --mode sweep --loads 8,32,8,32
    (export TRTLLM_SERVER_DISABLE_GC=0 TRTLLM_WORKER_DISABLE_GC=0; run_case noft-gc noft --mode sweep --loads 8,32,8,32)
    case_index=$((case_index + 1))
    ;;
TRANSPORT)
    # Host MPI transport: every case so far ran ob1 over TCP (ULFM needs ob1). FT off with Open MPI's defaults
    # (UCX), as deployed without FT; FT on with shared memory inside a node.
    export TLLM_PROFILE_LOG_RANKS=0
    run_case noft-tcp noft --mode sweep --loads 8,32
    (export WIDEEP_MPI_MCA=""; run_case noft-ucx noft --mode sweep --loads 8,32)
    case_index=$((case_index + 1))
    (export WIDEEP_MPI_MCA="--mca pml ob1 --mca btl self,sm,tcp --mca coll ^hcoll,ucc"
     run_case ft-sm ft --mode sweep --loads 8,32)
    case_index=$((case_index + 1))
    run_case ft-tcp ft --mode sweep --loads 8,32
    ;;
TRANSPORT2)
    # Faster ob1 paths between nodes for FT (ULFM needs ob1): what the nodes offer, then FT on over Open MPI's
    # UCX-backed BTL and over TCP on the InfiniBand interfaces only; FT off with the defaults as the reference.
    export TLLM_PROFILE_LOG_RANKS=0
    # First the all-to-all kernels alone on the revised K3 wheel (dispatch acquire fence, parallel slot loads).
    bash $H/kbench/run_mpi.sh "$C/build-k3b-bf8f4b98e6/dist" "$out/kbench-k3b"
    { ip -br addr; ompi_info | grep -E "MCA (btl|pml)"; ucx_info -d | grep -E "Transport|Device"; } \
        > "$out/net-$SLURM_NODEID.txt" 2>&1
    (export WIDEEP_MPI_MCA="--mca pml ob1 --mca btl self,sm,uct --mca btl_uct_memory_domains all --mca coll ^hcoll,ucc"
     run_case ft-uct ft --mode sweep --loads 8,32)
    case_index=$((case_index + 1))
    ib=$(ip -o link show | awk -F': ' '$2 ~ /^ib/ {print $2}' | paste -sd, -)
    if [[ -n "$ib" ]]; then
        (export WIDEEP_MPI_MCA="--mca pml ob1 --mca btl self,sm,tcp --mca btl_tcp_if_include $ib --mca coll ^hcoll,ucc"
         run_case ft-tcp-ib ft --mode sweep --loads 8,32)
    fi
    case_index=$((case_index + 1))
    (export WIDEEP_MPI_MCA=""; run_case noft-ucx noft --mode sweep --loads 8,32)
    case_index=$((case_index + 1))
    ;;
TRANSPORT3)
    # FT off over UCX vs ob1 (shared memory + TCP on eth0) interleaved on the same nodes, so neither the case
    # order nor the node set can masquerade as a transport effect.
    export TLLM_PROFILE_LOG_RANKS=0
    for round in 1 2; do
        (export WIDEEP_MPI_MCA=""; run_case noft-ucx-$round noft --mode sweep --loads 8,32 --iterations 2)
        case_index=$((case_index + 1))
        (export WIDEEP_MPI_MCA="--mca pml ob1 --mca btl self,sm,tcp --mca btl_tcp_if_include eth0 --mca coll ^hcoll,ucc"
         run_case noft-ob1-$round noft --mode sweep --loads 8,32 --iterations 2)
        case_index=$((case_index + 1))
    done
    ;;
HOSTCOLL)
    # Latency of the executor's host collectives per MPI transport (no model).
    bash $H/kbench/hostcoll_run.sh "$dist" "$out/hostcoll"
    ;;
E0)
    # Phase 1 attribution, FT off: the FT config, then that config with one standard feature on each (overlap
    # scheduler, attention-DP balancing, no EPLB placement), and the overlap one again under the ULFM launcher
    # and its TCP transport (does the overlap scheduler hide the transport cost?).
    run_case base noft --mode sweep --loads 8,32,128 --iterations 2
    for variant in overlap balance noeplb; do
        (export BENCH_CONFIG=dep32-e0-$variant.yaml; run_case $variant noft --mode sweep --loads 8,32,128 --iterations 2)
        case_index=$((case_index + 1))
    done
    (export BENCH_CONFIG=dep32-e0-overlap.yaml; run_case overlap-ulfm noft-ulfm --mode sweep --loads 8,32,128 --iterations 2)
    case_index=$((case_index + 1))
    ;;
HOSTCOLL-SHRINK)
    # Why host collectives are slower after a loss (PROFILE-LOSS-8007445): the same 32 ranks on the FT transport,
    # before a failure (all, and a 31-rank split), then rank 2 exits and the survivors shrink; the shrunk
    # communicator and the old split again, and the per-collective dead-peer check on each.
    HOSTCOLL_SET="ob1-tcp-eth0" HOSTCOLL_FT=ulfm HOSTCOLL_BENCH=hostcoll_shrink.py \
        bash $H/kbench/hostcoll_run.sh "$dist" "$out/hostcoll"
    ;;
HOSTCOLL2)
    # Host-collective latency of the final FT transport (ob1 TCP-only on eth0) next to UCX, ob1 with shared
    # memory, smcuda, and libfabric (pml cm + mtl ofi; skipped by Open MPI if absent), all under ULFM.
    HOSTCOLL_SET="ucx ob1-tcp-eth0 ob1-sm-tcp-eth0 ob1-smcuda-tcp-eth0 cm-ofi" HOSTCOLL_FT=ulfm \
        bash $H/kbench/hostcoll_run.sh "$dist" "$out/hostcoll"
    ;;
AGING2)
    # Server-age stall episode: FT off with the allocator, RSS and page faults of every rank logged every 5 s.
    export TLLM_PROFILE_LOG_RANKS=all TLLM_TEST_ALLOC_STATS_S=5
    run_case noft noft --mode sweep --loads 8,32,8,32
    ;;
AGING3)
    # Server-age stall episode: FT off with every GPU's clocks, power and throttle reasons and every node's
    # CPU, memory and IO activity logged next to every rank's step times.
    export TLLM_PROFILE_LOG_RANKS=all WIDEEP_DMON=1
    run_case noft noft --mode sweep --loads 8,32,8,32
    ;;
VALIDATE)
    # Before the final jobs: the final config end to end once per path at a small size, including recovery.
    kill_case idle-1 idle 8
    kill_case decode8-1 decode 8
    run_case sweep-ft ft --mode sweep --after-loss --loads 8 --iterations 1
    ;;
ULFMSCALE)
    # Which ULFM transport recovers at 32 ranks on 8 nodes: an idle kill under each (FAIL-1-7990890 hung in
    # Shrink with btl self,sm,tcp + eth0; the 4-rank survivor test passes under all of them).
    tcp="--mca pml ob1 --mca btl self,tcp --mca coll ^hcoll,ucc"
    (export WIDEEP_MPI_MCA="$tcp"; kill_case idle-tcp idle 8)
    case_index=$((case_index + 2))
    (export WIDEEP_MPI_MCA="$tcp --mca btl_tcp_if_include eth0"; kill_case idle-tcp-eth0 idle 8)
    case_index=$((case_index + 2))
    (export WIDEEP_MPI_MCA="--mca pml ob1 --mca btl self,sm,tcp --mca coll ^hcoll,ucc"; kill_case idle-sm-tcp idle 8)
    case_index=$((case_index + 2))
    ;;
T1-SM)
    # Shared-memory BTL under ULFM at 32 ranks (Open MPI documents sm with CMA as tested with ULFM, yet
    # ULFMSCALE-7992972 hung in Shrink with self,sm,tcp). One idle kill per job (T1_VARIANT=sm-cma |
    # sm-nocopy): a hung case leaves processes that would invalidate a next case on the same nodes. Every node
    # dumps its workers' native + Python stacks 60 s and 120 s after the kill, so a hang shows where each waits.
    pip install py-spy > "$out/py-spy-install-$SLURM_NODEID.log" 2>&1 || echo "PY_SPY_INSTALL_FAILED $SLURM_NODEID"
    variant=${T1_VARIANT:?}
    mca="--mca pml ob1 --mca btl self,sm,tcp --mca coll ^hcoll,ucc"
    [[ $variant == sm-nocopy ]] && mca="$mca --mca btl_sm_single_copy_mechanism none"
    (
        until grep -qs "^RANK_EXIT 2 " "$out/idle-$variant/timeline"; do sleep 2; done
        for at in 60 120; do
            sleep 60
            for pid in $(pgrep -f mgmn_worker_node); do
                timeout 60 py-spy dump --native --pid "$pid" \
                    > "$out/stacks-$variant-kill+$at-node$SLURM_NODEID-$pid.txt" 2>&1
            done
        done
    ) &
    dumper=$!
    (export WIDEEP_MPI_MCA="$mca"; kill_case idle-$variant idle 8)
    kill $dumper 2>/dev/null
    ;;
T2-UCT)
    # Open MPI 5.0.10 built with UCX + ULFM (ompi-ft-ucx/, RECIPE.txt): does ob1 over btl uct give UCX-like host
    # collective latency under ULFM, and does a 32-rank idle kill recover over it? Every case uses that build.
    # T2_HOSTCOLL=0 skips the latency part. T2_KILL lists the kill cases in order (tcp, uct-ib, uct-default,
    # uct-nohan); tcp, this build on the default FT transport, is the control. Every node dumps its workers'
    # stacks once when no rank log has changed for 120 s (a stall, e.g. at startup) and 60 s after the kill.
    export WIDEEP_MPI_PREFIX=$C/ompi-ft-ucx
    [[ ${T2_HOSTCOLL:-1} == 1 ]] && HOSTCOLL_SET="ucx ob1-tcp-eth0 ob1-uct ob1-uct-ib" HOSTCOLL_FT="ulfm none" \
        bash $H/kbench/hostcoll_run.sh "$dist" "$out/hostcoll"
    pip install py-spy > "$out/py-spy-install-$SLURM_NODEID.log" 2>&1 || echo "PY_SPY_INSTALL_FAILED $SLURM_NODEID"
    dump() {
        for pid in $(pgrep -f mgmn_worker_node); do
            timeout 60 py-spy dump --native --pid "$pid" > "$out/stacks-$1-node$SLURM_NODEID-$pid.txt" 2>&1
        done
    }
    uct="--mca pml ob1 --mca btl self,uct,tcp --mca btl_tcp_if_include eth0"
    declare -A t2_mca=(
        [tcp]=""
        [uct-ib]="$uct --mca btl_uct_memory_domains $(ls /sys/class/infiniband | paste -sd,) --mca coll ^hcoll,ucc"
        [uct-default]="$uct --mca coll ^hcoll,ucc"
        [uct-nohan]="$uct --mca coll ^hcoll,ucc,han"
        # Probes of the server-only hang: UCX memory hooks off; reliable-connected transport only (no DC).
        [uct-nomemev]="$uct --mca coll ^hcoll,ucc -x UCX_MEM_EVENTS=no"
        [uct-rc]="$uct --mca coll ^hcoll,ucc --mca btl_uct_transports rc_mlx5"
    )
    for transport in ${T2_KILL:-tcp uct-default}; do
        run=$out/idle-$transport
        (
            until [[ -e $run/frontend.done ]]; do
                newest=$(stat -c %Y "$run"/rank-*.log 2>/dev/null | sort -n | tail -1)
                [[ -n $newest ]] && (( $(date +%s) - newest > 120 )) && { dump $transport-stall; break; }
                sleep 5
            done
        ) &
        stall_dumper=$!
        (until grep -qs "^RANK_EXIT 2 " "$run/timeline"; do sleep 2; done; sleep 60; dump $transport-kill+60) &
        kill_dumper=$!
        (
            [[ -n ${t2_mca[$transport]} ]] && export WIDEEP_MPI_MCA="${t2_mca[$transport]}"
            kill_case idle-$transport idle 8
        )
        kill $stall_dumper $kill_dumper 2>/dev/null
        case_index=$((case_index + 2))
    done
    ;;
MAINAB)
    # FT off on main (the PR 1 wheel: main + the mpi4py change) vs on the reference, interleaved on the same
    # nodes: the series must not slow serving without FT.
    for round in 1 2; do
        for build in build-pr1-867a6cac0b build-final-b1d7fa789d; do
            (dist=$C/$build/dist; run_case noft-${build#build-}-$round noft --mode sweep --loads 8,32 --iterations 2)
            case_index=$((case_index + 1))
        done
    done
    ;;
SOAK)
    # Diagnostic: three cycles of one server under steady load (64/GPU, ~40 iterations, ~17 min), each losing
    # rank 2 early and serving on 31 GPUs for the rest; allocator, RSS and page-fault counters every 60 s.
    # Does anything drift after a recovery (memory, step time, failed requests)?
    export TLLM_TEST_ALLOC_STATS_S=60 TLLM_PROFILE_LOG_RANKS=0
    for i in 1 2 3; do kill_case soak-$i random 64 40; done
    ;;
OUTLIER)
    # Diagnostic: FAIL-1's kills with the recovery markers kept in memory until the rank resumes, so no rank-log
    # write sits on the recovery path. Do the 121/128 ms outliers (one survivor stalled 50-72 ms) persist?
    export TLLM_TEST_BUFFER_MARKS=1
    for i in 1 2 3 4 5; do kill_case idle-$i idle 8; kill_case decode8-$i decode 8; done
    ;;
MERGEAB)
    # Phase 1 (b): the host-collective merge (wideep-ft-next a470d307bb: 11 -> 7 MPI calls per decode step) as a
    # Python overlay on the reference wheel, vs the reference alone, interleaved on the same nodes, FT off and on,
    # at the loads where host collectives weigh most.
    for round in 1 2; do
        for mode in noft ft; do
            for variant in ref merge; do
                (export MVP_OVERLAY=$([[ $variant == merge ]] && echo $C/overlays/merge-a470d307bb)
                 [[ -z $MVP_OVERLAY ]] && unset MVP_OVERLAY
                 run_case $mode-$variant-$round $mode --mode sweep --loads 8,32 --iterations 2)
                case_index=$((case_index + 1))
            done
        done
    done
    ;;
AGING4)
    # AGING3 with the weights dropped from the page cache once the server is ready (serve.sh): the drop shows in
    # vmstat at ready, and no stall episode follows ~10 min after the weight read.
    export TLLM_PROFILE_LOG_RANKS=all WIDEEP_DMON=1
    run_case noft noft --mode sweep --loads 8,32,8,32
    ;;
OPT)
    # One optimization round on MVP_BUILD: the all-to-all kernels alone, then FT off vs FT on end to end
    # at a low, a medium and a high load.
    bash $H/kbench/run_mpi.sh "$dist" "$out/kbench"
    run_case noft noft --mode sweep --loads 8,32,256
    run_case ft ft --mode sweep --loads 8,32,256
    ;;
E2E)
    # FT off vs FT on end to end on MVP_BUILD at a low, a medium and a high load.
    run_case noft noft --mode sweep --loads 8,32,256
    run_case ft ft --mode sweep --loads 8,32,256
    ;;
KBENCH)
    # All-to-all kernels alone at EP 32 (FT off/on, PDL off/on, nsys on rank 5): the routing-copy cost.
    bash $H/kbench/run_mpi.sh "$dist" "$out/kbench"
    ;;
CHANGE)
    # Zero-copy expert input vs the local copy it replaces, end to end: serving at 32 and 256 requests per
    # GPU, FT off and FT on with each wheel (the kernel benchmark ran in earlier CHANGE jobs).
    run_case noft noft --mode sweep --loads 32,256
    (dist=$copy_dist; run_case ft-copy ft --mode sweep --loads 32,256)
    case_index=$((case_index + 1))
    run_case ft ft --mode sweep --loads 32,256
    ;;
PROFILE)
    # A 50-step nsys window of ranks 1 and 5 in steady decode, opened through /start_profile (the documented
    # trtllm-serve method), one server per mode and load; measured cases are never profiled.
    profile_case() {  # NAME MODE LOAD
        (export TLLM_TEST_NSYS_RANKS=1+5
         run_case "$1" "$2" --mode sweep --loads "$3" --iterations 2 --profile-after-s 60)
        case_index=$((case_index + 1))
    }
    for load in ${PROFILE_LOADS:-8 256}; do
        profile_case noft-$load noft $load
        profile_case ft-$load ft $load
    done
    ;;
SMOKE)
    # Harness check, every path once at a small size: sweep, loss + after-loss sweep, a random kill under
    # load, a timed kill in a decode step, and FT off abort + restart.
    run_case sweep-noft noft --mode sweep --loads 8 --iterations 1
    run_case sweep-ft ft --mode sweep --after-loss --loads 8 --iterations 1
    kill_case kill-random random 8 2
    kill_case kill-decode decode 8 2
    run_case abort-noft noft --mode failover --kill random --load 8 --iterations 2 --kill-window-s 10,20
    run_case restart-noft noft --mode restart
    ;;
esac
echo JOB_END
# Cases appended while another job runs this file (bash keeps its read offset, so edits above would corrupt it);
# fold them into the case list above once no job runs.
case $job in
STD-A)
    # Healthy FT cost, step (a): FT + overlap scheduler vs FT off + overlap (configs/dep32-e0-overlap.yaml), same
    # nodes, interleaved, two rounds at 8/32/128/256 per GPU; then one nsys window of rank 1 per mode at 32.
    export BENCH_CONFIG=${BENCH_CONFIG:-dep32-e0-overlap.yaml}
    for round in 1 2; do
        modes="noft ft"; [[ $round == 2 ]] && modes="ft noft"
        for mode in $modes; do
            run_case $mode-$round $mode --mode sweep --loads 8,32,128,256 --iterations 2
        done
    done
    for mode in noft ft; do
        (export TLLM_TEST_NSYS_RANKS=1; run_case profile-$mode-32 $mode --mode sweep --loads 32 --iterations 2 --profile-after-s 60)
        case_index=$((case_index + 1))
    done
    echo STD_DONE
    ;;
esac
case $job in
SM-DIAG)
    # Lever A, sm: why ULFM's Shrink never completes over btl sm at 32 ranks in the server (T1-SM). A control
    # idle kill on the default FT transport (tcp), then ONE sm idle kill with SM_VARIANT's settings:
    #   verbose : ULFM / errmgr / PMIx event verbosity (how and when survivors learn of the failure)
    #   detector: Open MPI's in-band failure detector (mpi_ft_detector), not only PRTE's notification
    # Every node dumps its workers' native + Python stacks and mapped MPI/UCX libraries 60 and 120 s after the kill.
    pip install py-spy > "$out/py-spy-install-$SLURM_NODEID.log" 2>&1 || echo "PY_SPY_INSTALL_FAILED $SLURM_NODEID"
    kill_case idle-tcp idle 8
    sm="--mca pml ob1 --mca btl self,sm,tcp --mca btl_tcp_if_include eth0 --mca coll ^hcoll,ucc"
    case ${SM_VARIANT:?} in
        verbose) sm="$sm --mca mpi_ft_verbose 10 --mca errmgr_base_verbose 10 --prtemca errmgr_base_verbose 10 --prtemca pmix_server_verbose 5" ;;
        detector) sm="$sm --mca mpi_ft_detector true" ;;
    esac
    (
        run=$out/idle-sm-$SM_VARIANT
        until grep -qs "^RANK_EXIT 2 " "$run/timeline"; do sleep 2; done
        for at in 60 120; do
            sleep 60
            for pid in $(pgrep -f mgmn_worker_node); do
                timeout 60 py-spy dump --native --pid "$pid" > "$out/stacks-kill+$at-node$SLURM_NODEID-$pid.txt" 2>&1
                grep -oE "/[^ ]*lib(ucs|uct|ucp|mpi|open-pal|pmix|prrte)[^ ]*" /proc/$pid/maps | sort -u \
                    > "$out/maps-node$SLURM_NODEID-$pid.txt" 2>&1
            done
        done
    ) &
    dumper=$!
    (export WIDEEP_MPI_MCA="$sm"; kill_case idle-sm-$SM_VARIANT idle 8)
    kill $dumper 2>/dev/null
    echo SM_DIAG_DONE
    ;;
esac
case $job in
STD-B)
    # Healthy FT cost on shipping code (2026-10-17 final scope): FT off = main's wheel on Open MPI's default UCX;
    # FT on = the stack's wheel (build-pr8) with the overlap port overlaid (overlays/stack-4c2929329c), the fence
    # all-to-all FT requires, and ULFM's transport. Identical config: configs/${BENCH_CONFIG:-dep32-e0-overlap.yaml}
    # (overlap scheduler, static EPLB 288). Same nodes, three rounds in alternating order, STD_LOADS per GPU with
    # STD_ITERATIONS waves each; ab_stats.py turns the cases into FT's cost with its 95% interval.
    export BENCH_CONFIG=${BENCH_CONFIG:-dep32-e0-overlap.yaml}
    main_dist=$C/build-pr0-fc52f0adee/dist
    for round in 1 2 3; do
        modes="noft ft"; [[ $round == 2 ]] && modes="ft noft"
        for mode in $modes; do
            if [[ $mode == noft ]]; then
                (dist=$main_dist; run_case noft-$round noft --mode sweep --loads ${STD_LOADS:-8,32,128,256} --iterations ${STD_ITERATIONS:-3})
            else
                (export MVP_OVERLAY=$C/overlays/stack-4c2929329c TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
                 run_case ft-$round ft --mode sweep --loads ${STD_LOADS:-8,32,128,256} --iterations ${STD_ITERATIONS:-3})
            fi
            case_index=$((case_index + 1))
        done
    done
    python3 $H/ab_stats.py "$out" > "$out/ab_stats.txt" 2>&1 && [[ $SLURM_NODEID == 0 ]] && cat "$out/ab_stats.txt"
    echo STD_DONE
    ;;
STD-PROFILE)
    # Attribution for STD-B: one nsys window of rank 1 per mode and load (PROFILE_LOADS), same wheels and config.
    export BENCH_CONFIG=${BENCH_CONFIG:-dep32-e0-overlap.yaml}
    main_dist=$C/build-pr0-fc52f0adee/dist
    for load in ${PROFILE_LOADS:-8 256}; do
        (dist=$main_dist; export TLLM_TEST_NSYS_RANKS=1
         run_case profile-noft-$load noft --mode sweep --loads $load --iterations 2 --profile-after-s 60)
        case_index=$((case_index + 1))
        (export MVP_OVERLAY=$C/overlays/stack-4c2929329c TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_TEST_NSYS_RANKS=1
         run_case profile-ft-$load ft --mode sweep --loads $load --iterations 2 --profile-after-s 60)
        case_index=$((case_index + 1))
    done
    echo STD_DONE
    ;;
esac
case $job in
SM-DIAG2)
    # Lever A, sm, second probe: the in-band failure detector (SM-DIAG detector, 8027361) declared a live rank dead
    # during the server's startup and aborted it, as Open MPI warns a slow observer can; this runs its detector on
    # a thread with a longer timeout (SM_DETECTOR_TIMEOUT_S, default 3 s). Control idle kill on tcp first.
    pip install py-spy > "$out/py-spy-install-$SLURM_NODEID.log" 2>&1 || echo "PY_SPY_INSTALL_FAILED $SLURM_NODEID"
    kill_case idle-tcp idle 8
    sm="--mca pml ob1 --mca btl self,sm,tcp --mca btl_tcp_if_include eth0 --mca coll ^hcoll,ucc"
    sm="$sm --mca mpi_ft_detector true --mca mpi_ft_detector_thread true"
    sm="$sm --mca mpi_ft_detector_timeout ${SM_DETECTOR_TIMEOUT_S:-3} --mca mpi_ft_detector_period 0.5 --mca mpi_ft_verbose 1"
    (
        run=$out/idle-sm-detector-thread
        until grep -qs "^RANK_EXIT 2 " "$run/timeline"; do sleep 2; done
        for at in 60 120; do
            sleep 60
            for pid in $(pgrep -f mgmn_worker_node); do
                timeout 60 py-spy dump --native --pid "$pid" > "$out/stacks-kill+$at-node$SLURM_NODEID-$pid.txt" 2>&1
            done
        done
    ) &
    dumper=$!
    (export WIDEEP_MPI_MCA="$sm"; kill_case idle-sm-detector-thread idle 8)
    kill $dumper 2>/dev/null
    echo SM_DIAG_DONE
    ;;
esac
case $job in
STD-PROFILE2)
    # Attribution for STD-B: one nsys window of ranks 0 and 5 per mode at each of PROFILE_LOADS (8, 32, 256 per
    # GPU), same wheels and config as STD-B (BENCH_CONFIG, default dep32-std-ship.yaml).
    export BENCH_CONFIG=${BENCH_CONFIG:-dep32-std-ship.yaml}
    main_dist=$C/build-pr0-fc52f0adee/dist
    for load in ${PROFILE_LOADS:-8 32 256}; do
        (dist=$main_dist; export TLLM_TEST_NSYS_RANKS=0+5
         run_case profile-noft-$load noft --mode sweep --loads $load --iterations 2 --profile-after-s 60)
        case_index=$((case_index + 1))
        (export MVP_OVERLAY=$C/overlays/stack-4c2929329c TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0 TLLM_TEST_NSYS_RANKS=0+5
         run_case profile-ft-$load ft --mode sweep --loads $load --iterations 2 --profile-after-s 60)
        case_index=$((case_index + 1))
    done
    echo STD_DONE
    ;;
esac
case $job in
EPLB-AB)
    # Steering step 2 (FT off, main's wheel, same nodes): the standard aggregated DEP32 recipe without EPLB (256
    # slots, configs/dep32-eplb0.yaml) vs online EPLB over 288 slots (configs/dep32-eplb288.yaml), on real-text
    # prompts (ShareGPT first turns cut to 1k tokens), three rounds in alternating order.
    dist=$C/build-pr0-fc52f0adee/dist
    text=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/datasets-rs/ShareGPT_V3_unfiltered_cleaned_split.json
    for round in 1 2 3; do
        variants="eplb0 eplb288"; [[ $round == 2 ]] && variants="eplb288 eplb0"
        for variant in $variants; do
            (export BENCH_CONFIG=dep32-$variant.yaml
             run_case $variant-$round noft --mode sweep --loads ${STD_LOADS:-8,32,128,256} --iterations ${STD_ITERATIONS:-3} --text-prompts $text)
            case_index=$((case_index + 1))
        done
    done
    python3 $H/ab_stats.py "$out" eplb0 eplb288 > "$out/ab_stats.txt" 2>&1 && [[ $SLURM_NODEID == 0 ]] && cat "$out/ab_stats.txt"
    echo STD_DONE
    ;;
esac
case $job in
GLM-SCOUT)
    # GLM scout (low priority): GLM-5.2-NVFP4 at DEP32 on the CuteDSL path (configs/glm52-dep32-ship.yaml). FT off on
    # main's wheel: does it serve with this harness? Then FT on (the stack + overlap port) with an idle kill of
    # rank 2. Blockers go to HANDOFF.md.
    export WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/GLM-5.2-NVFP4
    export BENCH_CONFIG=glm52-dep32-ship.yaml
    (dist=$C/build-pr0-fc52f0adee/dist; run_case noft noft --mode sweep --loads 8,32 --iterations 2)
    case_index=$((case_index + 1))
    [[ ${GLM_SCOUT_FT:-1} == 1 ]] && (export MVP_OVERLAY=$C/overlays/stack-4c2929329c TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
     kill_case idle-ft idle 8)
    echo STD_DONE
    ;;
esac
case $job in
STD-B2)
    # STD-B with a tighter protocol (STD-B-8028211: FT-off rounds differed by up to 3.7%): one autotuner cache for
    # the whole job, so every server start of either mode runs the same tactics for the ops both modes share; load
    # 8 measured after a first, discarded run at 8 (the first measurement after warmup ran ~2% slow); four
    # waves per load; three rounds in alternating order on the same nodes.
    export BENCH_CONFIG=${BENCH_CONFIG:-dep32-std-ship.yaml} TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    main_dist=$C/build-pr0-fc52f0adee/dist
    for round in 1 2 3; do
        modes="noft ft"; [[ $round == 2 ]] && modes="ft noft"
        for mode in $modes; do
            if [[ $mode == noft ]]; then
                (dist=$main_dist; run_case noft-$round noft --mode sweep --loads 8,8,32,128,256 --iterations 4)
            else
                (export MVP_OVERLAY=$C/overlays/stack-4c2929329c TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
                 run_case ft-$round ft --mode sweep --loads 8,8,32,128,256 --iterations 4)
            fi
            case_index=$((case_index + 1))
        done
    done
    python3 $H/ab_stats.py "$out" > "$out/ab_stats.txt" 2>&1 && [[ $SLURM_NODEID == 0 ]] && cat "$out/ab_stats.txt"
    echo STD_DONE
    ;;
esac
case $job in
NOISE)
    # Noise floor of STD-B2's protocol before its n=3 A/B: FT off (main's wheel) twice on the same nodes, one
    # autotuner cache for the job, load 8 measured after a discarded run, four waves per load. ab_stats compares
    # the two runs as "noft" vs "noft2" (a 0% difference expected; its spread is the floor).
    export BENCH_CONFIG=${BENCH_CONFIG:-dep32-std-ship.yaml} TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    dist=$C/build-pr0-fc52f0adee/dist
    for round in 1 2; do
        run_case noft-$round noft --mode sweep --loads 8,8,32,128,256 --iterations 4
        run_case noft2-$round noft --mode sweep --loads 8,8,32,128,256 --iterations 4
    done
    python3 $H/ab_stats.py "$out" noft noft2 > "$out/ab_stats.txt" 2>&1 && [[ $SLURM_NODEID == 0 ]] && cat "$out/ab_stats.txt"
    echo STD_DONE
    ;;
esac
case $job in
OVERLAP-ORACLE)
    # Plan item 4: overlap counts as supported after a decode-replay kill that lands in two uncommitted steps,
    # with exact tokens. One node, DeepSeek-V3-Lite EP4 (as P1-LITE); the stack's wheel with the overlap port.
    # Routing excludes the victim from startup (oracle), so the requests resubmitted after the kill must equal
    # the first serve token for token. The victim kills itself before a decode replay launched while its
    # previous step still runs (TLLM_TEST_KILL_WHEN_BUSY), so both steps are uncommitted; sync is the control.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export MVP_OVERLAY=$C/overlays/stack-4c2929329c TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    dist=$C/build-pr8-937403a6cc/dist
    for feature in sync overlap overlap overlap; do
        trigger=/tmp/wideep-kill-$SLURM_JOB_ID-$case_index
        busy=0; [[ $feature == overlap ]] && busy=1
        (export TOKENS_CONFIG=../configs/lite4-$feature.yaml TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2
         export TLLM_TEST_KILL_IN_DECODE=$trigger TLLM_TEST_KILL_WHEN_BUSY=$busy
         export TOKENS_ARGS="--inflight-after 0.5 --max-tokens 400 --no-probe --trigger $trigger"
         run_case $feature-replay-$case_index ft)
        case_index=$((case_index + 1))
    done
    [[ $SLURM_NODEID == 0 ]] && grep -H "discarding\|WIDEEP_SELF_KILL" "$out"/*/rank-*.log | sed 's/^.*runs\///' | cut -c1-240
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"' "$out"/*/result.json
    echo STD_DONE
    ;;
esac
case $job in
STD-B2-1K|STD-B2-8K)
    # The definitive healthy-cost A/B for one shape (mvp/BENCHMARK_STANDARD.md), three arms on the same nodes:
    #   eplb0   FT off, the best FT-off deployment (perf-sanity's DEP32 eplb0 recipe, main's wheel);
    #   noft288 FT off, the FT-capable deployment (the same recipe plus the static 288-slot EPLB placement);
    #   ft288   FT on, the same deployment (the stack's wheel with the overlap + balancing port overlaid).
    # (1) FT mechanism = ft288 vs noft288; (2) deployment = noft288 vs eplb0. Three rounds, the arm order rotating;
    # one autotuner cache for the job (pinned tactics); each load warmed by one unmeasured wave; B2_WAVES measured
    # waves per load (from the NOISE floor); steady state from rank 0's iteration log (steady_state.py). Then
    # the nsys attribution of (1): ranks 0 and 5 at 8, 64 and 256 per GPU, one case per FT mode.
    shape=${job#STD-B2-}; isl=1024; [[ $shape == 8K ]] && isl=8192
    suffix=""; [[ $shape == 8K ]] && suffix="-8k"
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    main_dist=$C/build-pr0-fc52f0adee/dist
    loads=${B2_LOADS:-8,16,32,64,128,256}
    sweep=(--mode sweep --loads $loads --iterations ${B2_WAVES:-3} --isl $isl --osl 1024 --warm-each-load)
    arm() {  # ARM CASE_NAME [extra bench args]
        local arm=$1 name=$2; shift 2
        case $arm in
        eplb0) (dist=$main_dist; export BENCH_CONFIG=dep32-b2-eplb0$suffix.yaml
                [[ -z $suffix ]] && BENCH_CONFIG=dep32-eplb0.yaml; run_case $name noft "$@") ;;
        noft288) (dist=$main_dist; export BENCH_CONFIG=dep32-b2-288$suffix.yaml; run_case $name noft "$@") ;;
        ft288) (export BENCH_CONFIG=dep32-b2-288$suffix.yaml MVP_OVERLAY=$C/overlays/stack-3e9027f4e4
                export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0; run_case $name ft "$@") ;;
        esac
        case_index=$((case_index + 1))
    }
    for round in 1 2 3; do
        case $round in 1) arms="eplb0 noft288 ft288" ;; 2) arms="ft288 eplb0 noft288" ;; 3) arms="noft288 ft288 eplb0" ;; esac
        for a in $arms; do arm $a $a-$round "${sweep[@]}"; done
    done
    if [[ $SLURM_NODEID == 0 ]]; then
        for pair in "noft288 ft288" "eplb0 noft288"; do python3 $H/ab_stats.py "$out" $pair; done > "$out/ab_stats.txt" 2>&1
        cat "$out/ab_stats.txt"
    fi
    export TLLM_TEST_NSYS_RANKS=0+5
    for a in noft288 ft288; do
        arm $a profile-$a --mode sweep --loads 8,64,256 --iterations 3 --isl $isl --osl 1024 --warm-each-load \
            --profile-after-s 25
    done
    unset TLLM_TEST_NSYS_RANKS
    echo STD_DONE
    ;;
esac
case $job in
PREFLIGHT-B2)
    # Before STD-B2: each arm's server comes up and serves the standard workload once (1k/1k at 8 and 256 per GPU,
    # one wave, warmed), the 8k/1k FT-capable config comes up, and FT still recovers in the new deployment
    # (finalize fusion and balancing on): an idle kill of rank 2. Then, in the same allocation, the low-priority
    # GLM scout (FT off; HANDOFF.md lists its blockers).
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    main_dist=$C/build-pr0-fc52f0adee/dist
    quick=(--mode sweep --loads 8,256 --iterations 1 --warm-each-load)
    (dist=$main_dist; export BENCH_CONFIG=dep32-eplb0.yaml; run_case eplb0 noft "${quick[@]}")
    case_index=$((case_index + 1))
    (dist=$main_dist; export BENCH_CONFIG=dep32-b2-288.yaml; run_case noft288 noft "${quick[@]}")
    case_index=$((case_index + 1))
    (export BENCH_CONFIG=dep32-b2-288.yaml MVP_OVERLAY=$C/overlays/stack-3e9027f4e4 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
     run_case ft288 ft "${quick[@]}")
    case_index=$((case_index + 1))
    (export BENCH_CONFIG=dep32-b2-288.yaml MVP_OVERLAY=$C/overlays/stack-3e9027f4e4 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
     kill_case ft288-idle idle 8)
    (export BENCH_CONFIG=dep32-b2-288-8k.yaml MVP_OVERLAY=$C/overlays/stack-3e9027f4e4 TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
     run_case ft288-8k ft --mode sweep --loads 8,64 --iterations 1 --isl 8192 --warm-each-load)
    case_index=$((case_index + 1))
    (export WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/GLM-5.2-NVFP4
     export BENCH_CONFIG=glm52-dep32-ship.yaml WIDEEP_TOKENIZER=$C/cache/glm52-tokenizer
     dist=$main_dist; run_case glm-noft noft --mode sweep --loads 8,32 --iterations 2)
    echo STD_DONE
    ;;
esac
case $job in
EPLB-AB2)
    # The EPLB decision (BENCHMARK_STANDARD.md "EPLB/slots"), FT off, main's wheel, same nodes: perf-sanity's DEP32
    # eplb0 (256 slots) vs online EPLB over 288 slots (layer_updates_per_iter 1), real-text prompts (ShareGPT first
    # turns cut to 1k), emphasis on 64-256 per GPU, each load warmed and run long enough for online EPLB to settle
    # (EPLB_WAVES waves); steady state from the iteration log. Three rounds, alternating order.
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    dist=$C/build-pr0-fc52f0adee/dist
    text=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/datasets-rs/ShareGPT_V3_unfiltered_cleaned_split.json
    for round in 1 2 3; do
        variants="eplb0 eplb288"; [[ $round == 2 ]] && variants="eplb288 eplb0"
        for variant in $variants; do
            (export BENCH_CONFIG=dep32-$variant.yaml
             run_case $variant-$round noft --mode sweep --loads ${EPLB_LOADS:-64,128,256} --iterations ${EPLB_WAVES:-6} \
                 --warm-each-load --text-prompts $text)
            case_index=$((case_index + 1))
        done
    done
    python3 $H/ab_stats.py "$out" eplb0 eplb288 > "$out/ab_stats.txt" 2>&1 && [[ $SLURM_NODEID == 0 ]] && cat "$out/ab_stats.txt"
    echo STD_DONE
    ;;
esac
case $job in
RESTORE-E2E)
    # Item 2: restore end to end on static 288 (dep32-b2-288.yaml: the standard deployment), FT on, the restore
    # wheel (wideep-ft-restore2: stack + overlap + balancing + restore; MVP_BUILD) with RESTORE_OVERLAY. Rank 3
    # holds no static copies, so losing it needs a restore (its 8 experts per layer loaded from host copies into
    # replica slots); rank 2 (copies on rank 24) is the mask-only control. Per kill: survivors resume, the
    # "Restored N expert slots ... ms" line, then serving. Correctness: GSM8K after restoring rank 3 vs FT off.
    export BENCH_CONFIG=dep32-b2-288.yaml MVP_OVERLAY=${RESTORE_OVERLAY:-} TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    [[ $SLURM_NODEID == 0 ]] && pip install "lm_eval[api]==0.4.10" > "$out/lm_eval-install-0.log" 2>&1
    (export WIDEEP_VICTIM=2; run_case copies-idle-r2 ft --mode sweep --loads 8 --iterations 1 --warm-each-load --after-loss)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=3; run_case restore-idle-r3 ft --mode sweep --loads 8,256 --iterations 2 --warm-each-load --after-loss)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=3 TLLM_TEST_KILL_TRIGGER=/tmp/wideep-kill-$SLURM_JOB_ID-decode
     export TLLM_TEST_KILL_RANK=3 TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case restore-decode-r3 ft --mode failover --kill decode --load 256 --iterations 2 --kill-window-s 30,60)
    case_index=$((case_index + 1))
    (dist=$C/build-pr0-fc52f0adee/dist; export MVP_OVERLAY=; run_case acc-noft noft --mode accuracy)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=3; run_case acc-restore-r3 ft --mode accuracy --after-loss)
    [[ $SLURM_NODEID == 0 ]] && grep -h "Restored .* expert slots\|resumed serving without" "$out"/*/rank-0.log | cut -c1-260
    echo STD_DONE
    ;;
esac
case $job in
B2-MECH-1K|B2-MECH-8K|B2-DEPL-1K|B2-DEPL-8K)
    # STD-B2 (mvp/BENCHMARK_STANDARD.md) split into two < 2 h jobs per shape, each its own same-node comparison:
    #   B2-MECH: (1) FT mechanism = ft288 vs noft288 (identical FT-capable deployment), then the nsys attribution
    #            (ranks 0 and 5 at 8, 64 and 256 per GPU, one case per mode);
    #   B2-DEPL: (2) deployment = noft288 vs eplb0 (perf-sanity's DEP32 eplb0, the best FT-off deployment).
    # Arms: eplb0 / noft288 = main's wheel; ft288 = MVP_BUILD (the stack) with B2_OVERLAY if set. Three rounds,
    # alternating order; pinned tactics; each load warmed; B2_WAVES measured waves (NOISE: 3); steady state from
    # rank 0's iteration log.
    shape=${job##*-}; isl=1024; suffix=""
    [[ $shape == 8K ]] && isl=8192 suffix="-8k"
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    main_dist=$C/build-pr0-fc52f0adee/dist
    sweep=(--mode sweep --loads ${B2_LOADS:-8,16,32,64,128,256} --iterations ${B2_WAVES:-3} --isl $isl --osl 1024
           --warm-each-load)
    arm() {  # ARM CASE_NAME [bench args]
        local arm=$1 name=$2; shift 2
        case $arm in
        eplb0) (dist=$main_dist; export BENCH_CONFIG=dep32-b2-eplb0$suffix.yaml
                [[ -z $suffix ]] && BENCH_CONFIG=dep32-eplb0.yaml; run_case $name noft "$@") ;;
        noft288) (dist=$main_dist; export BENCH_CONFIG=dep32-b2-288$suffix.yaml; run_case $name noft "$@") ;;
        ft288) (export BENCH_CONFIG=dep32-b2-288$suffix.yaml MVP_OVERLAY=${B2_OVERLAY:-}
                export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0; run_case $name ft "$@") ;;
        esac
        case_index=$((case_index + 1))
    }
    base=noft288 test=ft288; [[ $job == B2-DEPL-* ]] && base=eplb0 test=noft288
    for round in 1 2 3; do
        arms="$base $test"; [[ $round == 2 ]] && arms="$test $base"
        for a in $arms; do arm $a $a-$round "${sweep[@]}"; done
    done
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" $base $test > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    if [[ $job == B2-MECH-* ]]; then
        export TLLM_TEST_NSYS_RANKS=0+5
        for a in noft288 ft288; do
            arm $a profile-$a --mode sweep --loads 8,64,256 --iterations 3 --isl $isl --osl 1024 --warm-each-load \
                --profile-after-s 25
        done
        unset TLLM_TEST_NSYS_RANKS
    fi
    echo STD_DONE
    ;;
esac
case $job in
HANG-STACK)
    # Item 3: hang detection with the workers' fencing on the stack (MVP_BUILD = the stack's wheel, MVP_OVERLAY =
    # the hang branch), one node, DeepSeek-V3-Lite EP4. No --fence-command: the hung rank's own evidence thread
    # (stuck serving loop, stuck GPU) or a node-mate (SIGSTOP) must fence it. A healthy control fences nothing;
    # then rank 2 SIGSTOPped in flight, its serving loop stuck (main thread asleep), its GPU stalled in a decode
    # step: each confirmed, fenced and recovered with exact tokens (oracle routing excludes rank 2).
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TOKENS_CONFIG=../configs/lite4-sync.yaml TLLM_FAULT_TOLERANCE_HANG_DETECTION=1
    export TLLM_FAULT_TOLERANCE_HANG_CONFIRM_S=10 WIDEEP_FENCE_COMMAND=
    inflight="--inflight-after 0.5 --max-tokens 400 --no-probe"
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="--no-kill"; run_case hang-control ft)
    case_index=$((case_index + 1))
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TOKENS_ARGS="$inflight --signal STOP"; run_case stop-inflight ft)
    case_index=$((case_index + 1))
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2 TLLM_TEST_STALL_S=60
     export TLLM_TEST_HOST_STALL_IN_DECODE=/tmp/wideep-hoststall-$SLURM_JOB_ID
     export TOKENS_ARGS="$inflight --trigger $TLLM_TEST_HOST_STALL_IN_DECODE"; run_case hoststall-inflight ft)
    case_index=$((case_index + 1))
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2 TLLM_TEST_STALL_S=60
     export TLLM_TEST_STALL_IN_DECODE=/tmp/wideep-stall-$SLURM_JOB_ID
     export TOKENS_ARGS="$inflight --trigger $TLLM_TEST_STALL_IN_DECODE"; run_case gpustall-inflight ft)
    [[ $SLURM_NODEID == 0 ]] && grep -h "fenced\|fencing\|is hung\|resumed serving" "$out"/*/rank-*.log "$out"/*/authority*.log 2>/dev/null | cut -c1-220
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"' "$out"/*/result.json
    echo STD_DONE
    ;;
esac
case $job in
B2X-*)
    # STD-B2 (mvp/BENCHMARK_STANDARD.md), one same-node comparison per < 2 h job, all parameters from the
    # environment: B2_SHAPE (1K | 8K), B2_PAIR (mech: ft288 vs noft288 | depl: noft288 vs eplb0), B2_LOADS,
    # B2_WAVES, B2_PROFILE_LOADS (nsys ranks 0 and 5 per FT mode after the rounds; empty = none). Arms: eplb0 and
    # noft288 on main's wheel; ft288 on MVP_BUILD with B2_OVERLAY. Three rounds, alternating order; pinned
    # tactics; each load warmed; steady state from rank 0's iteration log.
    isl=1024; suffix=""
    [[ ${B2_SHAPE:-1K} == 8K ]] && isl=8192 suffix="-8k"
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    main_dist=$C/build-pr0-fc52f0adee/dist
    b2_arm() {  # ARM CASE_NAME [bench args]
        local arm=$1 name=$2; shift 2
        case $arm in
        eplb0) (dist=$main_dist; export BENCH_CONFIG=dep32-b2-eplb0$suffix.yaml
                [[ -z $suffix ]] && BENCH_CONFIG=dep32-eplb0.yaml; run_case $name noft "$@") ;;
        noft288) (dist=$main_dist; export BENCH_CONFIG=dep32-b2-288$suffix.yaml; run_case $name noft "$@") ;;
        ft288) (export BENCH_CONFIG=dep32-b2-288$suffix.yaml MVP_OVERLAY=${B2_OVERLAY:-}
                export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0; run_case $name ft "$@") ;;
        esac
        case_index=$((case_index + 1))
    }
    base=noft288 test=ft288; [[ ${B2_PAIR:-mech} == depl ]] && base=eplb0 test=noft288
    for round in 1 2 3; do
        arms="$base $test"; [[ $round == 2 ]] && arms="$test $base"
        for a in $arms; do
            b2_arm $a $a-$round --mode sweep --loads ${B2_LOADS:-8,16,32,64,128,256} --iterations ${B2_WAVES:-2} \
                --isl $isl --osl 1024 --warm-each-load
        done
    done
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" $base $test > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    if [[ -n "${B2_PROFILE_LOADS:-}" ]]; then
        export TLLM_TEST_NSYS_RANKS=0+5
        for a in $base $test; do
            b2_arm $a profile-$a --mode sweep --loads $B2_PROFILE_LOADS --iterations 2 --isl $isl --osl 1024 \
                --warm-each-load --profile-after-s 20
        done
        unset TLLM_TEST_NSYS_RANKS
    fi
    echo STD_DONE
    ;;
esac
case $job in
RESTORE-E2E2)
    # Item 2 on the restore wheel (MVP_BUILD = build-restore2-*: stack + restore + empty extra slots), standard
    # deployment dep32-b2-288.yaml, FT on. (a) replica mode (default): rank 2 (copies on rank 24) is the
    # mask-only control; rank 3 (no copies) needs a restore: idle kill + after-loss sweep, decode kill under load.
    # (b) empty mode (TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty: 288 buffers, 256 routed while healthy): healthy
    # sweep, then an idle kill of rank 3 restored into the empty slots and an after-loss sweep. (c) GSM8K after
    # restoring rank 3 vs FT off. Restore time: "Restored N expert slots ... in X ms" (rank 0 log).
    export BENCH_CONFIG=dep32-b2-288.yaml TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    [[ $SLURM_NODEID == 0 ]] && pip install "lm_eval[api]==0.4.10" > "$out/lm_eval-install-0.log" 2>&1
    after=(--mode sweep --loads 8,256 --iterations 2 --warm-each-load --after-loss)
    (export WIDEEP_VICTIM=2; run_case copies-idle-r2 ft "${after[@]}")
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=3; run_case restore-idle-r3 ft "${after[@]}")
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=3 TLLM_TEST_KILL_TRIGGER=/tmp/wideep-kill-$SLURM_JOB_ID-decode
     export TLLM_TEST_KILL_RANK=3 TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case restore-decode-r3 ft --mode failover --kill decode --load 256 --iterations 2 --kill-window-s 30,60)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=3 TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty; run_case empty-idle-r3 ft "${after[@]}")
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=3; run_case acc-restore-r3 ft --mode accuracy --after-loss)
    case_index=$((case_index + 1))
    (dist=$C/build-pr0-fc52f0adee/dist; run_case acc-noft noft --mode accuracy)
    [[ $SLURM_NODEID == 0 ]] && grep -h "Restored .* expert slots\|keeps .* EPLB slots empty\|resumed serving without" \
        "$out"/*/rank-0.log | cut -c1-260
    echo STD_DONE
    ;;
esac
case $job in
NODE-LOSS)
    # Item 3b: a whole non-0 node's ranks (4-7) die at once, in a decode step under load (each kills itself at
    # its next decode replay once a shared trigger file exists), on the restore wheel (MVP_BUILD) with the node
    # branch overlaid (MVP_OVERLAY), dep32-b2-320.yaml in empty-extra-slot mode (10 slot buffers per GPU, 8
    # routed). Control first: one rank (5, no copies) the same way. Each: survivors resume (28 / 31), restore
    # line, the load finishes on the survivors.
    export BENCH_CONFIG=dep32-b2-320.yaml TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    (export WIDEEP_VICTIM=5 TLLM_TEST_KILL_RANK=5 TLLM_TEST_KILL_TRIGGER=$out/trigger-rank5
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case rank5-decode ft --mode failover --kill decode --load 8 --iterations 3 --kill-window-s 20,30)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7 TLLM_TEST_KILL_TRIGGER=$out/trigger-node1
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case node1-decode ft --mode failover --kill decode --load 8 --iterations 3 --kill-window-s 20,30)
    case_index=$((case_index + 1))
    (export WIDEEP_VICTIM=4 WIDEEP_LOST=4 TLLM_TEST_KILL_RANK=4,5,6,7 TLLM_TEST_KILL_TRIGGER=$out/trigger-node1b
     export TLLM_TEST_KILL_IN_DECODE=$TLLM_TEST_KILL_TRIGGER
     run_case node1-decode-256 ft --mode failover --kill decode --load 256 --iterations 2 --kill-window-s 40,60)
    [[ $SLURM_NODEID == 0 ]] && grep -h "Restored .* expert slots\|keeps .* EPLB slots empty\|resumed serving without\|not recoverable" \
        "$out"/*/rank-0.log | cut -c1-260
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"' "$out"/*/result.json
    echo STD_DONE
    ;;
esac
case $job in
B2Y-*)
    # As B2X, with the two arms named by B2_BASE and B2_TEST (eplb0 | noft288 | ft288). With MVP_BUILD = the
    # restore wheel and TLLM_FAULT_TOLERANCE_EXTRA_SLOTS=empty exported, ft288 is the shippable default (288 slot
    # buffers, 256 routed while healthy): B2_BASE=eplb0 B2_TEST=ft288 measures what a user loses, (1) + (2).
    isl=1024; suffix=""
    [[ ${B2_SHAPE:-1K} == 8K ]] && isl=8192 suffix="-8k"
    export TLLM_AUTOTUNER_CACHE_PATH=$out/autotuner/cache.json
    mkdir -p "$out/autotuner"
    main_dist=$C/build-pr0-fc52f0adee/dist
    b2y_arm() {  # ARM CASE_NAME [bench args]
        local arm=$1 name=$2; shift 2
        case $arm in
        eplb0) (dist=$main_dist; export BENCH_CONFIG=dep32-b2-eplb0$suffix.yaml
                [[ -z $suffix ]] && BENCH_CONFIG=dep32-eplb0.yaml; run_case $name noft "$@") ;;
        noft288) (dist=$main_dist; export BENCH_CONFIG=dep32-b2-288$suffix.yaml; run_case $name noft "$@") ;;
        ft288) (export BENCH_CONFIG=dep32-b2-288$suffix.yaml MVP_OVERLAY=${B2_OVERLAY:-}
                export TRTLLM_NVLINK_ONE_SIDED_A2A_FORCE_CFT=0; run_case $name ft "$@") ;;
        esac
        case_index=$((case_index + 1))
    }
    base=${B2_BASE:-eplb0} test=${B2_TEST:-ft288}
    for round in 1 2 3; do
        arms="$base $test"; [[ $round == 2 ]] && arms="$test $base"
        for a in $arms; do
            b2y_arm $a $a-$round --mode sweep --loads ${B2_LOADS:-8,16,32,64,128,256} --iterations ${B2_WAVES:-2} \
                --isl $isl --osl 1024 --warm-each-load
        done
    done
    [[ $SLURM_NODEID == 0 ]] && { python3 $H/ab_stats.py "$out" $base $test > "$out/ab_stats.txt" 2>&1; cat "$out/ab_stats.txt"; }
    echo STD_DONE
    ;;
esac
case $job in
STICKY-LITE)
    # Item 5 (device failures we can inject): rank 2's CUDA context gets a sticky error (device-side assert) in
    # a decode step under in-flight requests; expected: the serving loop classifies it fatal, the rank ends
    # itself (exits_alone), and the survivors recover with exact tokens (oracle routing excludes rank 2). One
    # node, DeepSeek-V3-Lite EP4, the stack (MVP_BUILD + MVP_OVERLAY). Control: SIGKILL in a decode step.
    export WIDEEP_WORLD=4 WIDEEP_MODEL=/lustre/fs1/portfolios/coreai/projects/coreai_comparch_trtllm/common/DeepSeek-V3-Lite/nvfp4_moe_only
    export TOKENS_CONFIG=../configs/lite4-sync.yaml
    inflight="--inflight-after 0.5 --max-tokens 400 --no-probe"
    (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2 TLLM_TEST_KILL_IN_DECODE=/tmp/wideep-kill-$SLURM_JOB_ID
     export TOKENS_ARGS="$inflight --trigger $TLLM_TEST_KILL_IN_DECODE"; run_case kill-control ft)
    case_index=$((case_index + 1))
    for i in 1 2; do
        (export TLLM_TEST_ORACLE_EXCLUDE_RANK=2 TLLM_TEST_KILL_RANK=2
         export TLLM_TEST_STICKY_IN_DECODE=/tmp/wideep-sticky-$SLURM_JOB_ID-$i
         export TOKENS_ARGS="$inflight --trigger $TLLM_TEST_STICKY_IN_DECODE"; run_case sticky-$i ft)
        case_index=$((case_index + 1))
    done
    [[ $SLURM_NODEID == 0 ]] && grep -h "immediate_fatal\|exits alone\|ending the process\|resumed serving" "$out"/*/rank-*.log | cut -c1-220
    [[ $SLURM_NODEID == 0 ]] && grep -H '"state"' "$out"/*/result.json
