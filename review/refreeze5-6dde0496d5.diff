commit 6dde0496d5535e6dd68849983af50eafbdf220af
Author: Andrew Rusli <arusli@nvidia.com>
Date:   Fri Oct 23 14:23:06 2026 -0700

    [None][fix] Refuse peer-loss recovery while Open MPI's hcoll collectives are on
    
    trtllm-llmapi-launch excludes hcoll and ucc by default under recovery; enable_peer_loss_recovery refuses unless hcoll is disabled, excluded or not selected.
    
    FT-off guards:
    FT-on only (the launcher's recovery branch and enable_peer_loss_recovery).
    
    Signed-off-by: Andrew Rusli <arusli@nvidia.com>

diff --git a/tensorrt_llm/_torch/distributed/communicator.py b/tensorrt_llm/_torch/distributed/communicator.py
index f52e6bd438..44bee57baa 100644
--- a/tensorrt_llm/_torch/distributed/communicator.py
+++ b/tensorrt_llm/_torch/distributed/communicator.py
@@ -902,6 +902,17 @@ class PeerFailureWatch:
             self._comm.Free()
 
 
+def _coll_component_excluded(name: str) -> bool:
+    """Whether Open MPI's environment keeps collective component ``name`` out: disabled, excluded, or not listed."""
+    if os.environ.get(f"OMPI_MCA_coll_{name}_enable") in ("0", "false"):
+        return True
+    selection = os.environ.get("OMPI_MCA_coll", "")
+    components = {c.strip() for c in selection.lstrip("^").split(",")}
+    if selection.startswith("^"):
+        return name in components
+    return bool(selection) and name not in components
+
+
 class MPIDist(Distributed):
     tp_comm: MPI.Comm
 
@@ -961,6 +972,10 @@ class MPIDist(Distributed):
             raise RuntimeError(
                 "Peer-loss recovery requires Open MPI's ob1 messaging layer; "
                 "launch through trtllm-llmapi-launch or with `--mca pml ob1`")
+        if not _coll_component_excluded("hcoll"):
+            raise RuntimeError(
+                "Peer-loss recovery requires Open MPI's hcoll collectives off; "
+                "launch through trtllm-llmapi-launch or with `--mca coll ^hcoll,ucc`")
         try:
             mpi_failed_ranks(mpi_comm())
             mpi_comm().Is_revoked()
